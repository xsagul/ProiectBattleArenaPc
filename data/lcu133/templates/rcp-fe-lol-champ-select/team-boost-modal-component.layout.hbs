<div class="team-boost-notification">
  <lol-uikit-content-block padding="large" class="boost-description">
    <h3>
      {{tra.boost_modal_title}}
    </>
    <p>
      {{boostModalMessage}}
    </>
    <p>
      -
      {{numSkinsMessage}}
    </>
    <p>
      -
      {{tra.boost_modal_list_item_2}}
    </>
  </>
  <hr>
  </>
  <lol-uikit-content-block padding="large" class="boost-details">
    <table cellspacing="0">
      <tr>
        <td class="label">
          {{tra.current_rp}}
        </>
        <td class="value">
          {{currentRpMessage}}
        </>
      </>
      <tr>
        <td class="label">
          {{tra.cost}}
        </>
        <td class="value">
          {{costRpMessage}}
        </>
      </>
      <tr class="total">
        <td class="label">
          {{tra.balance}}
        </>
        <td class="value">
          {{balanceRpMessage}}
        </>
      </>
    </>
  </>
</>
