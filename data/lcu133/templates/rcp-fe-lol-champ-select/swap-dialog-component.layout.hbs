<div class="swap-dialog animated {{unless showAcceptSwapButton "not-received"}} {{swapStateClass}} {{if isDisplayed "active"}}">
  <lol-uikit-flyout-frame orientation="right" show={{isDisplayed}} animated={{isAnimated}}>
    <div class="swap-wrapper">
      <div class="swap-container">
        <div class="swap-content-container">
          <div class="swap-message">
            {{swapMessageString}}
          </>
          <div class="button-group">
            {{#if showAcceptSwapButton}}
              <lol-uikit-flat-button class="action-button" onclick={{action this "acceptSwap" swap.id}}>
                <div class="action-button-inner-container">
                  <div class="action-icon">
                  </>
                  <div class="action-text">
                    {{tra.pregame_swap_accept}}
                  </>
                </>
              </>
              <lol-uikit-flat-button class="action-button" onclick={{action this "closeSwap" swap.id swap.state}}>
                <div class="action-button-inner-container">
                  <div class="decline-icon">
                  </>
                  <div class="action-text">
                    {{tra.pregame_swap_decline}}
                  </>
                </>
              </>
            {{/if}}
            {{#if showCancelSwapButton}}
              <lol-uikit-flat-button class="action-button" onclick={{action this "closeSwap" swap.id swap.state}}>
                <div class="action-button-inner-container">
                  <div class="decline-icon">
                  </>
                  <div class="action-text">
                    {{tra.pregame_swap_cancel}}
                  </>
                </>
              </>
            {{/if}}
          </>
        </>
      </>
      {{#if isSwapInProgress}}
        <div class="swap-timer-wrapper">
          <div class="swap-timer">
          </>
        </>
      {{/if}}
    </>
  </>
</>
