{{#if doesSkinHaveChromas}}
  <div class="chroma-information" style="background-image: url('{{currentMapChromaPath}}')">
    <div class="chroma-information-image" style="background-image: url('{{displayedSkin.chromaPreviewPath}}')">
    </>
    <div class="child-skin-name">
      {{displayedSkin.name}}
      <div class="child-skin-disabled-notification">
        {{if displayedSkin.disabled tra.skin_unselectable_because_disabled}}
      </>
    </>
  </>
  <lol-uikit-scrollable class="chroma-selection" overflow-masks="enabled">
    {{skin-button skin=baseSkin selectedSkinId=selectedSkinId onClick=(action this "setSkin") onEnter=(action this "showPreview") onLeave=(action this "closePreview") setSkin="setSkin" showPreview="showPreview" closePreview="closePreview" jmxSettings=jmxSettings timeRemaining=timeRemaining inFinalizationPhase=inFinalizationPhase}}
    {{#each sortedChromas as |chroma|}}
      {{skin-button skin=chroma selectedSkinId=selectedSkinId baseSkin=skin onClick=(action this "setSkin") onEnter=(action this "showPreview") onLeave=(action this "closePreview") setSkin="setSkin" showPreview="showPreview" closePreview="closePreview" jmxSettings=jmxSettings timeRemaining=timeRemaining inFinalizationPhase=inFinalizationPhase}}
    {{/each}}
  </>
{{/if}}
{{#if doesSkinHaveForms}}
  {{#each sortedChromas as |chroma|}}
    <div class="chroma-list-item id-{{chroma.id}} {{unless chroma.unlocked "locked"}}" onmouseup={{action this "setSkin" chroma}}>
      <div class="chroma-list-item-highlight-container">
        <div class="chroma-list-item-highlight">
        </>
      </>
      <div class="chroma-list-item-content">
        <div class="chroma-list-item-name">
          {{chroma.shortName}}
        </>
        <div class="chroma-list-item-status-icon">
        </>
      </>
    </>
  {{/each}}
{{/if}}
