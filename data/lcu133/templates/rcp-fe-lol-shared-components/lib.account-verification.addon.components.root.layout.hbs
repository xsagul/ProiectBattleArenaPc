<div class="account-verification-container">
  {{#if isPasswordEntryScreen}}
    {{account-verification-password-entry isPasswordValid=isPasswordValid changeScreen=(action this "changeScreen") unexpectedError=(action this "unexpectedError"}}
  {{else}}
    {{#if isPhoneEntryScreen}}
      {{account-verification-phone-entry isPasswordEntryActive=isPasswordEntryActive phoneNumber=phoneNumber formattedPhoneNumber=formattedPhoneNumber selectedCountry=selectedCountry selectedCountryIndex=selectedCountryIndex countryDropdownOptions=countryDropdownOptions smsTokenExpireDurationInSec=smsTokenExpireDurationInSec tokenRequestInProgressTimeLeftInSec=tokenRequestInProgressTimeLeftInSec isTokenRequestNotInProgress=isTokenRequestNotInProgress isPhoneNumberValid=isPhoneNumberValid isPhoneNumberValidLive=isPhoneNumberValidLive isPhoneNumberNotRegistered=isPhoneNumberNotRegistered postPhoneNumberRequest=(action this "postPhoneNumberRequest") changeScreen=(action this "changeScreen"}}
    {{else}}
      {{#if isTencentPhoneDisplay}}
        {{account-verification-tencent-phone-display phoneNumber=phoneNumber smsTokenExpireDurationInSec=smsTokenExpireDurationInSec tokenRequestInProgressTimeLeftInSec=tokenRequestInProgressTimeLeftInSec isTokenRequestNotInProgress=isTokenRequestNotInProgress isPhoneNumberValid=isPhoneNumberValid isPhoneNumberNotRegistered=isPhoneNumberNotRegistered postPhoneNumberRequest=(action this "postPhoneNumberRequest") restrictField=(action this "restrictField") changeScreen=(action this "changeScreen"}}
      {{else}}
        {{#if isTokenEntryScreen}}
          {{account-verification-token-entry isPasswordEntryActive=isPasswordEntryActive initScreen=initScreen phoneNumber=phoneNumber formattedPhoneNumber=formattedPhoneNumber selectedCountry=selectedCountry geoInfo=geoInfo smsTokenExpireDurationInSec=smsTokenExpireDurationInSec isTokenValid=isTokenValid isTokenNotExpired=isTokenNotExpired restrictField=(action this "restrictField") postPhoneNumberRequest=(action this "postPhoneNumberRequest") confirmRemovalRequest=(action this "confirmRemovalRequest") confirmKrVerifyRequest=(action this "confirmKrVerifyRequest") changeScreen=(action this "changeScreen") unexpectedError=(action this "unexpectedError"}}
        {{else}}
          {{#if isPhoneRemoveScreen}}
            {{account-verification-phone-remove phoneNumber=phoneNumber formattedPhoneNumber=formattedPhoneNumber selectedCountry=selectedCountry geoInfo=geoInfo smsTokenExpireDurationInSec=smsTokenExpireDurationInSec tokenRequestInProgressTimeLeftInSec=tokenRequestInProgressTimeLeftInSec isTokenRequestNotInProgress=isTokenRequestNotInProgress confirmRemovalRequest=(action this "confirmRemovalRequest") changeScreen=(action this "changeScreen") unexpectedError=(action this "unexpectedError"}}
          {{else}}
            {{#if isLoadingScreen}}
              {{account-verification-loading changeScreen=(action this "changeScreen"}}
            {{else}}
              {{#if isSuccessScreen}}
                {{account-verification-success changeScreen=(action this "changeScreen"}}
              {{else}}
                {{#if isUnexpectedErrorScreen}}
                  {{account-verification-unexpected-error changeScreen=(action this "changeScreen"}}
                {{else}}
                  {{#if isKrPhoneDisplay}}
                    {{account-verification-kr-phone-display smsTokenExpireDurationInSec=smsTokenExpireDurationInSec tokenRequestInProgressTimeLeftInSec=tokenRequestInProgressTimeLeftInSec isTokenRequestNotInProgress=isTokenRequestNotInProgress isKrPhoneRegistered=isKrPhoneRegistered isKrSsnRegistered=isKrSsnRegistered confirmKrVerifyRequest=(action this "confirmKrVerifyRequest") changeScreen=(action this "changeScreen") unexpectedError=(action this "unexpectedError"}}
                  {{/if}}
                {{/if}}
              {{/if}}
            {{/if}}
          {{/if}}
        {{/if}}
      {{/if}}
    {{/if}}
  {{/if}}
</>
