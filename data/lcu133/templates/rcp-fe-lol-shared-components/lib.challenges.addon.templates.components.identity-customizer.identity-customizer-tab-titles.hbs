<div class="challenges-identity-customizer-subheader">
  <lol-uikit-flat-input>
    {{input type="search" maxlength="50" class="search-filter-input" value=searchFilter placeholder=tra.challenges_search_placeholder}}
  </>
  <div class="filter-container">
    <lol-uikit-flat-checkbox class="ownership-filter">
      {{input slot="input" type="checkbox" name="isUnowned" checked=isUnownedShown}}
      <label slot="label" class="collection-checkbox-label" for="isUnowned">
        {{tra.challenges_identity_customizer_show_unowned}}
      </>
    </>
    <lol-uikit-framed-dropdown class="challenges-identity-sort-dropdown">
      {{#each sortOptions as |sortOption|}}
        <lol-uikit-dropdown-option slot="lol-uikit-dropdown-option" selected={{sortOption.isSelected}} onclick={{action this "setSortOption" sortOption.value}}>
          {{sortOption.name}}
        </>
      {{/each}}
    </>
  </>
</>
<div class="challenges-identity-customizer-grid">
  <lol-uikit-scrollable overflow-masks="enabled">
    {{#ember-collection class="identity-customizer-grid-scrollable" items=filteredTitles cell-layout=(mixed-grid-layout itemSizes) as |entry index|}}
      {{#if entry.isHeader}}
        <div class="challenge-title-group-container">
          <div class="challenge-title-group-name">
            {{entry.name}}
          </>
        </>
      {{else}}
        <div class="challenge-identity-customizer-title-container" id="title-id-{{entry.itemId}}">
          {{identity-customizer-title title=entry selectedTitle=selectedTitle lastVisitTime=lastVisitTime onClick=(action this "selectTitle"}}
        </>
      {{/if}}
    {{/ember-collection}}
  </>
</>
