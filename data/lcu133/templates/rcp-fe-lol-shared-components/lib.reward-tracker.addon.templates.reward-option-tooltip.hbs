<div class="reward-option-tooltip-availability-detail">
  {{#if isSelected}}
    <img src="/fe/lol-static-assets/images/check_mask.png" class="reward-option-tooltip-availability-detail-icon">
    </>
    <div class="reward-option-tooltip-availability-detail-text">
      {{selectedDetailText}}
    </>
  {{else}}
    {{#if isUnselected}}
      <div class="reward-option-tooltip-availability-detail-pip">
        {{call-to-action-pip}}
      </>
      <div class="reward-option-tooltip-availability-detail-text">
        {{unselectedDetailText}}
      </>
    {{else}}
      {{#if isLocked}}
        <img src="/fe/lol-static-assets/images/ticket-gold2.svg" class="reward-option-tooltip-availability-detail-icon">
        </>
        <div class="reward-option-tooltip-availability-detail-text">
          {{lockedDetailText}}
        </>
      {{else}}
        <div class="reward-option-tooltip-availability-detail-text">
          {{unlockedDetailText}}
        </>
      {{/if}}
    {{/if}}
  {{/if}}
</>
<div class="reward-option-tooltip-image">
  <img src={{imagePath}} class="reward-option-tooltip-image-element">
  </>
  {{#if rarityIcon}}
    <div class="reward-option-tooltip-rarity-icon-wrapper">
      <img src={{rarityIcon}} class="reward-option-tooltip-rarity-icon">
      </>
    </>
  {{/if}}
</>
{{#if shouldShowDescriptionFooter}}
  <div class="reward-option-tooltip-description">
    <div class="reward-option-tooltip-description-name">
      {{optionItem.rewardName}}
    </>
    {{#if typeIcon}}
      <div class="reward-option-tooltip-description-type">
        <img src={{typeIcon}} class="reward-option-tooltip-description-type-icon">
        </>
        {{typeName}}
      </>
    {{/if}}
  </>
{{/if}}
