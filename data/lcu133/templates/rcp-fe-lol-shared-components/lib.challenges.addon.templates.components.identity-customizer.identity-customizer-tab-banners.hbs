<div class="identity-customizer-subheader">
  <div class="search-filter-container">
    <lol-uikit-flat-input>
      {{input type="search" maxlength="50" class="search-filter-input" value=searchFilter placeholder=tra.challenges_search_placeholder}}
    </>
  </>
  <div class="filter-container">
    <lol-uikit-flat-checkbox class="ownership-filter">
      {{input slot="input" type="checkbox" name="isUnowned" checked=isUnownedShown}}
      <label slot="label" class="collection-checkbox-label" for="isUnowned">
        {{tra.challenges_identity_customizer_show_unowned}}
      </>
    </>
  </>
</>
<div class="identity-customizer-grid">
  <lol-uikit-scrollable overflow-masks="enabled">
    {{#if emptySearch}}
      {{identity-customizer-empty-search clearSearch=(action this "clearSearch"}}
    {{else}}
      {{#each filteredBanners as |banner|}}
        <div class="identity-customizer-banner {{if banner.selected "selected"}} {{if banner.disabled "banner-disabled"}} {{unless banner.isSelectable "unselectable"}}" {{action this "selectBanner" banner}} {{action this "onBannerHover" banner on="mouseEnter"}}>
          <div class="identity-customizer-banner-container">
            {{#if banner.disabled}}
              <div class="identity-customizer-banner-disabled-container">
                <img class="identity-customizer-banner-disabled" src="/fe/lol-static-assets/images/banner-skin-past-ranked-locked.svg">
                </>
              </>
            {{else}}
              {{#if banner.assetPath}}
                <div class="identity-customizer-banner-wrapper">
                  <img src={{banner.assetPath}} height="150px" width="60px">
                  </>
                </>
              {{else}}
                <div class="identity-customizer-banner-wrapper">
                  <lol-regalia-banner-v2-element banner-id={{banner.bannerId}} banner-type={{banner.bannerType}} banner-rank={{banner.tier}} class="identity-customizer-banner-element">
                  </>
                </>
              {{/if}}
            {{/if}}
            {{#unless banner.isSelectable}}
              <div class="identity-customizer-banner-locked-container">
                <img class="identity-customizer-banner-locked" src="/fe/lol-static-assets/images/banner-skin-locked.svg">
                </>
              </>
            {{/unless}}
            <div class="identity-customizer-banner-title {{if banner.disabled "locked"}}">
              {{banner.title}}
            </>
            <div class="identity-customizer-banner-description {{if banner.disabled "locked"}}">
              {{banner.description}}
            </>
          </>
        </>
      {{/each}}
    {{/if}}
  </>
</>
