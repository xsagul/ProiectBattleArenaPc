<div class="step-container">
  <h2 class="step-heading">
    {{tra.account_verification_phone_entry_heading}}
    {{tra.account_verification_step_heading}}
    {{#if isPasswordEntryActive}}
      2
    {{else}}
      1
    {{/if}}
    {{tra.account_verification_of_heading}}
    {{#if isPasswordEntryActive}}
      3
    {{else}}
      2
    {{/if}}
  </>
  <p class="step-body left-aligned">
    {{sanitize tra.account_verification_phone_entry_body}}
    <br>
    </>
    {{sanitize tra.account_verification_phone_entry_body1}}
    <br>
    </>
    {{sanitize tra.account_verification_phone_entry_body2}}
    <a href="{{tra.account_verification_phone_entry_body2_link_adress}}" target="_blank">
      {{tra.account_verification_phone_entry_body2_link_desc}}
    </>
  </>
  <h3 class="field-title">
    {{tra.account_verification_phone_entry_field_title}}
  </>
  <div class="tencent-phone-input-container">
    <lol-uikit-flat-input class="{{if isPhoneNumberValid "" "field-error"}}{{if isPhoneNumberNotRegistered "" "field-error"}}">
      {{input class="field narrow" value=phoneNumberPart1 key-press="restrictField" insert-newline="countryCodeEntered" focus-in="countryCodeFocusedIn" focus-out="countryCodeFocusedOut" maxlength="4" placeholder=tra.account_verification_phone_number_country_code type="text"}}
      {{input class="field wide" value=phoneNumberPart2 key-press="restrictField" insert-newline="phoneNumberEntered" maxlength="22" placeholder=tra.account_verification_phone_number_placeholder type="text"}}
    </>
  </>
  {{#if isPhoneNumberValid}}
    {{#if isPhoneNumberNotRegistered}}
      {{#if isTokenRequestNotInProgress}}
        <p class="field-desc">
          {{tra.account_verification_phone_entry_field_desc}}
        </>
      {{/if}}
    {{/if}}
  {{/if}}
  {{#unless isPhoneNumberValid}}
    {{#if isPhoneNumberNotRegistered}}
      {{#if isTokenRequestNotInProgress}}
        <p class="field-desc field-error-text">
          {{tra.account_verification_phone_entry_not_valid_error}}
        </>
      {{/if}}
    {{/if}}
  {{/unless}}
  {{#unless isPhoneNumberNotRegistered}}
    {{#if isPhoneNumberValid}}
      {{#if isTokenRequestNotInProgress}}
        <p class="field-desc field-error-text">
          {{tra.account_verification_phone_entry_already_registered_error}}
        </>
      {{/if}}
    {{/if}}
  {{/unless}}
  {{#unless isTokenRequestNotInProgress}}
    {{#if isPhoneNumberValid}}
      {{#if isPhoneNumberNotRegistered}}
        <p class="field-desc field-error-text">
          {{tra.account_verification_phone_entry_token_request_in_progress_error}}
          {{#if tokenRequestInProgressTimeLeftInSec}}
            <br>
            </>
            {{tra.account_verification_approximate_time_left_in_seconds}}
            {{tokenRequestInProgressTimeLeftInSec}}
          {{/if}}
        </>
      {{/if}}
    {{/if}}
  {{/unless}}
  <lol-uikit-flat-button-group class="step-buttons" type="dialog-frame">
    <lol-uikit-flat-button onclick={{action this "postPhoneNumber"}}>
      {{tra.account_verification_submit_button}}
    </>
  </>
</>
