{{#if showNotificationPip}}
  <div class="notification-pip">
    {{call-to-action-pip}}
  </>
{{/if}}
<img class="identity-customizer-icon {{if isSelected "selected"}}" src="{{icon.imagePath}}" {{action this "onIconHover" on="mouseEnter"}} {{action this "selectIcon" icon}}>
</>
{{#if icon.rarityIconSrc}}
  <img class="identity-customizer-icon-rarity" src="{{icon.rarityIconSrc}}">
  </>
{{/if}}
{{#uikit-tooltip tooltipPosition="top" type="system"}}
  {{identity-icon-tooltip icon=icon shouldShowLegacyInfo=shouldShowLegacyInfo}}
{{/uikit-tooltip}}
