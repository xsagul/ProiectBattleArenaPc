{{#uikit-tooltip tooltipPosition="right" type="system"}}
  {{#if isHoverActive}}
    {{challenge-item-tooltip puuid=puuid challengeData=challengeData apexLadderUpdateTime=apexLadderUpdateTime animationsEnabled=animationsEnabled}}
  {{/if}}
{{/uikit-tooltip}}
{{#challenge-card isInactive=isInactive isLegacyStyle=isLegacy currentLevel=currentLevel nextLevel=nextLevel pointsAwarded=pointsAwarded animationsEnabled=animationsEnabled}}
  {{challenge-card-header leftDetailClass="challenge-points-awarded" leftValue=challengeData.pointsAwarded showLeftHeaderDetail=showPointsAwarded rightDetailClass=headerIconPath showRightHeaderDetail=showMapIcon showSecondaryRightHeaderDetail=shouldDisplayIsRetiring secondaryRightDetailClass="icon-clock"}}
  <div class="challenge-item-description-content">
    <div class="challenge-item-icon-container">
      <div class="challenge-item-radial-container {{if hideRadialProgress "hidden"}}">
        {{#if showAnimatedElements}}
          <div class="challenge-item-animated-radial">
            <div class="radial-fill">
              <lol-uikit-lottie class="lottie-radial-fill" src={{lottieBarFillPath}} param-current-exp={{lottieRadialOldPercent}} param-new-exp={{lottieRadialNewPercent}} autoplay="false">
              </>
            </>
          </>
        {{else}}
          <lol-uikit-radial-progress class="challenge-item-radial-progress-container" type="custom" percent="{{challengeProgressPercentage}}" start-angle="-135" end-angle="-405">
            <div slot="bottom" class="challenge-item-radial bottom ">
            </>
            <div slot="middle" class="challenge-item-radial middle color-{{challengeData.currentLevel}}">
            </>
          </>
        {{/if}}
      </>
      <img class="challenge-item-icon" src="{{iconPath}}">
      </>
      <div class="challenge-item-icon-mask">
      </>
    </>
    {{#if isEoGUpdate}}
      {{#if isChallengeUpgraded}}
        <div class="challenge-level-up-text">
          {{tra.career_postgame_challenge_update_card_level_up}}
        </>
      {{else}}
        {{#if challengeProgressValue}}
          <div class="challenge-xp-earned">
            {{challengeProgressValue}}
          </>
        {{/if}}
      {{/if}}
    {{/if}}
    <div class="challenge-item-challenge-name {{if hasNextMilestoneRewards "short-name"}}">
      {{txtTitle}}
    </>
    {{#if isEoGUpdate}}
      {{#if showApexPoints}}
        <div class="challenge-item-apex-update-points">
          {{challengeData.currentValue}}
        </>
      {{else}}
        {{#if isChallengeUpgraded}}
          <div class="challenge-item-challenge-description">
            {{challengeProgressValue}}
          </>
        {{/if}}
      {{/if}}
    {{else}}
      <div class="challenge-item-challenge-description {{if hasNextMilestoneRewards "short-description"}}">
        {{sanitize txtDescription}}
      </>
    {{/if}}
    {{#if hasChallengeRequirements}}
      <div class="challenge-item-click-hitbox" onclick={{action this "openChallengeRequirementsModal"}}>
      </>
    {{/if}}
  </>
  {{challenge-item-footer challengeData=challengeData}}
  <div class="challenge-item-border-animation-container">
    <lol-uikit-video class="challenge-item-border-animation" src={{lottieBorderAnimationPath}} type="idle" fade-in="150">
    </>
  </>
{{/challenge-card}}
{{#if showChallengeRequirementsModal}}
  <lc-modal open={{true}} onHide={{action this "onHideChallengeRequirementsModal"}}>
    <lc-modal-content>
      <lol-uikit-dialog-frame class="dialog-frame">
        {{challenge-requirements-grid challenge=challengeData handleCloseModal="onHideChallengeRequirementsModal"}}
      </>
    </>
  </>
{{/if}}
