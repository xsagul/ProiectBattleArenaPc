<div class="challenge-banner-container">
  {{#if lobbyChallengesEnabled}}
    {{challenge-banner-title titleData=titleData localPlayerChallengesData=localPlayerChallengesData}}
    {{#unless showTitleOnly}}
      <div class="challenge-banner-token-container">
        {{#each challengesSummary.topChallenges as |challengeData index|}}
          <div {{action this "onTokenHover" challengeData.id on="mouseEnter"}}>
            {{challenge-banner-token puuid=puuid challengeData=challengeData localPlayerChallengesData=localPlayerChallengesData isLocalPlayer=isLocalPlayer isComparable=true isInteractable=isInteractable selectedTokenSlot=selectedTokenSlot}}
          </>
        {{/each}}
        {{#each placeholderChallenges as |placeholderChallenge index|}}
          {{challenge-banner-token isLocalPlayer=isLocalPlayer isPlaceholder=true isInteractable=isInteractable selectedTokenSlot=selectedTokenSlot}}
        {{/each}}
      </>
    {{/unless}}
  {{/if}}
</>
