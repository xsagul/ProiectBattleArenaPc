{{#if isTFT}}
  <div class="split-panel-header {{if viewingProgression "left-tab-active" "right-tab-active"}}">
    <a id="invite-header-progression" class="split-panel-header-title
        {{if viewingProgression "active"}}
        {{unless progressionEnabled "disabled"}}" {{action this "viewProgression"}}>
      {{tra.tft_progression_panel_title}}
    </>
    <a id="invite-header-invited" class="split-panel-header-title {{if viewingProgression "" "active"}}" {{action this "viewInvited"}}>
      {{tra.invited_panel_title}}
      (
      {{invites.length}}
      )
    </>
    <div class="split-panel-arrow {{if panelIsCollapsed "collapsed"}}" {{action this "toggleCollapsed"}}>
    </>
  </>
{{else}}
  {{#if isNotCustom}}
    <div class="split-panel-header {{if viewingSuggested "left-tab-active" "right-tab-active"}}">
      <a id="invite-header-suggested" class="split-panel-header-title
        {{if viewingSuggested "active"}}
        {{if suggestedDisabled "disabled"}}" {{action this "viewSuggested"}}>
        {{tra.suggested_panel_lobby_title}}
        {{#if honorSuggestionsEnabled}}
          <div class="invite-header-suggested-info-icon">
            {{#uikit-tooltip tooltipPosition="top" padding="large"}}
              <lol-uikit-content-block class="invite-header-suggested-tooltip-content">
                <p class="invite-header-suggested-tooltip-content-title">
                  {{suggestedTooltipDescription}}
                </>
                <div class="invite-header-suggested-tooltip-content-divider-container">
                  <div class="invite-header-suggested-tooltip-content-divider">
                  </>
                </>
                <ul class="invite-header-suggested-tooltip-content-list">
                  <li class="invite-header-suggested-tooltip-content-honors">
                    <img src="/fe/lol-parties/recently-honored-tooltip-icon.png" class="invite-header-suggested-tooltip-content-honors-icon">
                    </>
                    <div class="invite-header-suggested-tooltip-content-description">
                      {{suggestedTooltipRecentlyHonoredText}}
                    </>
                  </>
                  <li class="invite-header-suggested-tooltip-content-friends">
                    <img src="/fe/lol-parties/friend-tooltip-icon.png" class="invite-header-suggested-tooltip-content-friend-icon">
                    </>
                    <div class="invite-header-suggested-tooltip-content-description">
                      {{suggestedTooltipFriendText}}
                    </>
                  </>
                  <li class="invite-header-suggested-tooltip-content-recently-played">
                    <img src="/fe/lol-parties/recently-played-tooltip-icon.png" class="invite-header-suggested-tooltip-content-recently-played-icon">
                    </>
                    <div class="invite-header-suggested-tooltip-content-description">
                      {{suggestedTooltipRecentlyPlayedText}}
                    </>
                  </>
                </>
              </>
            {{/uikit-tooltip}}
          </>
        {{/if}}
      </>
      <a id="invite-header-invited" class="split-panel-header-title {{if viewingSuggested "" "active"}}" {{action this "viewInvited"}}>
        {{tra.invited_panel_title}}
        (
        {{invites.length}}
        )
      </>
      <div class="split-panel-arrow {{if panelIsCollapsed "collapsed"}}" {{action this "toggleCollapsed"}}>
      </>
    </>
  {{else}}
    <!-- Do not show tabbed header with suggested if invite info only -->
    <div class="custom-invite-header">
      <span class="custom-invite-header-text">
        {{tra.custom_game_invited_panel_title}}
        (
        {{invites.length}}
        )
      </>
    </>
  {{/if}}
{{/if}}
<div class="parties-invite-info-panel-body {{if panelIsCollapsed "collapsed"}}">
  <ul class="parties-invite-info-panel-list
  {{if viewingSuggested "viewing-suggested"}}
  {{if isCustom "parties-invite-info-is-custom"}}">
    {{#if viewingSuggested}}
      {{#each suggestedInvites as |suggestedPlayer|}}
        {{v2-invite-info-panel-player currentPlayerCanInvite=currentPlayerCanInvite player=suggestedPlayer isSuggested=true isTFT=isTFT}}
      {{/each}}
    {{else}}
      {{#if viewingProgression}}
        {{invite-info-panel-tft-progression class="tft-progression" activeMilestonesProgress=activeMilestonesProgress}}
      {{else}}
        {{#if isTFT}}
          {{#unless suggestedDisabled}}
            {{#each suggestedInvites as |suggestedPlayer|}}
              {{v2-invite-info-panel-player currentPlayerCanInvite=currentPlayerCanInvite player=suggestedPlayer isSuggested=true isTFT=isTFT}}
            {{/each}}
          {{/unless}}
        {{/if}}
        {{#if hasInvites}}
          {{#each invites as |invite|}}
            {{v2-invite-info-panel-player currentPlayerCanInvite=currentPlayerCanInvite invitedPlayer=invite isSuggested=false isTFT=isTFT}}
          {{/each}}
        {{else}}
          <li class="parties-invite-info-empty">
            <span class="parties-invite-info-empty-text">
              {{tra.custom_game_invited_panel_no_invites}}
            </>
          </>
        {{/if}}
      {{/if}}
    {{/if}}
  </>
</>
