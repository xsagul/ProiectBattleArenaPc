<div class="lobby-point-eligibility-content">
  <div class="point-eligibility-icon">
  </>
</>
{{#uikit-tooltip tooltipConfig=tooltipConfig}}
  <lol-uikit-content-block padding="medium" class="lobby-point-eligibility-tooltip-content">
    <div class="lobby-point-eligibility-tooltip-content-header">
      <div class="lobby-header-map-icon {{mapBackgroundClass}}">
      </>
      <div class="lobby-point-eligibility-tooltip-content-header-title">
        <div class="lobby-point-eligibility-tooltip-content-header-map">
          {{mapName}}
        </>
        <div class="lobby-point-eligibility-tooltip-content-header-mode">
          {{queueName}}
          {{pickTypeName}}
          (
          {{teamSize}}
          )
        </>
      </>
    </>
    <div class="lobby-point-eligibility-tooltip-content-divider-container">
      <div class="lobby-point-eligibility-tooltip-content-divider">
      </>
    </>
    <h6 class="lobby-point-eligibility-tooltip-content-title">
      {{tra.parties_point_eligibility_tooltip_title}}
    </>
    <ul class="lobby-point-eligibility-tooltip-content-list">
      <li class="lobby-point-eligibility-tooltip-content-experience {{xpDisabledClass}}">
        <div class="lobby-point-eligibility-tooltip-content-experience-icon">
        </>
        <div class="lobby-point-eligibility-tooltip-content-description">
          {{tra.parties_point_eligibility_tooltip_experience}}
        </>
      </>
      <li class="lobby-point-eligibility-tooltip-content-mastery {{championMasteryDisabledClass}}">
        <div class="lobby-point-eligibility-tooltip-content-mastery-icon">
        </>
        <div class="lobby-point-eligibility-tooltip-content-description">
          {{tra.parties_point_eligibility_tooltip_masteries}}
        </>
      </>
      {{#if platformEternalsEnabled}}
        <li class="lobby-point-eligibility-tooltip-content-eternals {{eternalsDisabledClass}}">
          <div class="lobby-point-eligibility-tooltip-content-eternals-icon">
          </>
          <div class="lobby-point-eligibility-tooltip-content-description">
            {{tra.parties_point_eligibility_tooltip_eternals}}
          </>
        </>
      {{/if}}
      {{#if lobbyChallengesEnabled}}
        <li class="lobby-point-eligibility-tooltip-content-challenges {{challengesDisabledClass}}">
          <div class="lobby-point-eligibility-tooltip-content-challenges-icon">
          </>
          <div class="lobby-point-eligibility-tooltip-content-description">
            {{tra.challenges_point_eligibility_tooltip_challenges}}
          </>
        </>
      {{/if}}
    </>
  </>
{{/uikit-tooltip}}
