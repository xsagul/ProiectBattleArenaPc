{{#if rankedData}}
  <lol-regalia-emblem-element class="rank-identity-tooltip-rank-icon" ranked-tier="{{if useRankFromQueue rankedQueue.tier highestRankTier}}">
  </>
  <div class="rank-identity-tooltip-details">
    {{#if useRankFromQueue}}
      <div class="rank-identity-tooltip-rank">
        {{rankedQueueTierDivisionText}}
        <span>
          -
          {{rankedQueueLeaguePointsText}}
        </>
      </>
    {{else}}
      <div class="rank-identity-tooltip-rank">
        {{highestRankTierDivisionText}}
        <span>
          -
          {{highestRankLeaguePointsText}}
        </>
      </>
    {{/if}}
    {{#if hasPastRank}}
      <div class="rank-identity-tooltip-past-rank">
        <img class="rank-identity-tooltip-past-rank-icon" src="{{pastMiniRegaliaIconPath}}">
        </>
        {{pastRankedTierText}}
      </>
    {{/if}}
  </>
{{/if}}
