{{#if shouldShowNavBar}}
  {{#if statusTicker.hasIncidents}}
    {{status-ticker}}
  {{/if}}
  {{nav-bar}}
{{else}}
  {{status-ticker}}
{{/if}}
<lc-confirm-modal acceptText={{tra.crash_report_modal_yes}} declineText={{tra.crash_report_modal_no}} onYes={{action this "confirmCrashReportUpload"}} onNo={{action this "declineCrashReportUpload"}} open={{isCrashReportModalShown}}>
  <lc-modal-content>
    <lol-uikit-content-block class="" type="dialog-small">
      <h4>
        {{tra.crash_report_modal_title}}
      </>
      <hr class="heading-spacer">
      </>
      <p>
        {{tra.crash_report_modal_subtitle}}
      </>
    </>
  </>
</>
