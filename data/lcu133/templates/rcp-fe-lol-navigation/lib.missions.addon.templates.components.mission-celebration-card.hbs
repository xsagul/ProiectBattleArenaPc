<uikit-state-machine class="mission-celebration-card-animation" state="show-card" mission-size="{{missionSizeType}}">
  <uikit-states>
    <uikit-state name="show-card">
      <uikit-transition next-state="fill-progress-bar">
        <uikit-condition-delay duration="500">
        </>
      </>
    </>
    <uikit-state name="fill-progress-bar">
      <uikit-transition next-state="idle-card">
        <uikit-condition-delay duration="650">
        </>
      </>
    </>
    <uikit-state name="idle-card">
      <uikit-transition next-state="hide-card">
        <uikit-condition-parameter name="mission-size" value="small">
        </>
        <uikit-condition-any>
          <uikit-condition-delay duration="1000">
          </>
        </>
      </>
      <uikit-transition next-state="hide-card">
        <uikit-condition-parameter name="mission-size" value="medium">
        </>
        <uikit-condition-any>
          <uikit-condition-delay duration="1250">
          </>
        </>
      </>
      <uikit-transition next-state="hide-card">
        <uikit-condition-parameter name="mission-size" value="large">
        </>
        <uikit-condition-any>
          <uikit-condition-delay duration="1500">
          </>
        </>
      </>
    </>
    <uikit-state name="hide-card">
      <uikit-behavior-media selector=".mission-small-dissipate" playing="">
      </>
      <uikit-behavior-media selector=".mission-medium-dissipate" playing="">
      </>
      <uikit-behavior-media selector=".mission-large-dissipate" playing="">
      </>
      <uikit-transition next-state="complete">
        <uikit-condition-delay duration="550">
        </>
      </>
    </>
    <uikit-state name="complete">
    </>
  </>
  <div class="mission-wrapper show-card" visible-state="show-card,fill-progress-bar,idle-card,hide-card,complete">
    <div class="mission-item-wrapper {{if isMissionHiddenState "hide-mission-card"}}">
      {{mission-item mission=mission showStatus=true}}
      {{#if largeAreaAnimationsEnabled}}
        <div class="{{if isMissionHideState "mission-hider"}}">
        </>
      {{/if}}
    </>
    {{#if isSmallMission}}
      <user-experience-perf-switch class="mission-dissipate mission-small-dissipate" default-visibility="hidden">
        <uikit-video src="/fe/lol-navigation/EoG_ExplodeSmall_Magic.webm" perf-flags="largeAreaAnimationsEnabled" cache-name="rcp-fe-lol-missions">
        </>
        <div class="hidden">
        </>
      </>
    {{else}}
      {{#if isMediumMission}}
        <user-experience-perf-switch class="mission-dissipate mission-medium-dissipate" default-visibility="hidden">
          <uikit-video src="/fe/lol-navigation/EoG_ExplodeMedium_Magic.webm" perf-flags="largeAreaAnimationsEnabled" cache-name="rcp-fe-lol-missions">
          </>
          <div class="hidden">
          </>
        </>
      {{else}}
        {{#if isLargeMission}}
          <user-experience-perf-switch class="mission-dissipate mission-large-dissipate" default-visibility="hidden">
            <uikit-video src="/fe/lol-navigation/EoG_ExplodeLarge_Magic.webm" perf-flags="largeAreaAnimationsEnabled" cache-name="rcp-fe-lol-missions">
            </>
            <div class="hidden">
            </>
          </>
        {{/if}}
      {{/if}}
    {{/if}}
  </>
</>
