<uikit-state-machine class="mission-animation" state="default" viewed="{{viewed}}" has-progress="{{hasProgress}}" will-complete="{{willComplete}}" is-new="{{isNew}}" is-expired="{{isExpired}}" is-complete="{{isComplete}}" mission-status="{{status}}">
  <uikit-states>
    <uikit-state name="default">
      <uikit-transition next-state="new">
        <uikit-condition-parameter name="is-new" value="true">
        </>
      </>
      <uikit-transition next-state="progress">
        <uikit-condition-parameter name="has-progress" value="true">
        </>
      </>
      <uikit-transition next-state="alreadyCompleted">
        <uikit-condition-parameter name="has-progress" value="false">
        </>
        <uikit-condition-parameter name="is-complete" value="true">
        </>
      </>
      <uikit-transition next-state="ineligible">
        <uikit-condition-parameter name="mission-status" value="INELIGIBLE">
        </>
      </>
      <uikit-transition next-state="expired">
        <uikit-condition-parameter name="is-expired" value="true">
        </>
      </>
    </>
    <uikit-state name="ineligible">
    </>
    <uikit-state name="expired">
      <uikit-transition next-state="default">
        <uikit-condition-parameter name="is-expired" value="false">
        </>
      </>
    </>
    <uikit-state name="progress">
      <uikit-transition next-state="complete">
        <uikit-condition-delay duration="500">
        </>
        <uikit-condition-parameter name="is-complete" value="true">
        </>
      </>
      <uikit-transition next-state="default">
        <uikit-condition-parameter name="is-complete" value="false">
        </>
        <uikit-condition-parameter name="has-progress" value="false">
        </>
      </>
    </>
    <uikit-state name="complete">
      <uikit-transition next-state="post-complete">
        <uikit-condition-parameter name="is-complete" value="true">
        </>
        <uikit-condition-parameter name="has-progress" value="false">
        </>
      </>
    </>
    <uikit-state name="post-complete">
      <uikit-transition next-state="alreadyCompleted">
        <uikit-condition-delay duration="1000">
        </>
      </>
    </>
    <uikit-state name="alreadyCompleted">
    </>
    <uikit-state name="new">
      <uikit-behavior-media selector=".new-vid-top" playing="">
      </>
      <uikit-behavior-media selector=".new-vid-bottom" playing="">
      </>
      <uikit-transition next-state="revealed">
        <uikit-condition-delay duration="1400">
        </>
      </>
    </>
    <uikit-state name="revealed">
      <uikit-transition next-state="complete">
        <uikit-condition-parameter name="is-complete" value="true">
        </>
      </>
      <uikit-transition next-state="progress">
        <uikit-condition-parameter name="has-progress" value="true">
        </>
      </>
      <uikit-transition next-state="expired">
        <uikit-condition-parameter name="is-expired" value="true">
        </>
      </>
    </>
  </>
  <user-experience-perf-switch class="new-vid-top" visible-state="new" default-visibility="hidden">
    <uikit-video src="/fe/lol-navigation/new/new-mission-top.webm" perf-flags="largeAreaAnimationsEnabled" cache-name="rcp-fe-lol-missions">
    </>
  </>
  <user-experience-perf-switch class="new-vid-bottom" visible-state="new" default-visibility="hidden">
    <uikit-video src="/fe/lol-navigation/new/new-mission-bottom.webm" perf-flags="largeAreaAnimationsEnabled" cache-name="rcp-fe-lol-missions">
    </>
  </>
  <lol-uikit-content-block class="mission-item {{if isPendingRemoval "overlay"}}" visible-state="default,ineligible,expired,progress,complete,post-complete,alreadyCompleted,new,revealed">
    <div class="mission-top">
      <div style={{iconSource}} class="mission-icon {{if badgeType "mission-icon-loyalty"}} {{if isACompletedState "mission-icon-fade"}}">
        {{#if isPendingRemoval}}
          <div class="mission-expired-icon">
          </>
        {{else}}
          {{#if isACompletedState}}
            {{#if isPostCompleteState}}
              <div class="mission-completed-icon-border">
                <svg width="66" height="66">
                  <line class="top" x1="0" y1="0" x2="264" y2="0">
                  </>
                  <line class="left" x1="0" y1="66" x2="0" y2="-198">
                  </>
                  <line class="bottom" x1="66" y1="66" x2="-198" y2="66">
                  </>
                  <line class="right" x1="66" y1="0" x2="66" y2="264">
                  </>
                </>
              </>
            {{/if}}
            <div class="mission-completed-icon {{if isPostCompleteState "mission-completed-icon-mask"}}">
            </>
          {{/if}}
        {{/if}}
      </>
      <div class="mission-right">
        <div class="mission-text {{if badgeType "mission-text-badge"}}">
          <div class="mission-header">
            <span class="mission-title {{if isNew "unread"}}">
              {{sanitize title}}
            </>
            <span class="mission-description">
              {{sanitize description}}
            </>
          </>
          <div class="mission-helper-text">
            {{sanitize helperText}}
          </>
        </>
        {{#if badgeType}}
          <div class="mission-right-badge {{badgeType}}">
          </>
        {{/if}}
        <div class="mission-objectives">
          {{mission-objectives objectives=objectives completionExpression=completionExpression isExpired=isPendingRemoval hasProgress=hasProgress isComplete=isACompletedState}}
        </>
      </>
    </>
    <div class="mission-bottom">
      <div class="mission-rewards">
        {{#each rewards as |reward|}}
          {{mission-reward hasProgress=hasProgress reward=reward}}
        {{/each}}
      </>
      {{#if showStatus}}
        {{#if rewardPending}}
          <div class="mission-pending">
          </>
        {{else}}
          {{#if isExpiring}}
            <div class="mission-expiring">
            </>
          {{else}}
            {{#if isRepeatingMission}}
              <div class="mission-repeating">
              </>
            {{/if}}
          {{/if}}
        {{/if}}
        <div class="mission-duration {{if rewardPending "pending"}} {{if isACompletedState "completed"}} {{if isExpiring "expiring"}}">
          {{duration}}
        </>
      {{/if}}
    </>
  </>
</>
