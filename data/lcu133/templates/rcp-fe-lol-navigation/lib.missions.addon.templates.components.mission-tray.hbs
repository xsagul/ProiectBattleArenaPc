<uikit-state-machine class="tracker-animation" state="hidden" is-visible="{{isVisible}}" has-progress="{{hasProgress}}" has-removed="{{hasRemovedMissions}}" has-complete="{{hasUnviewedCompleted}}">
  <uikit-states>
    <uikit-state name="hidden">
      <uikit-transition next-state="ready">
        <uikit-condition-parameter name="is-visible" value="true">
        </>
      </>
    </>
    <uikit-state name="ready">
      <uikit-transition next-state="removed-missions">
        <uikit-condition-delay duration="1000">
        </>
        <uikit-condition-parameter name="has-removed" value="true">
        </>
      </>
      <uikit-transition next-state="complete-missions">
        <uikit-condition-delay duration="800">
        </>
        <uikit-condition-parameter name="has-removed" value="false">
        </>
        <uikit-condition-parameter name="has-complete" value="true">
        </>
      </>
      <uikit-transition next-state="post-complete">
        <uikit-condition-delay duration="600">
        </>
        <uikit-condition-parameter name="has-removed" value="false">
        </>
        <uikit-condition-parameter name="has-complete" value="false">
        </>
      </>
      <uikit-transition next-state="hidden">
        <uikit-condition-any>
          <uikit-condition-parameter name="is-visible" value="false">
          </>
        </>
      </>
    </>
    <uikit-state name="removed-missions">
      <uikit-transition next-state="hidden">
        <uikit-condition-any>
          <uikit-condition-parameter name="is-visible" value="false">
          </>
        </>
      </>
      <uikit-transition next-state="complete-missions">
        <uikit-condition-delay duration="600">
        </>
        <uikit-condition-parameter name="has-complete" value="true">
        </>
      </>
      <uikit-transition next-state="post-complete">
        <uikit-condition-delay duration="200">
        </>
        <uikit-condition-parameter name="has-complete" value="false">
        </>
      </>
    </>
    <uikit-state name="complete-missions">
      <uikit-transition next-state="post-complete">
        <uikit-condition-delay duration="2750">
        </>
      </>
      <uikit-transition next-state="hidden">
        <uikit-condition-any>
          <uikit-condition-parameter name="is-visible" value="false">
          </>
        </>
      </>
    </>
    <uikit-state name="post-complete">
      <uikit-transition next-state="progress-missions">
        <uikit-condition-delay duration="600">
        </>
        <uikit-condition-parameter name="has-progress" value="true">
        </>
      </>
      <uikit-transition next-state="post-progress">
        <uikit-condition-delay duration="200">
        </>
        <uikit-condition-parameter name="has-progress" value="false">
        </>
      </>
      <uikit-transition next-state="hidden">
        <uikit-condition-any>
          <uikit-condition-parameter name="is-visible" value="false">
          </>
        </>
      </>
    </>
    <uikit-state name="progress-missions">
      <uikit-transition next-state="post-progress">
        <uikit-condition-delay duration="600">
        </>
      </>
      <uikit-transition next-state="hidden">
        <uikit-condition-any>
          <uikit-condition-parameter name="is-visible" value="false">
          </>
        </>
      </>
    </>
    <uikit-state name="post-progress">
      <uikit-transition next-state="done">
        <uikit-condition-delay duration="200">
        </>
      </>
      <uikit-transition next-state="hidden">
        <uikit-condition-any>
          <uikit-condition-parameter name="is-visible" value="false">
          </>
        </>
      </>
    </>
    <uikit-state name="done">
      <uikit-transition next-state="ready">
        <uikit-condition-any>
          <uikit-condition-parameter name="has-progress" value="true">
          </>
          <uikit-condition-parameter name="has-complete" value="true">
          </>
          <uikit-condition-parameter name="has-removed" value="true">
          </>
        </>
      </>
      <uikit-transition next-state="hidden">
        <uikit-condition-any>
          <uikit-condition-parameter name="is-visible" value="false">
          </>
        </>
      </>
    </>
  </>
</>
<div class="mission-poro-background {{unless isNotEmpty "visible"}}">
</>
{{#if hasBeenOpened}}
  <lol-uikit-perfect-scrollable class="mission-list">
    {{#if ready}}
      {{#each filteredUpsellCards as |upsell|}}
        {{mission-token-upsell-card tokenUpsell=upsell}}
      {{/each}}
    {{/if}}
    {{#each inductableSeries as |seriesItem|}}
      {{mission-series-induction series=seriesItem missionsService=missionsService}}
    {{/each}}
    {{#each missions as |mission|}}
      {{mission-item mission=mission enableHoverBehavior=true largeAreaAnimationsEnabled=largeAreaAnimationsEnabled}}
    {{/each}}
  </>
{{/if}}
