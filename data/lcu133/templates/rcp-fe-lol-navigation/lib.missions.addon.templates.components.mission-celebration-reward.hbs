<div class="celebration-reward-icon-wrapper">
  <div class="celebration-reward-glow {{rewardLayoutType}}">
    {{#if isChroma}}
      <div class="celebration-chroma-bg">
      </>
    {{/if}}
    <div class="celebration-reward-image-wrapper {{if isShard "shard"}} {{if rewardIconError "icon-error" rewardLayoutType}}">
      <img class="celebration-reward-image" onerror={{action this "rewardImageError"}} src="{{iconUrl}}">
      </>
    </>
  </>
  {{#if hasBorder}}
    <div class="celebration-reward-border
    			{{if isSplash "splash"}}
                {{if isShard "shard"}}
                {{if isSkin "skin"}}
                {{if isChroma "chroma"}}">
    </>
  {{/if}}
  {{#if isSkin}}
    <div class="celebration-reward-champion-icon-circle">
      <svg class="celebration-reward-champion-icon-border-svg" shape-rendering="geometricPrecision" stroke-width="0" width="50" height="50" version="1.1" xmlns="http://www.w3.org/2000/svg">
        <radialGradient id="celebration-reward-champion-icon-border-gradient-gold" cx="0.5" cy="0" r="1">
          <stop class="stop-0" offset="0%" stop-color="#CDC2A0">
          </>
          <stop class="stop-1" offset="20%" stop-color="#AD925E">
          </>
          <stop class="stop-2" offset="60%" stop-color="#9A762C">
          </>
          <stop class="stop-3" offset="100%" stop-color="#614920">
          </>
        </>
        <radialGradient id="celebration-reward-champion-icon-border-gradient-blue" cx="0.5" cy="0" r="1">
          <stop class="stop-0" offset="0%" stop-color="#b8d5f1">
          </>
          <stop class="stop-1" offset="20%" stop-color="#91AECA">
          </>
          <stop class="stop-2" offset="60%" stop-color="#738FA4">
          </>
          <stop class="stop-3" offset="100%" stop-color="#3C4E62">
          </>
        </>
        <circle cx="25" cy="25" r="25" stroke-width="0" fill="{{if isShard "url(#celebration-reward-champion-icon-border-gradient-blue)" "url(#celebration-reward-champion-icon-border-gradient-gold)"}}">
        </>
      </>
      <div class="celebration-reward-champion-icon-wrapper">
        <div class="celebration-reward-champion-icon" style="background-image: url({{championSkinIconUrl}})">
        </>
      </>
    </>
  {{/if}}
</>
<div class="celebration-text-block {{unless rewardIconError rewardLayoutType}}">
  <div class="celebration-text">
    {{sanitize label}}
  </>
  <div class="celebration-footer">
    {{footer}}
  </>
</>
