{{#if isShowing}}
  {{#if animationsDisabled}}
    <div class="vignette-challenges-bg-ring-wrapper">
      <img class="vignette-challenges-bg-ring" src="/fe/lol-static-assets/images/challenges-shared/VGN_CRS_Tick_INTRO.png">
      </>
    </>
    <img class="vignette-challenges-bg-decoration" src="/fe/lol-static-assets/images/challenges-shared/VGN_CRS_BG_SquareBG.png">
    </>
    <div class="vignette-challenges-tiles">
      <div class="vignette-challenges-tile vignette-challenges-tile-1 {{expertiseInfo.level}}">
        <img class="vignette-challenges-tile-img" src="{{tileImgSrc}}">
        </>
        <div class="vignette-challenges-tile-icon category-expertise-img">
        </>
      </>
      <div class="vignette-challenges-tile vignette-challenges-tile-2 {{teamworkInfo.level}}">
        <img class="vignette-challenges-tile-img" src="{{tileImgSrc}}">
        </>
        <div class="vignette-challenges-tile-icon category-teamwork-img">
        </>
      </>
      <div class="vignette-challenges-tile vignette-challenges-tile-3 {{imaginationInfo.level}}">
        <img class="vignette-challenges-tile-img" src="{{tileImgSrc}}">
        </>
        <div class="vignette-challenges-tile-icon category-innovation-img">
        </>
      </>
      <div class="vignette-challenges-tile vignette-challenges-tile-4 {{veterancyInfo.level}}">
        <img class="vignette-challenges-tile-img" src="{{tileImgSrc}}">
        </>
        <div class="vignette-challenges-tile-icon category-veterancy-img">
        </>
      </>
      <div class="vignette-challenges-tile vignette-challenges-tile-5 {{collectionInfo.level}}">
        <img class="vignette-challenges-tile-img" src="{{tileImgSrc}}">
        </>
        <div class="vignette-challenges-tile-icon category-collection-img">
        </>
      </>
    </>
    <div class="vignette-challenge-crystal-container">
      <img class="vignette-challenges-crystal" src="{{crystalImgSrc}}">
      </>
    </>
  {{else}}
    <lol-uikit-lottie id="vignette-challenges-animated-bg" class="hidden" src="/fe/lol-static-assets/lottie/challenges/VGN_CRS_BG_SquareBG.json" autoplay="false">
    </>
    <lol-uikit-lottie id="vignette-challenges-animated-spinny-bg" class="hidden" src="/fe/lol-static-assets/lottie/challenges/VGN_CRS_Tick_INTRO.json" autoplay="false">
    </>
    <div id="vignette-challenger-dark-layer">
    </>
    <div class="vignette-challenges-tiles hidden">
      <div class="vignette-challenges-tile vignette-challenges-tile-1 {{expertiseInfo.level}}">
        <lol-uikit-lottie autoplay="false" class="vignette-challenges-animated-tile" src="{{tileLottieSrc}}">
        </>
        <lol-uikit-lottie id="challenges-tile-animation-1" class="vignette-challenges-tile-icon" resize-to-fit="true" image-path="fe/lol-static-assets/lottie/challenges/icons/images/" asset-tier="{{expertiseInfo.previousImgName}}" src="/fe/lol-static-assets/lottie/challenges/icons/expertise.json" autoplay="false">
        </>
      </>
      <div class="vignette-challenges-tile vignette-challenges-tile-2 {{teamworkInfo.level}}">
        <lol-uikit-lottie autoplay="false" class="vignette-challenges-animated-tile" src="{{tileLottieSrc}}">
        </>
        <lol-uikit-lottie id="challenges-tile-animation-2" class="vignette-challenges-tile-icon" resize-to-fit="true" image-path="fe/lol-static-assets/lottie/challenges/icons/images/" asset-tier="{{teamworkInfo.previousImgName}}" src="/fe/lol-static-assets/lottie/challenges/icons/teamwork.json" autoplay="false">
        </>
      </>
      <div class="vignette-challenges-tile vignette-challenges-tile-3 {{imaginationInfo.level}}">
        <lol-uikit-lottie autoplay="false" class="vignette-challenges-animated-tile" src="{{tileLottieSrc}}">
        </>
        <lol-uikit-lottie id="challenges-tile-animation-3" class="vignette-challenges-tile-icon" resize-to-fit="true" image-path="fe/lol-static-assets/lottie/challenges/icons/images/" asset-tier="{{imaginationInfo.previousImgName}}" src="/fe/lol-static-assets/lottie/challenges/icons/innovation.json" autoplay="false">
        </>
      </>
      <div class="vignette-challenges-tile vignette-challenges-tile-4 {{veterancyInfo.level}}">
        <lol-uikit-lottie autoplay="false" class="vignette-challenges-animated-tile" src="{{tileLottieSrc}}">
        </>
        <lol-uikit-lottie id="challenges-tile-animation-4" class="vignette-challenges-tile-icon" resize-to-fit="true" image-path="fe/lol-static-assets/lottie/challenges/icons/images/" asset-tier="{{veterancyInfo.previousImgName}}" src="/fe/lol-static-assets/lottie/challenges/icons/veterancy.json" autoplay="false">
        </>
      </>
      <div class="vignette-challenges-tile vignette-challenges-tile-5 {{collectionInfo.level}}">
        <lol-uikit-lottie autoplay="false" class="vignette-challenges-animated-tile" src="{{tileLottieSrc}}">
        </>
        <lol-uikit-lottie id="challenges-tile-animation-5" class="vignette-challenges-tile-icon" resize-to-fit="true" image-path="fe/lol-static-assets/lottie/challenges/icons/images/" asset-tier="{{collectionInfo.previousImgName}}" src="/fe/lol-static-assets/lottie/challenges/icons/collection.json" autoplay="false">
        </>
      </>
    </>
    <div class="vignette-challenge-crystal-video-container">
      <video id="crystal-intro" class="vignette-challenge-crystal-video" src="{{crystalVideoSrc}}" preload="">
      </>
    </>
    <div class="vignette-challenge-flare-video-container">
      <video id="flare-intro" class="vignette-challenge-flare-video {{sanitizedLevel}}" src="/fe/lol-static-assets/videos/challenges/VGN_CRS_Flare.webm" preload="none">
      </>
    </>
  {{/if}}
{{/if}}
