<div>
  <h4 class="heading">
    {{tra.email_verification_email_sent_heading}}
  </>
  <p class="email">
    {{tra.email_verification_email_sent_check}}
    {{emailVerification.email}}
  </>
  <p class="subheading">
    {{tra.email_verification_email_sent_dont_recognize}}
    <a {{action this "changeEmail"}}>
      {{tra.email_verification_email_sent_change}}
    </>
  </>
  <p class="body spaced">
    {{tra.email_verification_email_sent_body}}
    <a {{action this "visitPlayerSupport"}}>
      {{tra.email_verification_need_help}}
    </>
  </>
  {{#if showConnectionError}}
    <p class="error">
      {{tra.email_verification_connection_error}}
    </>
  {{/if}}
</>
