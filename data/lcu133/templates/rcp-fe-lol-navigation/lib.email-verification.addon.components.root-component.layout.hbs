<div class="email-verification-container">
  <div class="header-img-container">
    <img class="header-img-top" src="/fe/lol-navigation/images/braum-header.png">
    </>
  </>
  <lol-uikit-scrollable overflow-masks="enabled">
    {{#if showPrompt}}
      {{unverified-prompt changeShownScreen=changeShownScreen payload=screenPayload}}
    {{else}}
      {{#if showChangeEmail}}
        {{change-email changeShownScreen=changeShownScreen payload=screenPayload}}
      {{else}}
        {{#if showEmailSent}}
          {{email-sent changeShownScreen=changeShownScreen payload=screenPayload}}
        {{else}}
          {{#if showSuccess}}
            {{verification-success changeShownScreen=changeShownScreen payload=screenPayload}}
          {{else}}
            {{#if showError}}
              {{error-display changeShownScreen=changeShownScreen payload=screenPayload}}
            {{/if}}
          {{/if}}
        {{/if}}
      {{/if}}
    {{/if}}
  </>
</>
