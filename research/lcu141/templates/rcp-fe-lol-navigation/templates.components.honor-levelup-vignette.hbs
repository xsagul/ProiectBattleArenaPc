<img class="midground {{emblemLevel}} {{if isColorTransitionState "transition" ""}}" src="{{midgroundPath}}">
</>
<div class="foreground {{if isHiddenMographState "hidden" "fade-in"}}">
  <uikit-state-machine state="hidden" has-loop="{{hasEmblemLoop}}" current-step="{{currentDisplayStep}}" display-branch="{{displayBranch}}" low-spec="{{isLowSpec}}">
    <uikit-states>
      <uikit-state name="hidden">
        <uikit-transition next-state="levelupFadeIn">
          <uikit-condition-delay duration="50">
          </>
          <uikit-condition-parameter name="low-spec" value="false">
          </>
          <uikit-condition-parameter name="display-branch" value="levelup">
          </>
          <uikit-condition-media selector="#emblemIntro" can-play="">
          </>
          {{#if hasCheckpointOutro}}
            <uikit-condition-media selector="#checkpointOutro" can-play="">
            </>
          {{/if}}
        </>
        <uikit-transition next-state="unlockFadeIn">
          <uikit-condition-delay duration="50">
          </>
          <uikit-condition-parameter name="low-spec" value="false">
          </>
          <uikit-condition-parameter name="display-branch" value="unlock">
          </>
          <uikit-condition-media selector="#emblemIntro" can-play="">
          </>
        </>
        <uikit-transition next-state="checkpoint1FadeIn">
          <uikit-condition-delay duration="50">
          </>
          <uikit-condition-parameter name="low-spec" value="false">
          </>
          <uikit-condition-parameter name="display-branch" value="checkpoint1">
          </>
          <uikit-condition-media selector="#emblemLoop" can-play="">
          </>
          <uikit-condition-media selector="#checkpoint1Intro" can-play="">
          </>
        </>
        <uikit-transition next-state="checkpoint2FadeIn">
          <uikit-condition-delay duration="50">
          </>
          <uikit-condition-parameter name="low-spec" value="false">
          </>
          <uikit-condition-parameter name="display-branch" value="checkpoint2">
          </>
          <uikit-condition-media selector="#emblemLoop" can-play="">
          </>
          <uikit-condition-media selector="#checkpoint1Loop" can-play="">
          </>
          <uikit-condition-media selector="#checkpoint2Intro" can-play="">
          </>
        </>
        <uikit-transition next-state="checkpoint3FadeIn">
          <uikit-condition-delay duration="50">
          </>
          <uikit-condition-parameter name="low-spec" value="false">
          </>
          <uikit-condition-parameter name="display-branch" value="checkpoint3">
          </>
          <uikit-condition-media selector="#emblemLoop" can-play="">
          </>
          <uikit-condition-media selector="#checkpoint1Loop" can-play="">
          </>
          <uikit-condition-media selector="#checkpoint2Loop" can-play="">
          </>
          <uikit-condition-media selector="#checkpoint3Intro" can-play="">
          </>
        </>
        <uikit-transition next-state="levelupLoop">
          <uikit-condition-delay duration="50">
          </>
          <uikit-condition-parameter name="low-spec" value="true">
          </>
          <uikit-condition-parameter name="display-branch" value="levelup">
          </>
        </>
        <uikit-transition next-state="unlockLoop">
          <uikit-condition-delay duration="50">
          </>
          <uikit-condition-parameter name="low-spec" value="true">
          </>
          <uikit-condition-parameter name="display-branch" value="unlock">
          </>
        </>
        <uikit-transition next-state="checkpoint1Loop">
          <uikit-condition-delay duration="50">
          </>
          <uikit-condition-parameter name="low-spec" value="true">
          </>
          <uikit-condition-parameter name="display-branch" value="checkpoint1">
          </>
        </>
        <uikit-transition next-state="checkpoint2Loop">
          <uikit-condition-delay duration="50">
          </>
          <uikit-condition-parameter name="low-spec" value="true">
          </>
          <uikit-condition-parameter name="display-branch" value="checkpoint2">
          </>
        </>
        <uikit-transition next-state="checkpoint3Loop">
          <uikit-condition-delay duration="50">
          </>
          <uikit-condition-parameter name="low-spec" value="true">
          </>
          <uikit-condition-parameter name="display-branch" value="checkpoint3">
          </>
        </>
        <uikit-transition next-state="showReward">
          <uikit-condition-delay duration="50">
          </>
          <uikit-condition-parameter name="display-branch" value="checkpointMax">
          </>
        </>
      </>
      <uikit-state name="levelupFadeIn">
        <uikit-behavior-media selector="#emblemIntro" paused="">
        </>
        <uikit-behavior-media selector="#embellishment" paused="">
        </>
        <uikit-behavior-media selector="#checkpointOutro" paused="">
        </>
        <uikit-transition next-state="levelupIntro">
          <uikit-condition-delay duration="800">
          </>
        </>
        <uikit-transition next-state="levelupReward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="levelupIntro">
        <uikit-behavior-media selector="#emblemIntro" playing="">
        </>
        <uikit-behavior-media selector="#emblemLoop" preloading="">
        </>
        <uikit-behavior-media selector="#embellishment" playing="">
        </>
        <uikit-behavior-media selector="#checkpointOutro" playing="">
        </>
        <uikit-transition next-state="levelupLoop">
          <uikit-condition-parameter name="has-loop" value="true">
          </>
          <uikit-condition-media selector="#emblemIntro" ended="" non-media-duration="300ms">
          </>
        </>
        <uikit-transition next-state="levelupReward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="levelupLoop">
        <uikit-behavior-media selector="#emblemIntro" unloading="">
        </>
        <uikit-behavior-media selector="#emblemLoop" playing="">
        </>
        <uikit-transition next-state="levelupReward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="levelupReward">
        <uikit-behavior-media selector="#emblemIntro" unloading="">
        </>
        <uikit-behavior-media selector="#emblemLoop" playing="">
        </>
        <uikit-behavior-media selector="#rewardFadeSmoke" playing="">
        </>
        <uikit-transition next-state="levelupRecallReward">
          <uikit-condition-parameter name="current-step" value="RecallRewardStep">
          </>
        </>
      </>
      <uikit-state name="levelupRecallReward">
        <uikit-behavior-media selector="#emblemIntro" unloading="">
        </>
        <uikit-behavior-media selector="#rewardFadeSmoke" unloading="">
        </>
        <uikit-behavior-media selector="#emblemLoop" playing="">
        </>
        <uikit-behavior-media selector="#recallFadeSmoke" playing="">
        </>
      </>
      <uikit-state name="unlockFadeIn">
        <uikit-behavior-media selector="#emblemIntro" paused="">
        </>
        <uikit-transition next-state="unlockIntro">
          <uikit-condition-delay duration="800">
          </>
        </>
        <uikit-transition next-state="unlockReward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="unlockIntro">
        <uikit-behavior-media selector="#emblemIntro" playing="">
        </>
        <uikit-behavior-media selector="#emblemLoop" preloading="">
        </>
        <uikit-transition next-state="unlockLoop">
          <uikit-condition-parameter name="has-loop" value="true">
          </>
          <uikit-condition-media selector="#emblemIntro" ended="" non-media-duration="300ms">
          </>
        </>
        <uikit-transition next-state="unlockReward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="unlockLoop">
        <uikit-behavior-media selector="#emblemIntro" unloading="">
        </>
        <uikit-behavior-media selector="#emblemLoop" playing="">
        </>
        <uikit-transition next-state="unlockReward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="unlockReward">
        {{#if hasEmblemLoop}}
          <uikit-behavior-media selector="#emblemIntro" unloading="">
          </>
          <uikit-behavior-media selector="#emblemLoop" playing="">
          </>
        {{/if}}
        <uikit-behavior-media selector="#rewardFadeSmoke" playing="">
        </>
      </>
      <uikit-state name="checkpoint1FadeIn">
        <uikit-behavior-media selector="#emblemLoop" paused="">
        </>
        <uikit-behavior-media selector="#frame" playing="">
        </>
        <uikit-behavior-media selector="#checkpoint1Intro" paused="">
        </>
        <uikit-transition next-state="checkpoint1Intro">
          <uikit-condition-delay duration="800">
          </>
        </>
        <uikit-transition next-state="checkpoint1Reward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="checkpoint1Intro">
        <uikit-behavior-media selector="#emblemLoop" playing="">
        </>
        <uikit-behavior-media selector="#frame" playing="">
        </>
        <uikit-behavior-media selector="#checkpoint1Intro" playing="">
        </>
        <uikit-behavior-media selector="#checkpoint1Loop" preloading="">
        </>
        <uikit-transition next-state="checkpoint1Loop">
          <uikit-condition-parameter name="has-loop" value="true">
          </>
          <uikit-condition-media selector="#checkpoint1Intro" ended="" non-media-duration="300ms">
          </>
        </>
        <uikit-transition next-state="checkpoint1Reward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="checkpoint1Loop">
        <uikit-behavior-media selector="#checkpoint1Intro" unloading="">
        </>
        <uikit-behavior-media selector="#checkpoint1Loop" playing="">
        </>
        <uikit-transition next-state="checkpoint1Reward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="checkpoint1Reward">
        <uikit-behavior-media selector="#checkpoint1Intro" unloading="">
        </>
        <uikit-behavior-media selector="#checkpoint1Loop" playing="">
        </>
        <uikit-behavior-media selector="#rewardFadeSmoke" playing="">
        </>
      </>
      <uikit-state name="checkpoint2FadeIn">
        <uikit-behavior-media selector="#emblemLoop" paused="">
        </>
        <uikit-behavior-media selector="#frame" playing="">
        </>
        <uikit-behavior-media selector="#checkpoint1Intro" paused="">
        </>
        <uikit-behavior-media selector="#checkpoint2Intro" paused="">
        </>
        <uikit-transition next-state="checkpoint2Intro">
          <uikit-condition-delay duration="800">
          </>
        </>
        <uikit-transition next-state="checkpoint2Reward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="checkpoint2Intro">
        <uikit-behavior-media selector="#emblemLoop" playing="">
        </>
        <uikit-behavior-media selector="#frame" playing="">
        </>
        <uikit-behavior-media selector="#checkpoint1Loop" playing="">
        </>
        <uikit-behavior-media selector="#checkpoint2Intro" playing="">
        </>
        <uikit-behavior-media selector="#checkpoint2Loop" preloading="">
        </>
        <uikit-transition next-state="checkpoint2Loop">
          <uikit-condition-parameter name="has-loop" value="true">
          </>
          <uikit-condition-media selector="#checkpoint2Intro" ended="" non-media-duration="300ms">
          </>
        </>
        <uikit-transition next-state="checkpoint2Reward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="checkpoint2Loop">
        <uikit-behavior-media selector="#checkpoint2Intro" unloading="">
        </>
        <uikit-behavior-media selector="#checkpoint2Loop" playing="">
        </>
        <uikit-transition next-state="checkpoint2Reward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="checkpoint2Reward">
        <uikit-behavior-media selector="#checkpoint2Intro" unloading="">
        </>
        <uikit-behavior-media selector="#checkpoint2Loop" playing="">
        </>
        <uikit-behavior-media selector="#rewardFadeSmoke" playing="">
        </>
      </>
      <uikit-state name="checkpoint3FadeIn">
        <uikit-behavior-media selector="#emblemLoop" paused="">
        </>
        <uikit-behavior-media selector="#frame" playing="">
        </>
        <uikit-behavior-media selector="#checkpoint1Intro" paused="">
        </>
        <uikit-behavior-media selector="#checkpoint2Intro" paused="">
        </>
        <uikit-behavior-media selector="#checkpoint3Intro" paused="">
        </>
        <uikit-transition next-state="checkpoint3Intro">
          <uikit-condition-delay duration="800">
          </>
        </>
        <uikit-transition next-state="checkpoint3Reward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="checkpoint3Intro">
        <uikit-behavior-media selector="#emblemLoop" playing="">
        </>
        <uikit-behavior-media selector="#frame" playing="">
        </>
        <uikit-behavior-media selector="#checkpoint1Loop" playing="">
        </>
        <uikit-behavior-media selector="#checkpoint2Loop" playing="">
        </>
        <uikit-behavior-media selector="#checkpoint3Intro" playing="">
        </>
        <uikit-behavior-media selector="#checkpoint3Loop" preloading="">
        </>
        <uikit-transition next-state="checkpoint3Loop">
          <uikit-condition-parameter name="has-loop" value="true">
          </>
          <uikit-condition-media selector="#checkpoint3Intro" ended="" non-media-duration="300ms">
          </>
        </>
        <uikit-transition next-state="checkpoint3Reward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="checkpoint3Loop">
        <uikit-behavior-media selector="#checkpoint3Intro" unloading="">
        </>
        <uikit-behavior-media selector="#checkpoint3Loop" playing="">
        </>
        <uikit-transition next-state="checkpoint3Reward">
          <uikit-condition-parameter name="current-step" value="RewardStep">
          </>
        </>
      </>
      <uikit-state name="checkpoint3Reward">
        <uikit-behavior-media selector="#checkpoint3Intro" unloading="">
        </>
        <uikit-behavior-media selector="#checkpoint3Loop" playing="">
        </>
        <uikit-behavior-media selector="#rewardFadeSmoke" playing="">
        </>
      </>
      <uikit-state name="showReward">
        <uikit-behavior-media selector="#reward" playing="">
        </>
      </>
    </>
    <user-experience-perf-switch id="emblemIntro" visible-state="levelupFadeIn,levelupIntro,unlockFadeIn,unlockIntro{{unless hasEmblemLoop ",unlockFade" ""}}" default-visibility="hidden">
      <uikit-video class="honor-video emblem {{if isFadeOutMographState "fade-out" ""}} {{emblemLevel}}" src="{{emblemIntroPath}}" perf-flags="largeAreaAnimationsEnabled">
      </>
    </>
    <user-experience-perf-switch id="emblemLoop" visible-state="levelupLoop,levelupReward,unlockLoop,unlockReward,checkpoint1FadeIn,checkpoint1Intro,checkpoint1Loop,checkpoint1Reward,checkpoint2FadeIn,checkpoint2Intro,checkpoint2Loop,checkpoint2Reward,checkpoint3FadeIn,checkpoint3Intro,checkpoint3Loop,checkpoint3Reward" default-visibility="hidden">
      <uikit-video class="honor-video emblemLoop emblem {{if isFadeOutMographState "fade-out" ""}} {{emblemLevel}}" src="{{emblemLoopPath}}" loop="" perf-flags="largeAreaAnimationsEnabled">
      </>
      <img class="low-spec-emblem low-spec {{if isFadeOutMographState "fade-out" ""}} {{emblemLevel}}" src="{{emblemLowSpecPath}}">
      </>
    </>
    {{#if hasEmbellishment}}
      <user-experience-perf-switch id="embellishment" visible-state="levelupFadeIn,levelupIntro,levelupLoop,levelupReward" default-visibility="hidden">
        <div class="embellishment-container {{emblemLevel}}">
          <img class="embellishment {{if isFadeOutMographState "fade-out" ""}} {{if isLowSpec "low-spec" "fade-in"}}" src="{{embellishmentPath}}">
          </>
        </>
      </>
    {{/if}}
    {{#if hasEmblemText}}
      <user-experience-perf-switch id="emblemText" visible-state="levelupIntro,levelupLoop,levelupReward" default-visibility="hidden">
        <div class="emblem-text {{if isFadeOutMographState "fade-out" ""}} {{if isLowSpec "low-spec" "fade-in"}}">
          <div class="header">
            {{emblemHeader}}
          </>
          <div class="body">
            {{emblemBody}}
          </>
        </>
      </>
    {{/if}}
    {{#if hasCheckpointOutro}}
      <user-experience-perf-switch id="checkpointOutro" visible-state="levelupFadeIn,levelupIntro" default-visibility="hidden">
        <uikit-video class="honor-video checkpoint {{if isFadeOutMographState "fade-out" ""}}" src="{{checkpointOutroPath}}" perf-flags="largeAreaAnimationsEnabled">
        </>
      </>
    {{/if}}
    {{#if hasFrame}}
      <user-experience-perf-switch id="frame" visible-state="checkpoint1FadeIn,checkpoint1Intro,checkpoint1Loop,checkpoint1Reward,checkpoint2FadeIn,checkpoint2Intro,checkpoint2Loop,checkpoint2Reward,checkpoint3FadeIn,checkpoint3Intro,checkpoint3Loop,checkpoint3Reward" default-visibility="hidden">
        <div class="frame-container {{if isFadeOutMographState "fade-out" ""}}">
          <img class="frame" src="{{framePath}}">
          </>
        </>
      </>
    {{/if}}
    {{#if hasCheckpoint1}}
      <user-experience-perf-switch id="checkpoint1Intro" visible-state="checkpoint1FadeIn,checkpoint1Intro" default-visibility="hidden">
        <uikit-video class="honor-video checkpoint {{if isFadeOutMographState "fade-out" ""}}" src="{{checkpoint1IntroPath}}" perf-flags="largeAreaAnimationsEnabled">
        </>
      </>
      <user-experience-perf-switch id="checkpoint1Loop" visible-state="checkpoint1Loop,checkpoint1Reward,checkpoint2FadeIn,checkpoint2Intro,checkpoint2Loop,checkpoint2Reward,checkpoint3FadeIn,checkpoint3Intro,checkpoint3Loop,checkpoint3Reward" default-visibility="hidden">
        <uikit-video class="honor-video checkpoint {{if isFadeOutMographState "fade-out" ""}}" src="{{checkpoint1LoopPath}}" loop="" perf-flags="largeAreaAnimationsEnabled">
        </>
        <img class="low-spec-checkpoint low-spec {{if isFadeOutMographState "fade-out" ""}} {{emblemLevel}}" src="{{checkpoint1LowSpecPath}}">
        </>
      </>
    {{/if}}
    {{#if hasCheckpoint2}}
      <user-experience-perf-switch id="checkpoint2Intro" visible-state="checkpoint2FadeIn,checkpoint2Intro" default-visibility="hidden">
        <uikit-video class="honor-video checkpoint {{if isFadeOutMographState "fade-out" ""}}" src="{{checkpoint2IntroPath}}" perf-flags="largeAreaAnimationsEnabled">
        </>
      </>
      <user-experience-perf-switch id="checkpoint2Loop" visible-state="checkpoint2Loop,checkpoint2Reward,checkpoint3FadeIn,checkpoint3Intro,checkpoint3Loop,checkpoint3Reward" default-visibility="hidden">
        <uikit-video class="honor-video checkpoint {{if isFadeOutMographState "fade-out" ""}}" src="{{checkpoint2LoopPath}}" loop="" perf-flags="largeAreaAnimationsEnabled">
        </>
        <img class="low-spec-checkpoint low-spec {{if isFadeOutMographState "fade-out" ""}} {{emblemLevel}}" src="{{checkpoint2LowSpecPath}}">
        </>
      </>
    {{/if}}
    {{#if hasCheckpoint3}}
      <user-experience-perf-switch id="checkpoint3Intro" visible-state="checkpoint3FadeIn,checkpoint3Intro" default-visibility="hidden">
        <uikit-video class="honor-video checkpoint {{if isFadeOutMographState "fade-out" ""}}" src="{{checkpoint3IntroPath}}" perf-flags="largeAreaAnimationsEnabled">
        </>
      </>
      <user-experience-perf-switch id="checkpoint3Loop" visible-state="checkpoint3Loop,checkpoint3Reward" default-visibility="hidden">
        <uikit-video class="honor-video checkpoint {{if isFadeOutMographState "fade-out" ""}}" src="{{checkpoint3LoopPath}}" loop="" perf-flags="largeAreaAnimationsEnabled">
        </>
        <img class="low-spec-checkpoint low-spec {{if isFadeOutMographState "fade-out" ""}} {{emblemLevel}}" src="{{checkpoint3LowSpecPath}}">
        </>
      </>
    {{/if}}
    {{#if hasLowSpecFrame}}
      <user-experience-perf-switch id="frame" visible-state="checkpoint1FadeIn,checkpoint1Intro,checkpoint1Loop,checkpoint1Reward,checkpoint2FadeIn,checkpoint2Intro,checkpoint2Loop,checkpoint2Reward,checkpoint3FadeIn,checkpoint3Intro,checkpoint3Loop,checkpoint3Reward" default-visibility="hidden">
        <div class="frame-container low-spec {{if isFadeOutMographState "fade-out" ""}}">
          <img class="frame" src="{{framePath}}">
          </>
        </>
      </>
    {{/if}}
    {{#if hasReward}}
      <user-experience-perf-switch id="reward" visible-state="levelupReward,levelupRecallReward,unlockReward,checkpoint1Reward,checkpoint2Reward,checkpoint3Reward,showReward" default-visibility="hidden">
        <div class="reward-container {{if isLowSpec "low-spec" ""}} {{if isRewardOnlyType "" (if isRecallRewardFadeInState "fade-out" "fade-in"}}">
          <img class="reward {{if hasLocalRewardPath "large" ""}} {{if isKeyFrag "small" ""}}" src="{{rewardPath}}">
          </>
          <div class="header {{vignetteSizeClass}}">
            {{rewardHeader}}
          </>
          <div class="text {{vignetteSizeClass}}">
            {{rewardBody}}
          </>
        </>
      </>
      <user-experience-perf-switch id="rewardFadeSmoke" visible-state="levelupReward,unlockReward,checkpoint1Reward,checkpoint2Reward,checkpoint3Reward,showReward" default-visibility="hidden">
        <uikit-video class="honor-video outro-smoke {{vignetteSizeClass}} {{emblemLevel}}" src="{{rewardTransitionPath}}" perf-flags="largeAreaAnimationsEnabled">
        </>
      </>
      <user-experience-perf-switch id="reward" visible-state="levelupRecallReward" default-visibility="hidden">
        <div class="reward-container {{if isLowSpec "low-spec" ""}} {{if isRewardOnlyType "" "fade-in"}}">
          <img class="recallReward" src="{{recallRewardPath}}">
          </>
          <div class="header {{vignetteSizeClass}}">
            {{recallRewardHeader}}
          </>
          <div class="text {{vignetteSizeClass}}">
            {{recallRewardBody}}
          </>
        </>
      </>
      <user-experience-perf-switch id="recallFadeSmoke" visible-state="levelupRecallReward" default-visibility="hidden">
        <uikit-video class="honor-video outro-smoke {{vignetteSizeClass}} {{emblemLevel}}" src="{{rewardTransitionPath}}" perf-flags="largeAreaAnimationsEnabled">
        </>
      </>
    {{/if}}
  </>
</>
