{{#if isHonorSkinRewardLevel}}
  <div class="honor-skin-reward-container {{if isHonorSkinShowing "is-visible" "is-hidden"}}">
    <img class="honor-skin-reward" src={{skinRewardPath}}>
    </>
    <div class="honor-skin-reward-title">
      {{tra.three_honors_malzahar_skin_name}}
    </>
    <div class="honor-skin-reward-subtitle">
      {{tra.mission_reward_title_CHAMPION_SKIN}}
    </>
    <div class="honor-season-reward-skin-text">
      {{tra.honor_celebration_season_reward_skin_text}}
    </>
  </>
{{/if}}
<div class="honor-season-reward-container {{if shouldHideHonorCapsuleReward "is-hidden" "is-visible"}}">
  <img class="honor-season-reward" src="{{rewardPath}}">
  </>
  <div class="honor-season-reward-header">
    {{rewardHeader}}
  </>
  <div class="honor-season-reward-body">
    {{rewardBody}}
  </>
</>
