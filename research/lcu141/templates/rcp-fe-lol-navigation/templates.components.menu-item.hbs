{{#if shouldShowCallToActionGlow}}
  <div class="navigation-cta-wrapper navigation-glow-cta">
    {{particle-glow-overlay}}
  </>
{{/if}}
{{#if shouldDisplayIcon}}
  <div class="menu-item-icon-wrapper">
    <div class="menu-item-glow">
    </>
    <div class="menu-item-icon" style="-webkit-mask-image: url({{item.iconPath}})">
    </>
    {{#if showAttentionTooltip}}
      <div class="menu-item-attention-tooltip" onclick={{action this "attentionTooltipRead"}}>
        <div class="menu-item-attention-tooltip-content">
          <div class="menu-item-attention-tooltip-content-decoration">
          </>
          <div class="menu-item-attention-tooltip-icon">
            <img src="{{attentionTooltip.iconUrl}}" alt="Nav item attention tooltip icon">
            </>
          </>
          <div class="menu-item-attention-tooltip-text">
            <div class="menu-item-attention-tooltip-text-title">
              {{attentionTooltip.title}}
            </>
            <div class="menu-item-attention-tooltip-text-msg">
              {{attentionTooltip.description}}
            </>
          </>
        </>
      </>
    {{/if}}
  </>
  {{#if shouldDisplayTextBelowIcons}}
    <div class="menu-item-small-text">
      {{displayName}}
    </>
  {{/if}}
{{else}}
  {{displayName}}
{{/if}}
{{#if shouldShowCallToActionPip}}
  <div class="navigation-cta-wrapper navigation-pip-cta">
    {{call-to-action-pip}}
  </>
{{/if}}
