<div class="mission-tray-header">
  <span class="mission-tray-title">
    {{tra.mission_tracker_title}}
    /
    {{selectedSeries.displayTitle}}
  </>
</>
<div class="missions-content">
  <div class="mission-sidebar">
    {{mission-sidebar series=trackerSeries setCurrentSeriesName=(action this "setCurrentSeriesName") missionsService=missionsService selectedSeriesIndex=selectedSeriesIndex sortedMissions=sortedMissions}}
  </>
  <div class="mission-tray {{unless selectedSeries.hasIncompleteTrackerMissionsOrSeries "empty"}}">
    {{mission-tray selectedSeries=selectedSeries series=seriesByGroup.all_missions missionsService=missionsService isVisible=isVisible missions=sortedMissions}}
  </>
</>
