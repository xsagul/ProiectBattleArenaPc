<div>
  <h4 class="heading">
    {{tra.email_verification_change_email_heading}}
  </>
  <p class="email">
    {{emailVerification.email}}
  </>
  <p class="subheading">
    {{tra.email_verification_change_email_subheading}}
    <a {{action this "verifyEmail"}}>
      {{tra.email_verification_change_email_existing}}
    </>
  </>
  <p class="body">
    <div class="fieldset new-email">
      <label>
        {{tra.email_verification_change_email_new_email}}
      </>
      <lol-uikit-flat-input>
        {{input type="email" value=newEmail focus-in="fieldFocused"}}
      </>
    </>
    <div class="fieldset reenter-email">
      <label>
        {{tra.email_verification_change_email_reenter_email}}
      </>
      <lol-uikit-flat-input>
        {{input type="email" value=repeatedEmail focus-in="fieldFocused"}}
      </>
    </>
    <div class="fieldset password">
      <label>
        {{tra.email_verification_change_email_password}}
      </>
      <lol-uikit-flat-input>
        {{input type="password" value=password focus-in="fieldFocused"}}
      </>
    </>
  </>
</>
