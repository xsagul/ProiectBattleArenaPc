{{#if isRPTopUpEnabled}}
  <div class="currency-rp-container-top-up-enabled">
    <div class="currency-rp-top-up-enabled" onmouseenter={{action this "showTooltip"}} onmouseleave={{action this "unassignToolTip"}}>
      {{formattedRp}}
    </>
    <button onclick={{action this "openPaymentsModal"}} disabled={{rpModalIsLoading}} class="currency-rp-top-up">
    </>
  </>
  <div class="currency-be" onmouseenter={{action this "showTooltip"}} onmouseleave={{action this "unassignToolTip"}}>
    {{blue-essence-currency amount=rawIp displayedAmount=formattedIp}}
  </>
{{else}}
  <div class="currency-rp">
    {{formattedRp}}
  </>
  <div class="currency-be">
    {{blue-essence-currency amount=rawIp displayedAmount=formattedIp}}
  </>
{{/if}}
