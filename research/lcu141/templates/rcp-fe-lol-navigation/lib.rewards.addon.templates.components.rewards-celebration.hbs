{{#if isIntroStep}}
  {{#if isAnimationsEnabled}}
    <div id="animations">
      <video src={{media.introAnimation}} class="celebration animated visible" id="introVideo">
      </>
      <video src={{media.loopAnimation}} class="celebration animated hidden" id="loopVideo">
      </>
    </>
  {{else}}
    <div>
      <img src="{{media.introLowSpecImage}}" class="celebration animated" id="introImage">
      </>
    </>
  {{/if}}
{{else}}
  <div class="rewards-wrapper hidden" id="rewards-wrapper">
    {{rewards-celebration-grant reward=reward index=index length=rewards.length}}
  </>
{{/if}}
{{#if isAnimationsEnabled}}
  <div>
    <video src={{media.transitionAnimation}} class="celebration hidden" id="transitionVideo">
    </>
  </>
{{/if}}
