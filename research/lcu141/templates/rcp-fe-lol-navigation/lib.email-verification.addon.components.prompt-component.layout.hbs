<div>
  <h4 class="heading">
    {{sanitize tra.email_verification_prompt_heading}}
  </>
  <p class="email">
    {{emailVerification.email}}
  </>
  <p class="subheading">
    {{tra.email_verification_prompt_subheading}}
    <a {{action this "changeEmail"}}>
      {{tra.email_verification_prompt_change_btn}}
    </>
  </>
  <p class="spaced heading">
    {{tra.email_verification_prompt_body_heading}}
  </>
  <p class="body">
    {{tra.email_verification_prompt_body}}
  </>
  {{#if isModalNotOptional}}
    <a class="exit" {{action this "quit"}}>
      {{tra.email_verification_quit}}
    </>
  {{/if}}
</>
