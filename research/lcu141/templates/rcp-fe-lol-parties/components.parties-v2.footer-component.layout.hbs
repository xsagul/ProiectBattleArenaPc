<div class="left-container">
  <div class="chat-container">
    <lol-social-chat-room type="lobby" disabled-when-connecting="">
    </>
  </>
</>
<div class="center-container">
  <div class="close-button-container">
    <div class="close-button">
      {{generic-button onClick=(action this "closeButton") baseImgPath="/fe/lol-parties/button-x.png" overImgPath="/fe/lol-parties/button-x-over.png" downImgPath="/fe/lol-parties/button-x-down.png" onClickSound=buttonSounds.closeClick onHoverSound=buttonSounds.closeHover}}
    </>
  </>
  <div class="find-match-button-container">
    {{#unless animationsEnabled}}
      {{generic-button onClick=(action this "confirmButton") baseImgPath="/fe/lol-parties/button-find-match.png" overImgPath="/fe/lol-parties/button-find-match-over.png" downImgPath="/fe/lol-parties/button-find-match-down.png" disabledImgPath="/fe/lol-parties/button-find-match-disabled.png" upText=confirmButtonText overText=confirmButtonText downText=confirmButtonText disabledText=confirmButtonText onClickSound=buttonSounds.confirmClick onHoverSound=buttonSounds.confirmHover disabledStyle="color: grey" isEnabled=confirmButtonEnabled}}
    {{else}}
      {{animated-find-match-button confirmButton="confirmButton" baseImgPath="/fe/lol-static-assets/images/buttons/find_match_default.png" overImgPath="/fe/lol-static-assets/images/buttons/find_match_hover.png" downImgPath="/fe/lol-static-assets/images/buttons/find_match_active.png" disabledImgPath="/fe/lol-parties/button-find-match-disabled.png" buttonText=confirmButtonText onClickSound=buttonSounds.confirmClick onHoverSound=buttonSounds.confirmHover disabledStyle="color: grey" clickedStyle="color: #005A82" isEnabled=confirmButtonEnabled}}
    {{/unless}}
    <div class="left-wing">
    </>
    <div class="right-wing">
    </>
    {{#if confirmButtonShowTooltip}}
      {{#uikit-tooltip tooltipPosition="top" type="system"}}
        <lol-uikit-content-block type="tooltip-system">
          <p>
            {{confirmButtonTooltipText}}
          </>
        </>
      {{/uikit-tooltip}}
    {{/if}}
  </>
  <div class="role-selectors-container">
    {{#if showPositionSelector}}
      {{v2-position-selector primaryPosition=primaryPosition secondaryPosition=secondaryPosition shouldHideSecondaryPosition=shouldHideSecondaryPosition isInQueue=isInQueue currentPartyIsFull=currentPartyIsFull openOverlay=(action this "openOverlay"}}
    {{/if}}
  </>
</>
<div class="right-container">
  <div class="invite-info-panel-container">
    {{v2-invite-info-panel currentPlayerCanInvite=currentPlayerCanInvite}}
  </>
</>
{{v2-footer-notifications readyWarning=readyWarning readyWarningTooltip=readyWarningTooltip positionError=positionError}}
{{matchmaking-errors _isTransitioningState=_isTransitioningState}}
