{{#if isCustomGame}}
  <div class="parties-header-container custom-header-container" data-parties-selected-category="{{selected.category}}" data-parties-selected-queue-id="{{selected.queueId}}">
    <div class="lobby-header-wrapper custom-header-wrapper">
      <div class="lobby-header-map-icon {{mapBackgroundClass}}">
      </>
      <div class="lobby-header-right">
        <div class="lobby-header-details">
          <span class="lobby-header-detail uppercase">
            {{customGameName}}
          </>
        </>
        <div class="lobby-header-game-type-details">
          <span class="lobby-header-game-type-detail lobby-header-custom-map-name">
            {{mapName}}
          </>
          {{#unless isTFT}}
            <span class="lobby-header-game-type-detail">
              {{teamSize}}
            </>
          {{/unless}}
          <span class="lobby-header-game-type-detail">
            {{customMutatorName}}
          </>
        </>
      </>
    </>
  </>
{{else}}
  <div class="parties-header-container" data-parties-selected-category="{{selected.category}}" data-parties-selected-queue-id="{{selected.queueId}}">
    <div class="lobby-header-wrapper">
      <div class="lobby-header-map-icon {{mapBackgroundClass}}">
      </>
      <div class="lobby-header-right-regalia">
        <div class="lobby-header-details-container-regalia">
          <div class="lobby-header-detail-regalia">
            {{queueName}}
          </>
          {{#unless pickTypeNameHidden}}
            <div class="lobby-header-separator">
            </>
            <div class="lobby-header-detail-regalia">
              {{pickTypeName}}
            </>
          {{/unless}}
        </>
        <div class="lobby-header-details-container-regalia">
          {{#if showMapNameAndTeamSize}}
            <div class="lobby-header-separator">
            </>
            <div class="lobby-header-sub-detail-regalia">
              {{mapName}}
            </>
            <div class="lobby-header-sub-detail-regalia small-spacing">
              {{teamSize}}
            </>
          {{/if}}
          {{#if hasGameModeTutorial}}
            <lol-uikit-info-icon class="show-tutorial-button lobby-header-interactable" onclick={{action this "showGameModeTutorial"}}>
            </>
          {{/if}}
          {{#if showPointEligibility}}
            <div class="lobby-header-eligibility lobby-header-interactable">
              {{point-eligibility selected=selected isCustomGame=false}}
            </>
          {{/if}}
        </>
      </>
    </>
  </>
{{/if}}
