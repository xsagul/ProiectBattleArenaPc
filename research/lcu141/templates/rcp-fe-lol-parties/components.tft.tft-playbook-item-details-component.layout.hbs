<lol-uikit-scrollable class="scroller" overflow-masks="enabled" id="playbook-selection-scroller">
  <div class="divider-text">
    {{tra.tft_playbook_section1_text}}
  </>
  <div class="divider-line">
  </>
  <ul class="card-container">
    {{#each viewItem.earlyAugments as |currAugment|}}
      {{tft-playbook-card name=currAugment.name rawDescription=currAugment.description iconPath=currAugment.iconPath effectAmounts=currAugment.effectAmounts}}
    {{/each}}
  </>
  <div class="divider-text">
    {{tra.tft_playbook_section2_text}}
  </>
  <div class="divider-line">
  </>
  <ul class="card-container">
    {{#each viewItem.midAugments as |currAugment|}}
      {{tft-playbook-card name=currAugment.name rawDescription=currAugment.description iconPath=currAugment.iconPath effectAmounts=currAugment.effectAmounts}}
    {{/each}}
  </>
  <div class="divider-text">
    {{tra.tft_playbook_section3_text}}
  </>
  <div class="divider-line">
  </>
  <ul class="card-container">
    {{#each viewItem.lateAugments as |currAugment|}}
      {{tft-playbook-card name=currAugment.name rawDescription=currAugment.description iconPath=currAugment.iconPath effectAmounts=currAugment.effectAmounts}}
    {{/each}}
  </>
</>
