<lol-uikit-framed-dropdown stylablecontent="" direction="upward" disabled={{disabled}} class="quick-play-perks-page-dropdown">
  {{#each perksPages key="id" as |page|}}
    <lol-uikit-dropdown-option slot="lol-uikit-dropdown-option" selected={{eq page.id selectingPerksPage.id}} onclick={{action this "selectPerksPage" page selectingSlotIndex}}>
      {{quick-play-perks-page-dropdown-option tooltipConfig=tooltipConfig page=page}}
    </>
  {{/each}}
</>
{{#if selectingPerksPage}}
  {{#uikit-tooltip tooltipConfig=tooltipConfig}}
    {{perk-page-tooltip page=selectingPerksPage}}
  {{/uikit-tooltip}}
{{/if}}
