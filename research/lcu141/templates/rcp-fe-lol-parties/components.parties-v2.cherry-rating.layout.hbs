{{#if isCherryRatingShown}}
  <div class="cherry-rating-container">
    <img class="cherry-rating-icon" src={{cherryRatedIcon}}>
    </>
    <div class="cherry-rating-text">
      {{ratedRating}}
    </>
    {{#if tooltipEnabled}}
      {{#uikit-tooltip type="system" tooltipPosition="right"}}
        <div class="cherry-rating-tooltip-container">
          <img class="cherry-rating-medallion" src={{cherryRatedMedallion}}>
          </>
          <div class="rating-text-container">
            <div class="rating-text-inner-container">
              <div class="rated-rating-tier">
                {{cherryRatedTierNameLoc}}
              </>
              <div class="rated-rating-points">
                {{cherryTooltipRatedRatingText}}
              </>
            </>
          </>
        </>
      {{/uikit-tooltip}}
    {{/if}}
  </>
{{/if}}
