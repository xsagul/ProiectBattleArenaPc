<div class={{if isDisabled "tft-playbook-item-container disabled" "tft-playbook-item-container"}} onclick={{action this "select"}} onmouseover={{action this "hover"}} selected={{isSelected}}>
  <img src="{{item.iconPath}}" class="image-container">
  </>
  <div class="image-background">
  </>
  <div class="name-container">
    {{name}}
  </>
  {{#if isEquipped}}
    <img src={{equippedIcon}} class="equipped-icon">
    </>
  {{/if}}
</>
