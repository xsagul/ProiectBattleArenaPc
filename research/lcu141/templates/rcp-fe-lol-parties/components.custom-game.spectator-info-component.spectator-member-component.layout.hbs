<div class="spectator-info-container">
  <span class="spectator-info-name">
    {{player-name format="tooltip" gameName=spectator.gameName tagLine=spectator.tagLine summonerName=spectator.summonerName}}
  </>
  <span>
    {{#if isLeader}}
      <div class="custom-leader-icon">
        {{#uikit-tooltip tooltipPosition="top" type="system"}}
          <lol-uikit-content-block type="tooltip-system">
            <p>
              {{tra.custom_game_is_leader}}
            </>
          </>
        {{/uikit-tooltip}}
      </>
    {{/if}}
  </>
</>
