<div class="custom-game-invite-button-container">
  {{invite-button currentPlayerCanInvite=currentPlayerCanInvite buttonsDisabled=inviteButtonDisabled currentPartyIsFull=currentPartyIsFull isCurrentPlayerPartyLeader=isCurrentPlayerPartyLeader showInviteModal="showInviteModal" isLobbyFull=isLobbyFull}}
</>
{{#lower-section currentPlayer=currentPlayer}}
  {{#unless isTFT}}
    {{point-eligibility selected=selected isCustomGame=true}}
  {{/unless}}
  {{custom-teams isTFT=isTFT}}
  {{invite-info-panel currentPlayerCanInvite=currentPlayerCanInvite isCustom=true}}
  {{#if showSpectators}}
    {{spectator-info}}
  {{/if}}
  {{parties-footer showingState=showingState selected=selected}}
  <div class="parties-chat-room-custom">
    <lol-social-chat-room type="lobby" disabled-when-connecting="">
    </>
  </>
{{/lower-section}}
