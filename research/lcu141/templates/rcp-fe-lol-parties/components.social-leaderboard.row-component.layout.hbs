<tr class="social-leaderboard-table-row" onclick={{action this "onPlayerRowClick"}}>
  <td>
    {{leaderboardPosition}}
  </>
  <td>
    <div class="social-leaderboard-cell">
      <img class="social-leaderboard-rank-image {{if isUnranked "social-leaderboard-unranked"}}" src={{rankedMiniRegaliaPath}}>
      </>
      {{rankedColumnText}}
    </>
  </>
  <td>
    <div class="social-leaderboard-cell">
      <lol-social-avatar-icon class="social-leaderboard-avatar" icon-id={{profileIconId}} availability={{playerAvailability}} show-availability="true">
        {{hovercard-component summonerId=summonerId}}
      </>
      {{player-name format="full" puuid=puuid gameName=gameName tagLine=tagLine summonerName=summonerName}}
    </>
  </>
  <td>
    {{wins}}
  </>
</>
