<div class="quick-play-champion-grid-header">
  <div class="quick-play-champion-grid-filters-container">
    {{#each championPositionFilters as |filterData|}}
      <div class="quick-play-champion-grid-filter {{if filterData.isSelected "selected"}}">
        {{clickable-icon-button widthStyleOverride="24px" heightStyleOverride="24px" selected=filterData.isSelected handleClick=(action this "handleFilterClick" filterData) iconPath=filterData.iconPath}}
        <div class="quick-play-grid-filter-selected-underline">
        </>
      </>
    {{/each}}
  </>
  <div class="quick-play-sort-and-filter-container">
    <lol-uikit-framed-dropdown class="quick-play-grid-sort-dropdown">
      {{#each sortOptions as |sort|}}
        <lol-uikit-dropdown-option slot="lol-uikit-dropdown-option" selected={{sort.selected}} onclick={{action this "sort" sort}}>
          {{sort.displayName}}
        </>
      {{/each}}
    </>
    <lol-uikit-flat-input class="quick-play-champion-selector-filter-input">
      <input type="search" maxlength="50" placeholder={{tra.quick_play_search}} oninput={{action this "handleInputChanged"}}>
      </>
    </>
  </>
</>
{{quick-play-champion-grid itemRendererComponentName="quick-play-grid-champion" items=filterAndSortedChampions handleItemClick="handleChampionClicked"}}
