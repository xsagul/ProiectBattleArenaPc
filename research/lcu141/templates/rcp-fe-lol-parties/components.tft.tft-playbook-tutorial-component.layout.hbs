<div class="playbook-tutorial-inner">
  <div class="playbook-tutorial-splash-art">
  </>
  <h4 class="playbook-tutorial-subtitle">
    {{tra.tft_playbook_tutorial_subtitle}}
  </>
  <h3 class="playbook-tutorial-title">
    {{tra.tft_playbook_tutorial_title}}
  </>
  <div class="playbook-tutorial-divider">
  </>
  <div class="playbook-tutorial-body">
    <div class="playbook-tutorial-right-col">
      <div class="playbook-tutorial-paragraph playbook-tutorial-paragraph-1">
        <div class="playbook-tutorial-paragraph-icon">
        </>
        <h4 class="playbook-tutorial-paragraph-header">
          {{tra.tft_playbook_tutorial_paragraph_header_1}}
        </>
        <p class="playbook-tutorial-paragraph-body">
          {{tra.tft_playbook_tutorial_paragraph_body_1}}
        </>
      </>
      <div class="playbook-tutorial-paragraph playbook-tutorial-paragraph-2">
        <div class="playbook-tutorial-paragraph-icon">
        </>
        <h4 class="playbook-tutorial-paragraph-header">
          {{tra.tft_playbook_tutorial_paragraph_header_2}}
        </>
        <p class="playbook-tutorial-paragraph-body">
          {{tra.tft_playbook_tutorial_paragraph_body_2}}
        </>
      </>
      <div class="playbook-tutorial-paragraph playbook-tutorial-paragraph-3">
        <div class="playbook-tutorial-paragraph-icon">
        </>
        <h4 class="playbook-tutorial-paragraph-header">
          {{tra.tft_playbook_tutorial_paragraph_header_3}}
        </>
        <p class="playbook-tutorial-paragraph-body">
          {{tra.tft_playbook_tutorial_paragraph_body_3}}
        </>
      </>
    </>
  </>
  <div class="playbook-tutorial-footer">
    <lol-uikit-flat-button-group type="dialog-frame">
      <lol-uikit-flat-button onclick={{action this "closeButtonClick"}} class="button glow" primary="true">
        {{tra.tft_playbook_tutorial_close}}
      </>
    </>
  </>
</>
