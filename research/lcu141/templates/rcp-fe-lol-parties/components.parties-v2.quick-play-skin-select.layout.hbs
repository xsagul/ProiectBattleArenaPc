{{uikit-background-switcher src=skinSplashPath}}
<lol-uikit-section-controller animation="crossfade" selected-item="showcase-view" class="section-controller">
  <lol-uikit-section section-id="showcase-view" class="showcase-section">
    <div class="background-shader">
    </>
    <div class="showcase-wrapper">
      <div class="top-part">
      </>
      <div class="bottom-part">
        <div class="skin-title">
          {{#if viewSkin.rarity.gemIcon}}
            <div class="tier-icon">
              <img src="{{viewSkin.rarity.gemIcon}}">
              </>
            </>
          {{/if}}
          <div class="skin-name">
            {{viewSkin.name}}
          </>
        </>
        <div class="quick-play-skin-carousel-visibility-wrapper">
          {{quick-play-skin-carousel selectedSkin=viewSkin selectedChroma=viewChroma selectedForm=viewForm skins=skins setSkin="setSkin"}}
        </>
      </>
    </>
  </>
  <lol-uikit-section section-id="splash-view" class="splash-view-section">
  </>
</>
{{#if viewSkin.emblems}}
  <div class="emblem-overlay">
    {{#each viewSkin.emblems as |emblem|}}
      <img src="{{emblem.emblemPath.large}}">
      </>
    {{/each}}
  </>
{{/if}}
