<div class="inner-border-1">
  <div class="inner-border-2">
    {{#if isInvited}}
      <div class="invited-spinner">
      </>
    {{else}}
      {{#if isPlaceholder}}
        {{#if partyInvitesAllowed}}
          <div class="placeholder-invite-button">
            {{#player-management-button type="invite" action="showInviteModal"}}
              <lol-uikit-content-block type="tooltip-system">
                <p>
                  {{tra.invite_tooltip}}
                </>
              </>
            {{/player-management-button}}
          </>
        {{/if}}
      {{else}}
        {{player-party-controls member=member isLeader=isLeader isMe=isMe queueId=selected.queueId}}
        <div class="icon-wrapper" onclick={{action this "iconClick"}}>
          <div class="icon-image" style="background-image:url({{displayedIcon}});">
          </>
          <div onmouseover={{action this "handleMouseOver"}} class="icon-frame {{if showIconToggle "has-toggle" ""}} {{if shouldShowSummonerIcon "" "no-level"}}">
            {{#if hasSummonerIcon}}
              {{#if isMe}}
                {{#uikit-tooltip tooltipPosition="bottom"}}
                  <lol-uikit-content-block type="tooltip-system">
                    <p>
                      {{tra.tft_icon_tooltip}}
                    </>
                  </>
                {{/uikit-tooltip}}
              {{/if}}
            {{/if}}
          </>
          {{#if shouldShowSummonerLevel}}
            <div class="level-label">
              {{summonerLevel}}
            </>
          {{/if}}
        </>
        <div class="current-rank">
          {{#if showRanked}}
            <div class="rank-wrapper">
              <div class="rank-icon" style="background-image: url({{rankedIcon}});">
              </>
              <div class="rank-name">
                {{rankedTierAndDivisionText}}
                {{rankedLeaguePointsText}}
                {{#if showRated}}
                  <span class="rank-rated-divider">
                    /
                  </>
                {{/if}}
              </>
            </>
          {{/if}}
          {{#if showRated}}
            <div class="rank-wrapper">
              <div class="rated-tier-icon" style="background-image: url({{ratiedTierIcon}});">
              </>
              <div class="rated-rating">
                {{ratedRating}}
              </>
            </>
          {{/if}}
        </>
        {{#if showCosmetics}}
          {{tft-player-card-cosmetics isMe=isMe companionIconId=companionIconId mapSkinIconId=mapSkinIconId damageSkinIconId=damageSkinIconId isFullCard=isFullCard}}
        {{/if}}
      {{/if}}
    {{/if}}
  </>
</>
