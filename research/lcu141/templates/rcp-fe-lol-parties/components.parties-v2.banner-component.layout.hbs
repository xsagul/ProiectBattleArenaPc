{{#unless isEmpty}}
  <div class="lobby-banner-animation-container">
    <lol-uikit-lottie src="/fe/lol-parties/lottie/parties-v2/intro-banner.json" autoplay="false">
    </>
  </>
  <div class="lobby-banner {{if isLocalPlayer "local"}} {{if isEmpty "empty"}} {{if showQuickPlaySelections "quick-play"}}">
    <lol-regalia-parties-v2-element summoner-id={{member.summonerId}} puuid={{member.puuid}} queue={{queueType}} member-type={{memberType}} waiting-in-postgame={{waitingInPostgame}} animations={{animationsEnabled}} is-quick-play={{showQuickPlaySelections}}>
      <div class="lobby-banner-contents">
        <div class="banner-highlight">
        </>
        <div class="banner-spacer">
        </>
        <div class="player-identity-container">
          {{#uikit-tooltip tooltipPosition="right" type="system"}}
            {{identity-tooltip rankedData=rankedData selectedQueue=selected.queue player=member showRank=showRankTooltip challengesSummary=challengesSummary crystalImagePath=crystalImagePath lobbyChallengesEnabled=lobbyChallengesEnabled summonerRegalia=summonerRegalia}}
          {{/uikit-tooltip}}
        </>
        {{#if isLocalPlayer}}
          <div class="player-restriction-info-container">
            {{player-restriction-info}}
          </>
        {{/if}}
        {{#if isCherry}}
          {{cherry-rating rankedData=rankedData queueType=queueType tooltipEnabled=true}}
        {{/if}}
        <div class="player-name-container">
          {{#if isLeader}}
            <div class="leader-icon">
            </>
          {{/if}}
          <div class="player-name">
            {{player-name format="tooltip" puuid=member.puuid summonerName=member.summonerName}}
          </>
        </>
        <div class="player-achievements-container {{if isEmpty "hide"}}">
          {{challenge-banner-token-container puuid=puuid isLocalPlayer=isLocalPlayer chatConversationId=chatConversationId allowPresenceUpdates=allowPresenceUpdates showTitleOnly=waitingInPostgame}}
        </>
        {{#if showQuickPlaySelections}}
          <div class="quick-play-spacer">
          </>
          <div class="quick-play-selections-container">
            {{#each quickPlayViewSlots as |playerSlot index|}}
              {{#unless playerSlot.hide}}
                {{quick-play-selection-renderer isLocalPlayer=isLocalPlayer position=playerSlot.positionPreference playerSlot=playerSlot isPrimary=playerSlot.isPrimary championId=playerSlot.championId disabled=isNotLocalPlayer onClick=(action this "quickPlayPrefsSelect" index}}
              {{/unless}}
            {{/each}}
          </>
        {{else}}
          {{#if showPositionSelector}}
            <div class="position-icons-container {{if shouldHideSecondaryPosition "single-selector"}}">
              <div class="position-element secondary">
                {{v2-banner-position-icon position=secondaryPosition isPrimary=false}}
                {{#uikit-tooltip tooltipConfig=secondaryTooltipConfig}}
                  <lol-uikit-content-block class="position-tooltip" type="tooltip-system">
                    <h5 class="position-label">
                      {{tra.parties_secondary_position}}
                    </>
                    {{#if secondaryPositionText}}
                      <h5 class="position-text">
                        {{secondaryPositionText}}
                      </>
                    {{/if}}
                  </>
                {{/uikit-tooltip}}
              </>
              <div class="position-element primary">
                {{v2-banner-position-icon position=primaryPosition isPrimary=true}}
                {{#uikit-tooltip tooltipConfig=primaryTooltipConfig}}
                  <lol-uikit-content-block class="position-tooltip" type="tooltip-system">
                    <h5 class="position-label">
                      {{primaryPositionLabelText}}
                    </>
                    {{#if primaryPositionText}}
                      <h5 class="position-text">
                        {{primaryPositionText}}
                      </>
                    {{/if}}
                  </>
                {{/uikit-tooltip}}
              </>
            </>
          {{/if}}
        {{/if}}
        {{#unless isPlayerPartyControlsDisabled}}
          {{v2-player-party-controls member=member isLeader=isLeader isMe=isLocalPlayer}}
        {{/unless}}
      </>
    </>
  </>
  <div class="player-identity-animation-container {{if isLocalPlayer "local"}} {{if showQuickPlaySelections "quick-play"}} {{if isNotLocalPlayer "member"}}">
    <lol-uikit-video class="player-identity-gem-animation" fade-in="0" fade-out="0" src="{{gemAnimVideoPath}}" preload="">
    </>
  </>
{{/unless}}
