<div class="parties-game-type-card-selected-glow">
</>
<div class="icon-frame">
  {{#if animationsEnabled}}
    <div class="icon-bg icon-bg-filler {{backgroundFillerImageClass}}" style="background-image: url('{{backgroundFillerUrl}}');">
    </>
  {{/if}}
  <div class="icon-bg icon-bg-default" style="background-image: url('{{backgroundDefaultUrl}}');">
  </>
  <div class="icon-bg icon-bg-hover" style="background-image: url('{{backgroundHoverUrl}}');">
  </>
  <div class="icon-bg icon-bg-disabled" style="background-image: url('{{backgroundDisabledUrl}}');">
  </>
  {{#if animationsDisabled}}
    <div class="icon-bg icon-bg-active" style="background-image: url('{{backgroundActiveUrl}}');">
    </>
  {{else}}
    <lol-uikit-video-state-machine id="game-type-icon-state-machine" data-map-id="{{mapId}}">
      <lol-uikit-video-group>
        <lol-uikit-video-state state="active">
          <lol-uikit-video type="idle" class="icon-bg video-icon" src="{{activeVideoUrl}}" fade-in="0" fade-out="333">
          </>
        </>
        <lol-uikit-video-state state="clicked">
          <lol-uikit-video type="intro" class="icon-bg video-icon" src="{{introVideoUrl}}">
          </>
          <lol-uikit-video type="idle" class="icon-bg video-icon" src="{{activeVideoUrl}}" fade-out="333">
          </>
        </>
        <lol-uikit-video-state state="hidden" no-preserve-state="">
        </>
      </>
    </>
  {{/if}}
</>
<div class="parties-game-type-card-break {{mapSubtitleBreakClass}}">
  {{mapSubtitleText}}
</>
<div class="parties-game-type-card-name">
  {{gameTypeName}}
</>
{{videoURLObserver}}
