<div class="parties-custom-game-subcategory-select">
  {{#each subcategories as |subcategory index|}}
    {{custom-game-subcategory-card index=index animationLock=selected.animationLock subcategory=subcategory selectedSubcategoryIndex=playerInputs.subcategoryIndex selected="selectSubcategory"}}
  {{/each}}
</>
<div class="parties-custom-game-lower-half">
  <div class="parties-custom-game-text-inputs">
    <div class="parties-custom-game-name-field">
      <label for="custom-game-name">
        {{tra.custom_game_setup_name_label}}
      </>
      <lol-uikit-flat-input>
        <input type="text" name="custom-game-name" id="custom-game-name" value="{{defaultGameName}}" maxlength="30" {{action this "nameChange" on="focusOut"}} {{action this "nameKeyUp" on="keyUp"}}>
        </>
      </>
    </>
    <ul class="parties-custom-game-dropdown-fields">
      <li class="parties-custom-game-size-field">
        <label for="custom-game-size">
          {{tra.custom_game_setup_team_size_label}}
        </>
        <lol-uikit-framed-dropdown id="custom-game-size">
          {{#each teamSizeOptions as |option|}}
            {{#if option.isSelected}}
              <lol-uikit-dropdown-option slot="lol-uikit-dropdown-option" selected="" onclick={{action this "teamSizeChange" option.value}}>
                {{option.value}}
              </>
            {{else}}
              <lol-uikit-dropdown-option slot="lol-uikit-dropdown-option" onclick={{action this "teamSizeChange" option.value}}>
                {{option.value}}
              </>
            {{/if}}
          {{/each}}
        </>
      </>
      {{#if gameServerRegionOptions}}
        <li class="parties-custom-game-region-field">
          <label for="custom-game-region">
            {{tra.custom_game_setup_region_label}}
          </>
          <lol-uikit-framed-dropdown id="custom-game-region">
            {{#each gameServerRegionOptions as |option|}}
              {{#if option.isSelected}}
                <lol-uikit-dropdown-option slot="lol-uikit-dropdown-option" selected="" onclick={{action this "gameServerRegionChange" option.value}}>
                  {{option.value}}
                </>
              {{else}}
                <lol-uikit-dropdown-option slot="lol-uikit-dropdown-option" onclick={{action this "gameServerRegionChange" option.value}}>
                  {{option.value}}
                </>
              {{/if}}
            {{/each}}
          </>
        </>
      {{/if}}
    </>
    <div class="parties-custom-game-password-field">
      <label for="custom-game-password">
        {{tra.custom_game_setup_password_label}}
      </>
      <lol-uikit-flat-input>
        <input type="password" name="custom-game-password" id="custom-game-password" {{action this "passwordChange" on="change"}}>
        </>
      </>
    </>
  </>
  <div class="parties-custom-game-radio-options">
    {{#if mutatorOptions.length}}
      <div class="parties-custom-game-type-field">
        <label for="custom-game-mutator">
          {{tra.custom_game_setup_type_label}}
        </>
        <lol-uikit-radio-input id="custom-game-mutator" onclick={{action this "mutatorChanged"}}>
          {{#each mutatorOptions as |option|}}
            {{#if option.isSelected}}
              <lol-uikit-radio-input-option selected="" value="{{option.value}}">
                {{option.label}}
              </>
            {{else}}
              <lol-uikit-radio-input-option value="{{option.value}}">
                {{option.label}}
              </>
            {{/if}}
          {{/each}}
        </>
      </>
    {{/if}}
    <div class="parties-custom-game-spectator-field">
      <label for="custom-game-spectator">
        {{tra.custom_game_setup_spectator_label}}
      </>
      <lol-uikit-radio-input id="custom-game-spectator" onclick={{action this "spectatorChanged"}}>
        {{#each spectatorOptions as |option|}}
          {{#if option.isSelected}}
            <lol-uikit-radio-input-option selected="" value="{{option.value}}">
              {{option.label}}
            </>
          {{else}}
            <lol-uikit-radio-input-option value="{{option.value}}">
              {{option.label}}
            </>
          {{/if}}
        {{/each}}
      </>
    </>
  </>
</>
<div style="display: none;">
  {{nameErrorObserver}}
  {{nameErrorTooltipObserver}}
</>
