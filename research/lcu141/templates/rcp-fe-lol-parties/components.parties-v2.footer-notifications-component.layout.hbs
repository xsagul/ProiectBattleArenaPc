{{#if isQuickPlayModal}}
  {{#if showQPModalRestriction}}
    <div class="parties-restrictions-warning-error {{restrictionClass}}">
      <svg class="parties-notification-warning-icon parties-notification-warning-icon-tooltip" width="21" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M11.3889 3L18.5 15.25L17.6111 17H3.38889L2.5 15.25L9.61111 3H11.3889ZM9.61111 11.75L8.72222 7.375L10.5 6.5L12.2778 7.375L11.3889 11.75H9.61111ZM12.2778 14.375L10.5 16.125L8.72222 14.375L10.5 12.625L12.2778 14.375Z">
        </>
      </>
      {{#uikit-tooltip tooltipConfig=tooltipConfig}}
        <lol-uikit-content-block class="parties-footer-tooltip" type="tooltip-large">
          {{QPModalRestrictionText}}
        </>
      {{/uikit-tooltip}}
    </>
  {{/if}}
{{else}}
  {{#if hasQueueAvailabilityWarning}}
    <div class="parties-queue-warning-error {{restrictionClass}}">
      <svg class="parties-notification-warning-icon" width="21" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M11.3889 3L18.5 15.25L17.6111 17H3.38889L2.5 15.25L9.61111 3H11.3889ZM9.61111 11.75L8.72222 7.375L10.5 6.5L12.2778 7.375L11.3889 11.75H9.61111ZM12.2778 14.375L10.5 16.125L8.72222 14.375L10.5 12.625L12.2778 14.375Z">
        </>
      </>
      {{tra.parties_roster_invite_disabled_eligibility_disabled}}
    </>
  {{else}}
    {{#if hasLobbyRestrictions}}
      <div class="parties-restrictions-warning-error {{restrictionClass}}">
        <svg class="parties-notification-warning-icon" width="21" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M11.3889 3L18.5 15.25L17.6111 17H3.38889L2.5 15.25L9.61111 3H11.3889ZM9.61111 11.75L8.72222 7.375L10.5 6.5L12.2778 7.375L11.3889 11.75H9.61111ZM12.2778 14.375L10.5 16.125L8.72222 14.375L10.5 12.625L12.2778 14.375Z">
          </>
        </>
        {{sanitize restrictionsText}}
      </>
    {{else}}
      {{#if readyWarning}}
        <div class="parties-footer-warning parties-ready-warning">
          <svg class="parties-ready-warning-icon" width="21" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M11.3889 3L18.5 15.25L17.6111 17H3.38889L2.5 15.25L9.61111 3H11.3889ZM9.61111 11.75L8.72222 7.375L10.5 6.5L12.2778 7.375L11.3889 11.75H9.61111ZM12.2778 14.375L10.5 16.125L8.72222 14.375L10.5 12.625L12.2778 14.375Z">
            </>
          </>
          {{readyWarning}}
          {{#uikit-tooltip tooltipConfig=tooltipConfig}}
            <lol-uikit-content-block class="parties-footer-tooltip" type="tooltip-large">
              {{readyWarningTooltip}}
            </>
          {{/uikit-tooltip}}
        </>
      {{else}}
        {{#if positionError}}
          <div class="parties-footer-error {{restrictionClass}}">
            <svg class="parties-notification-warning-icon" width="21" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M11.3889 3L18.5 15.25L17.6111 17H3.38889L2.5 15.25L9.61111 3H11.3889ZM9.61111 11.75L8.72222 7.375L10.5 6.5L12.2778 7.375L11.3889 11.75H9.61111ZM12.2778 14.375L10.5 16.125L8.72222 14.375L10.5 12.625L12.2778 14.375Z">
              </>
            </>
            {{positionError}}
          </>
        {{else}}
          {{#if hasMmrStandardDeviationWarning}}
            <div class="parties-footer-warning">
              <svg class="parties-mmr-warning-icon" width="21" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M11.3889 3L18.5 15.25L17.6111 17H3.38889L2.5 15.25L9.61111 3H11.3889ZM9.61111 11.75L8.72222 7.375L10.5 6.5L12.2778 7.375L11.3889 11.75H9.61111ZM12.2778 14.375L10.5 16.125L8.72222 14.375L10.5 12.625L12.2778 14.375Z">
                </>
              </>
              {{mmrStandardDeviationWarning}}
              {{#uikit-tooltip tooltipConfig=tooltipConfig}}
                <lol-uikit-content-block class="parties-footer-tooltip" type="tooltip-large">
                  {{mmrStandardDeviationWarningTooltip}}
                </>
              {{/uikit-tooltip}}
            </>
          {{else}}
            {{#if shouldShowAutoFillStatus}}
              <div class="parties-footer-warning">
                {{#if positionWarning}}
                  {{#if shouldShowAutoFillProtection}}
                    <div class="parties-autofill-protection-icon">
                    </>
                  {{else}}
                    <svg class="parties-autofill-warning-icon" width="21" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M11.3889 3L18.5 15.25L17.6111 17H3.38889L2.5 15.25L9.61111 3H11.3889ZM9.61111 11.75L8.72222 7.375L10.5 6.5L12.2778 7.375L11.3889 11.75H9.61111ZM12.2778 14.375L10.5 16.125L8.72222 14.375L10.5 12.625L12.2778 14.375Z">
                      </>
                    </>
                  {{/if}}
                  {{positionWarning}}
                {{/if}}
                {{#uikit-tooltip tooltipConfig=tooltipConfig}}
                  <lol-uikit-content-block class="parties-footer-tooltip" type="tooltip-large">
                    {{warningTooltipText}}
                  </>
                {{/uikit-tooltip}}
              </>
            {{/if}}
          {{/if}}
        {{/if}}
      {{/if}}
    {{/if}}
  {{/if}}
{{/if}}
