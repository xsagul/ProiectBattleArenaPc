{{#if isEnabled}}
  <div class="button-container">
    <div class="button-inner-container">
      <button class="playbook-button" onclick={{action this "showPlaybook"}} onmouseover={{action this "hover"}}>
        <img src="{{selectedIcon}}" class="icon">
        </>
      </>
      {{#if shouldShowCTA}}
        <lol-uikit-flyout-frame class="playbook-tooltip-container" orientation="bottom">
          <lol-uikit-content-block type="tooltip-small">
            <h4>
              {{tra.tft_playbook_cta_title}}
            </>
            <hr>
            </>
            <p>
              {{tra.tft_playbook_cta_body}}
            </>
            <lol-uikit-flat-button onclick={{action this "hideCta"}} class="button glow">
              {{tra.tft_playbook_cta_button}}
            </>
          </>
        </>
      {{else}}
        {{#if showQueueDisabledTooltip}}
          <lol-uikit-flyout-frame dismissable="true" onclick={{action this "closeQueueDisabledTooltip"}} class="playbook-tooltip-container">
            <lol-uikit-content-block type="tooltip-small">
              <p>
                {{tra.tft_playbook_queue_disabled_body}}
              </>
            </>
          </>
        {{/if}}
      {{/if}}
    </>
  </>
{{/if}}
{{#if displayPlaybookMenu}}
  {{#uikit-modal type="DialogAlert" dismissible="true" dismissibleType="inside" onClose=(action this "closeButtonClick")}}
    {{tft-playbook-menu queueId=queueId}}
  {{/uikit-modal}}
{{/if}}
