<div class="parties-player-labels-wrapper">
  <div class="parties-player-name-container">
    {{#if isLeader}}
      <div class="parties-player-leader-icon">
      </>
    {{/if}}
    <lol-uikit-resizing-text-field class="parties-player-name" data-max-width="140">
      {{player-name format="tooltip" puuid=member.puuid summonerName=member.summonerName}}
    </>
  </>
</>
{{#if isNotMe}}
  <div class="player-party-tools">
    {{#if showPartyOwnerTools}}
      <!-- kick button is for party owners only -->
      {{#player-management-button type="kick" action="kick"}}
        <lol-uikit-content-block type="tooltip-system">
          <p>
            {{tra.kick_tooltip}}
          </>
        </>
      {{/player-management-button}}
    {{/if}}
    <!-- any party member can Add Friend -->
    {{#unless isFriended}}
      {{#player-management-button type="add-friend" action="sendFriendRequest"}}
        <lol-uikit-content-block type="tooltip-system">
          <p>
            {{tra.context_menu_friend_request}}
          </>
        </>
      {{/player-management-button}}
    {{/unless}}
    <!-- options menu button is for party owners only -->
    {{#if showPartyOwnerTools}}
      {{#player-management-button type="options" action="openCaptainMenu"}}
        <lol-uikit-content-block type="tooltip-system">
          <p>
            {{tra.captain_controls_tooltip}}
          </>
        </>
      {{/player-management-button}}
    {{/if}}
  </>
{{/if}}
<div class="lol-not-ready-loader">
  {{#if shouldShowGhostedBanner}}
    <div class="lol-not-ready-loader-segment">
    </>
    <div class="lol-not-ready-loader-segment">
    </>
    <div class="lol-not-ready-loader-segment">
    </>
  {{/if}}
</>
{{#if shouldShowRestrictions}}
  <div class="player-lobby-restrictions {{restrictionLeaderClass}}">
    {{#uikit-tooltip tooltipConfig=tooltipConfig}}
      <lol-uikit-content-block type="tooltip-system">
        {{#each restrictionToolTipText as |restriction|}}
          <p>
            {{restriction}}
          </>
        {{/each}}
      </>
    {{/uikit-tooltip}}
  </>
{{/if}}
{{#if showPositionSelector}}
  {{player-positions member=member isMe=isMe currentTeamIsFull=currentTeamIsFull animationsEnabled=animationsEnabled positionSelectorEmberApp=positionSelectorEmberApp positionSelectorData=positionSelectorData cachePositionSelector=(action this cachePositionSelector}}
{{/if}}
