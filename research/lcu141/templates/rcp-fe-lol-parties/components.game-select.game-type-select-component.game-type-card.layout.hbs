<div class="parties-game-type-upper-half" {{action this "selectGameType"}}>
  {{game-type-icon mapId=mapId currentlySelected=isCurrentlySelected gameTypeName=gameTypeName mapSubtitle=mapVersus isTraining=isTraining isDisabledFeaturedGameMode=isDisabledFeaturedGameMode gameMode=gameMode assetMutator=assetMutator}}
  {{#if shouldShowEligibilityWarning}}
    <div class="parties-eligibility-error">
      {{#uikit-tooltip tooltipConfig=tooltipConfig}}
        <lol-uikit-content-block class="game-type-category-disabled" type="tooltip-system">
          <ul>
            {{#each disabledReasons as |reason|}}
              <li>
                {{sanitize reason}}
              </>
            {{/each}}
          </>
        </>
      {{/uikit-tooltip}}
    </>
  {{/if}}
</>
<div class="parties-game-type-lower-half">
  <div class="parties-game-type-card-intro">
    {{gameTypeDescription}}
  </>
  {{#if shouldDisplayGameServerRegionOptions}}
    <label for="custom-game-region">
      {{tra.custom_game_setup_region_label}}
    </>
    <lol-uikit-framed-dropdown id="custom-game-region">
      {{#each gameServerRegionOptions as |option|}}
        {{#if option.isSelected}}
          <lol-uikit-dropdown-option slot="lol-uikit-dropdown-option" selected="" onclick={{action this "gameServerRegionChange" option.value}}>
            {{option.value}}
          </>
        {{else}}
          <lol-uikit-dropdown-option slot="lol-uikit-dropdown-option" onclick={{action this "gameServerRegionChange" option.value}}>
            {{option.value}}
          </>
        {{/if}}
      {{/each}}
    </>
  {{/if}}
  {{#if shouldDisplayQueueSelect}}
    <hr>
    </>
    <lol-uikit-scrollable class="parties-game-type-card-categories">
      {{#each gameTypeQueues as |queueId|}}
        {{game-type-category-select queues=queues queueId=queueId selectedQueueId=selectedQueueId selectCategory="selectCategory"}}
      {{/each}}
    </>
  {{/if}}
</>
{{computeDisabledReasons}}
