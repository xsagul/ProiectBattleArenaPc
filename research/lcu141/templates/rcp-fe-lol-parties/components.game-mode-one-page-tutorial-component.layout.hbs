<div class="one-page-tutorial-wrapper" style="background-image: url({{tutorialBg}})">
  <div class="header-group">
    {{#if iconV2}}
      <div class="tutorial-header-icon" style="background-image: url({{iconV2}})">
      </>
    {{/if}}
    <div class="header">
      {{title}}
    </>
    <div class="sub-header">
      {{subheader}}
    </>
  </>
  <div class="cards">
    {{#each tutorialCards as |card index|}}
      {{#if index}}
        <div class="arrow">
          <!-- Waiting on design to fill this in -->
        </>
      {{/if}}
      <div class="card">
        <div class="card-header-img" style="background-image: url({{card.imagePath}})">
        </>
        <div class="card-title">
          {{sanitize card.header}}
        </>
        <div class="card-body">
          {{sanitize card.description}}
        </>
      </>
    {{/each}}
  </>
</>
