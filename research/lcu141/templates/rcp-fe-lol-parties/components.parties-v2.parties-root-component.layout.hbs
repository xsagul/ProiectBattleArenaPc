{{#if inParty}}
  {{#lower-section currentPlayer=currentPlayer}}
    <div class="party-members-container">
      {{#if currentPlayer}}
        {{v2-banner selected=selected member=currentPlayer puuid=currentPlayer.puuid isLocalPlayer=true summonerId=currentPlayer.summonerId chatConversationId=chatConversationId animationsEnabled=animationsEnabled showQuickPlaySelections=showQuickPlaySelections onQuickPlaySelectButtonClick="setShowQuickPlayModal"}}
      {{/if}}
      {{#each otherPartyMembers key="puuid" as |member|}}
        {{v2-banner selected=selected member=member puuid=member.puuid summonerId=member.summonerId chatConversationId=chatConversationId allowPresenceUpdates=true animationsEnabled=animationsEnabled showQuickPlaySelections=showQuickPlaySelections}}
      {{/each}}
      {{#each playerPlaceholders key="index" as |placeholder|}}
        {{v2-banner-placeholder placeholder=placeholder isInQueue=isInQueue partyInvitesAllowed=partyInvitesAllowed showInviteModal="showInviteModal"}}
      {{/each}}
    </>
  {{/lower-section}}
  <div class="footer-container">
    {{v2-footer showingState=showingState selected=selected currentPlayerCanInvite=currentPlayerCanInvite shouldHideSecondaryPosition=shouldHideSecondaryPositionForLocalPlayer openOverlay=(action this "openOverlay") closeOverlay=(action this "closeOverlay") inParty=inParty}}
  </>
  <div class="navbar-blur">
  </>
  <div class="lobby-intro-animation-container">
    <lol-uikit-lottie id="lottie-intro-anim" src="/fe/lol-parties/lottie/parties-v2/intro-party.json" autoplay="false">
    </>
    <lol-uikit-video id="player-banner-gem-intro" fade-in="0" fade-out="0" src="/fe/lol-static-assets/videos/lobby-crystal-intro-player.webm">
    </>
  </>
  <lc-confirm-modal acceptText={{tra.parties_button_confirm}} closeButton={{true}} onYes={{action this "setShowQuickPlayModal" false}} onHide={{action this "setShowQuickPlayModal" false}} open={{showQuickPlayModal}} dismissibleType="inside">
    <lc-modal-content>
      {{quick-play-loadout-selector showQuickPlaySelections=lobbiesService.lobby.gameConfig.showQuickPlaySlotSelection defaultSelections=quickPlayService.quickPlayDefaultSelections localPlayer=currentPlayer selectingSlotIndex=selectingSlotIndex shouldHideSecondaryPosition=shouldHideSecondaryPositionForLocalPlayer setSelectingSlotIndex="setQuickPlaySelectingSlotIndex" setShowQuickPlayModal="setShowQuickPlayModal"}}
    </>
  </>
  {{#if positionSelectorOverlayPrimaryVisible}}
    {{v2-position-selector-modal animationsEnabled=animationsEnabled childrenPositionStyle=positionSelectorOverlayPrimaryPosition selectingOrdinal="PRIMARY" scarcePositions=scarcePositions primaryPosition=primaryPosition secondaryPosition=visibleSecondaryPosition currentPartyIsFull=currentPartyIsFull openOverlay=(action this "openOverlay") closeOverlay=(action this "closeOverlay") setPositionPreferences=(action this "setPositionPreferences"}}
  {{/if}}
  {{#if positionSelectorOverlaySecondaryVisible}}
    {{v2-position-selector-modal animationsEnabled=animationsEnabled childrenPositionStyle=positionSelectorOverlaySecondaryPosition selectingOrdinal="SECONDARY" scarcePositions=scarcePositions primaryPosition=primaryPosition secondaryPosition=visibleSecondaryPosition currentPartyIsFull=currentPartyIsFull shouldHideNonScarcePositions=shouldSecondaryButtonHideNonScarcePositions openOverlay=(action this "openOverlay") closeOverlay=(action this "closeOverlay") setPositionPreferences=(action this "setPositionPreferences"}}
  {{/if}}
{{/if}}
