<div class="quick-play-selected-champion-renderer">
  {{#unless isQuickplayModal}}
    {{#uikit-tooltip tooltipConfig=tooltipConfig tooltipPosition="top"}}
      {{quick-play-loadout-tooltip playerSlot=playerSlot}}
    {{/uikit-tooltip}}
  {{/unless}}
  <div class="quick-play-selected-champion-container" onclick={{action this "selectChampionSlot"}}>
    <div class="quick-play-selected-champion-frame">
      {{quick-play-champion-square championId=championId}}
    </>
  </>
  <div class="quick-play-selected-position-container" onmousedown={{action this "openOverlay" selectedSlot}}>
    {{v2-banner-position-icon position=position isPrimary=isPrimary isQuickplayModal=isQuickplayModal}}
  </>
  {{#if isPositionOverlayOpen}}
    {{v2-position-selector-modal animationsEnabled=animationsEnabled selectingOrdinal=selectedSlot scarcePositions=scarcePositions primaryPosition=position secondaryPosition=secondaryPosition isQuickPlayModal=true shouldHideNonScarcePositions=false closeOverlay="closeOverlay" setPositionPreferences="setPositionPreferences"}}
  {{/if}}
</>
