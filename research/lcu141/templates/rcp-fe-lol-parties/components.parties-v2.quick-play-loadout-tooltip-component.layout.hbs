<div class="quick-play-loadout-tooltip">
  <div class="quick-play-loadout-selected-skin-container">
    <img class="quick-play-loadout-selected-skin-image" src={{selectedSkin.splashPath}}>
    </>
    <div class="quick-play-loadout-skin-overlay-container">
      <div class="quick-play-loadout-skin-name-and-summoner-spells">
        <div class="quick-play-loadout-skin-name">
          {{selectedSkin.name}}
        </>
        <div class="quick-play-loadout-summoner-spells-container">
          {{quick-play-summoner-spell-renderer spell=spell1}}
          {{quick-play-summoner-spell-renderer spell=spell2}}
        </>
      </>
    </>
  </>
  {{#if selectedPerkPage}}
    <div class="quick-play-loadout-rune-page-name-and-icons">
      <div class="quick-play-loadout-rune-page-name">
        {{selectedPerkPage.name}}
      </>
      <div class="quick-play-loadout-rune-page-icons">
        <div class="quick-play-loadout-rune-page-perk-frame keystone">
          <img class="quick-play-loadout-rune-page-keystone-icon" src={{selectedPerkPage.pageKeystone.iconPath}}>
          </>
        </>
        <div class="quick-play-loadout-rune-page-perk-frame secondary style-{{selectedPerkPage.subStyleId}}">
          <div class="quick-play-loadout-rune-page-secondary-style-icon" style={{secondaryStyleIconStyle}}>
          </>
        </>
      </>
    </>
  {{/if}}
</>
