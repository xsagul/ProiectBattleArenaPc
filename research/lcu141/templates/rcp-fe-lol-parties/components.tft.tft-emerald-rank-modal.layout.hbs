{{#if shouldDisplay}}
  {{#uikit-modal type="DialogAlert" closeButton=true dismissible=true dismissibleType="inside" onClose=(action this "markTFTEmeraldModalAsSeen") primaryButton=true okText=tra.tft_emerald_rank_modal_button}}
    <div class="tft-emerald-rank-modal__contents">
      <div class="tft-emerald-rank-modal__text-container">
        <h2 class="tft-emerald-rank-modal__subtitle">
          {{tra.tft_emerald_rank_modal_subtitle}}
        </>
        <h1 class="tft-emerald-rank-modal__title">
          {{tra.tft_emerald_rank_modal_title}}
        </>
        <p class="tft-emerald-rank-modal__description">
          {{tra.tft_emerald_rank_modal_description}}
        </>
        <a href={{tra.tft_emerald_rank_modal_url}} class="tft-emerald-rank-modal__link" target="_blank">
          {{tra.tft_emerald_rank_modal_faq}}
        </>
      </>
    </>
  {{/uikit-modal}}
{{/if}}
