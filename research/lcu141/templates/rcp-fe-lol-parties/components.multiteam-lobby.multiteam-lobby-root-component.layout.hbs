{{#if inParty}}
  <div class="multiteam-lobby-root__scrollable-wrapper">
    {{#lower-section currentPlayer=currentPlayer}}
      <lol-uikit-scrollable class="multiteam-lobby-root__scrollable">
        <div class="multiteam-lobby-root__subteam-table {{if isSwapButtonOnCooldown "multiteam-lobby-root__subteam-table-swap-button-cooldown"}}">
          {{#each subteamIndexes as |subteamIndex|}}
            {{multiteam-lobby-subteam subteamIndex=subteamIndex selected=selected bannerTooltipTriggered="bannerTooltipTriggered" bannerTooltipExited="bannerTooltipExited" showInviteModal="showInviteModal" isSwapButtonOnCooldown=isSwapButtonOnCooldown onSwapButtonClicked="onSwapButtonClicked" onAnySwapOccurred="onAnySwapOccurred"}}
          {{/each}}
        </>
      </>
    {{/lower-section}}
  </>
  <div class="footer-container">
    {{v2-footer showingState=showingState inParty=inParty selected=selected}}
  </>
{{/if}}
