<div class="header">
  {{#if titleIconUrl.length}}
    <img class="header-icon" src={{titleIconUrl}} alt="recently-honored-icon">
    </>
  {{/if}}
  {{titleText}}
</>
{{#if isLoading}}
  <div class="spinner">
  </>
{{else}}
  {{#if hasFriendableSummoners}}
    <div class="recent-list">
      {{#each friendableSummoners key="summonerId" as |summoner|}}
        {{friend-finder-recent-summoner summoner=summoner closeModal=closeModal}}
      {{/each}}
    </>
  {{else}}
    <div class="no-recently-played-summoners">
      {{emptyText}}
    </>
  {{/if}}
{{/if}}
