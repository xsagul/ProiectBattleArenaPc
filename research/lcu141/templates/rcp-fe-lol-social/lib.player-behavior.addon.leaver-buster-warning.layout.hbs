<lol-uikit-content-block type="dialog-large">
  <h4>
    {{sanitize notificationContext.header}}
  </>
  <hr class="heading-spacer">
  </>
  <p>
    {{sanitize notificationContext.body}}
  </>
  <lol-uikit-flat-input>
    {{input type="text" class="leaver-buster-warning-input" value=inputValue maxlength="70"}}
  </>
  <p class="leaver-buster-agree-text">
    {{sanitize agreeText}}
  </>
</>
