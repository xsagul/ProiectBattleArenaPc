{{#if hasUnreadNotifications}}
  <div class="identity-rewards-unread-pip">
    {{call-to-action-pip}}
  </>
{{/if}}
<lol-social-avatar ref="iconElement" class={{avatarClassNames}} icon={{avatarIcon}} large="" availability={{availability}} me="">
  {{#if summonerId}}
    {{hovercard-component canShow=canShowHovercard summonerId=summonerId friendId=meObj.puuid openPartyDescription=openPartyDescription}}
  {{/if}}
</>
<div class="details">
  <div class="name">
    {{player-name format="short" puuid=puuid summonerName=summonerName gameName=gameName tagLine=tagLine}}
  </>
  <div class="lower-details">
    <lol-social-availability-hitbox large="" availability={{availability}} me="">
    </>
    {{#if availability}}
      <div class={{statusClassNames}} {{action this "openMenu"}}>
        {{social-status-wrapper class="identity-message" friend=meObj}}
      </>
    {{/if}}
    {{#if playerNotificationsEnabled}}
      <lol-player-notifications-button class="notifications-button">
        {{#social-text-tooltip direction="left"}}
          {{tra.tooltip_notifications}}
        {{/social-text-tooltip}}
      </>
    {{/if}}
  </>
</>
<lc-flyout open={{isMenuOpen}} onHide={{action this "doCloseMenu"}} direction="bottom" offsetx="-2" offsety="2" caretless="true">
  <lc-flyout-content>
    <div class="identity-menu">
      {{#if isMenuOpen}}
        {{social-menu-input error=statusError currentStatus=statusMessage saveMessage=tra.menu_item_status_saved placeholderText=tra.menu_item_set_status onCancel=(action this "doCloseMenu") onChange=(action this "doClearStatusError") onSave=(action this "saveNewMessage") maxLength="25"}}
        {{#if statusInputMessagePacket}}
          {{tooltip-message position="bottom" messagePacket=statusInputMessagePacket delay=-1 selector=".social-status-change-input"}}
        {{/if}}
      {{/if}}
    </>
  </>
</>
