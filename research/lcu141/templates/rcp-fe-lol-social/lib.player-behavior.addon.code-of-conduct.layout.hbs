<div class="code-of-conduct-content-container">
  <div class="code-of-conduct-close-button" {{action this "closeModalWithoutAccepting"}}>
  </>
  <div class="code-of-conduct-title-container">
    <div class="header-emphasis-metal left">
    </>
    <h2 class="header-title">
      {{tra.player_behavior_code_of_conduct_header}}
    </>
    <div class="header-emphasis-metal right">
    </>
  </>
  <div class="rules-container">
    {{#each rulesToAcknowledge as |ruleItem|}}
      <div class="rule-item-container rule-item-{{ruleItem.id}} {{if ruleItem.accepted "accepted"}}" {{action this "unlockNextRule" ruleItem}}>
        <div class="rule-item-content">
          <div class="rule-item-spacer">
          </>
          <div class="rule-item-subheader-container">
            <div class="rule-item-icon" style="background-image:url({{ruleItem.icon}})">
            </>
            <div class="rule-item-subheader">
              {{ruleItem.subheader}}
            </>
          </>
          <div class="rule-item-body-container">
            <div class="rule-item-body">
              {{ruleItem.body}}
            </>
            <div class="rule-item-checkbox-container">
              <div class="rule-item-checkbox">
              </>
            </>
          </>
          <div class="rule-item-bottom-border">
          </>
        </>
      </>
    {{/each}}
  </>
  <div class="more-info-link">
    {{sanitize tra.player_behavior_code_of_conduct_link_more_info}}
  </>
</>
