<div class="lol-friend-finder-modal">
  <h4 class="title">
    {{tra.friend_finder_modal_title}}
  </>
  <div class="modal-body">
    <div class="recently-played-panel active">
      {{friend-finder-add-summoner-by-name}}
      <lol-uikit-scrollable overflow-masks="enabled">
        {{#if hasSentFriendRequests}}
          {{friend-finder-requested-players closeModal=onClose}}
        {{/if}}
        {{#if friendRequestsService.friendableRecentlyHonored.length}}
          {{friend-finder-recently-played titleIconUrl="/fe/lol-social/recently-honored-default-icon.png" isLoading=friendRequestsService.isLoadingHonorRecognition friendableSummoners=friendRequestsService.friendableRecentlyHonored titleText=tra.friend_finder_modal_recently_honored closeModal=onClose}}
        {{/if}}
        {{friend-finder-recently-played isLoading=friendRequestsService.isLoadingRecentlyPlayedSummoners friendableSummoners=friendRequestsService.friendableRecentlyPlayed emptyText=tra.recently_played_empty titleText=tra.friend_finder_modal_recently_played_with closeModal=onClose}}
      </>
    </>
  </>
</>
