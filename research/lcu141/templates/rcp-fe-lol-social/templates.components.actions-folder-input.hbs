<div class="folder-name">
  <form onsubmit={{action this "onSubmit"}} class="folder-name-contents layout">
    <lol-uikit-flat-input class="flat-input">
      <input type="text" class={{folderInputClasses}} value={{folderNameText}} onkeydown={{action this "onKeyEvent"}} onblur={{action this "onCancel"}} oninput={{action this "onInput" value="target.value"}} maxlength="25" placeholder={{placeholderText}}>
      </>
    </>
    {{#if errorMessage}}
      {{tooltip-message position="bottom" messagePacket=errorMessage delay=-1}}
    {{/if}}
  </>
  {{#if isSaving}}
    <div class="animation">
      <div class="success-message">
        {{tra.group_new_group_created}}
      </>
    </>
  {{/if}}
</>
