<div class="summoner-identity">
  <lol-social-avatar champion={{summoner.championId}} hideindicator="" disabled="">
  </>
  <div class="player-name-wrapper">
    {{player-name format="short" puuid=summoner.puuid gameNameClass="summoner-name" summonerNameClass="summoner-name" summonerName=summoner.summonerName}}
    {{#if isUsingAlias}}
      {{player-name format="full" puuid=summoner.puuid}}
    {{/if}}
  </>
  {{tooltip-message position="bottom" width="300px" messagePacket=messagePacket}}
</>
{{#if requested}}
  <div class="added">
  </>
{{else}}
  {{#if working}}
    {{uikit-spinner width="16px" height="16px"}}
  {{else}}
    <div class="add-button" onclick={{action this "submitAddFriend"}}>
    </>
  {{/if}}
{{/if}}
{{hovercard-component options=hovercardOptions summonerId=summoner.summonerId friendId=summoner.puuid}}
