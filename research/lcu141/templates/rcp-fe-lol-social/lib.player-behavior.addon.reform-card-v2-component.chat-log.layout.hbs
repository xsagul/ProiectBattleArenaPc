<div class="reform-card-chat-log-header">
  <div class="reform-card-chat-log-header-title">
    {{tra.player_behavior_reform_card_logs_title}}
  </>
  <div class="reform-card-chat-log-header-copy-log-container">
    <a href="#" class="chat-log-header-copy-log-link" {{action this "copyText"}}>
      {{copyLinkText}}
    </>
  </>
</>
<div class="reform-card-chat-log-body">
  {{#unless reformCard.punishedForReformCardChatLogs.length}}
    <lol-uikit-scrollable class="reform-card-scrollable-game selected" overflow-masks="enabled">
      <div class="reform-card-chat-log-game">
        {{tra.player_behavior_reform_card_no_logs_text}}
      </>
    </>
  {{else}}
    <div class="reform-card-chat-tab-container">
      {{#each allChatLogs as |gameChatLog index|}}
        <div id="{{index}}" class="reform-card-chat-tab {{unless index "selected"}}" {{action this "selectGame" index}}>
          {{gameChatLog.title}}
        </>
      {{/each}}
      <hr class="reform-card-chat-tab-line">
      </>
    </>
    {{#each allChatLogs as |gameChatLog index|}}
      <lol-uikit-scrollable id="{{index}}" class="reform-card-scrollable-game {{unless index "selected"}}" overflow-masks="enabled">
        <div class="reform-card-chat-log-game">
          <div class="reform-card-chat-log-hidden-header">
            {{gameChatLog.title}}
          </>
          {{#if gameChatLog.preGameChatLogs.length}}
            <div class="reform-card-chat-log-subheader">
              <div class="reform-card-chat-log-subheader-text">
                {{tra.player_behavior_reform_card_pregame_header}}
              </>
            </>
            {{#each gameChatLog.preGameChatLogs as |chatLog|}}
              <div class="reform-card-chat-log-example">
                <span class="reform-card-chat-log-name">
                  {{summonerName}}
                  :
                </>
                {{chatLog}}
              </>
            {{/each}}
          {{/if}}
          {{#if gameChatLog.inGameChatLogs.length}}
            <div class="reform-card-chat-log-subheader">
              <div class="reform-card-chat-log-subheader-text">
                {{tra.player_behavior_reform_card_ingame_header}}
              </>
            </>
            {{#each gameChatLog.inGameChatLogs as |chatLog|}}
              <div class="reform-card-chat-log-example">
                <span class="reform-card-chat-log-name">
                  {{summonerName}}
                  :
                </>
                {{chatLog}}
              </>
            {{/each}}
          {{/if}}
          {{#if gameChatLog.postGameChatLogs.length}}
            <div class="reform-card-chat-log-subheader">
              <div class="reform-card-chat-log-subheader-text">
                {{tra.player_behavior_reform_card_postgame_header}}
              </>
            </>
            {{#each gameChatLog.postGameChatLogs as |chatLog|}}
              <div class="reform-card-chat-log-example">
                <span class="reform-card-chat-log-name">
                  {{summonerName}}
                  :
                </>
                {{chatLog}}
              </>
            {{/each}}
          {{/if}}
        </>
      </>
    {{/each}}
  {{/unless}}
</>
