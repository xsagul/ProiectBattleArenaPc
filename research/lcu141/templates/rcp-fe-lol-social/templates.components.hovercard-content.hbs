<div id="hover-card-header">
  <div style={{backdropStyles}} id="hover-card-backdrop" class="hover-card-backdrop">
  </>
  <div class="hover-card-header-left">
    {{#if masteryScore}}
      <span class="hover-card-mastery-image">
      </>
      <span class="hover-card-mastery-score">
        {{masteryScore}}
      </>
    {{/if}}
  </>
  <div class="hover-card-header-right">
    {{#if role}}
      <span class={{roleClasses}}>
      </>
    {{/if}}
    {{#if position}}
      <span class={{positionClasses}}>
      </>
    {{/if}}
  </>
</>
{{#if summonerIdAndNotRemote}}
  <div class="hover-card-info-container">
    <div class="hover-card-identity">
      <lol-regalia-hovercard-v2-element ref="regaliaElement" summoner-id={{summonerId}} puuid={{puuid}}>
      </>
    </>
    <div class="hover-card-info {{if isUsingAlias "hover-card-info-line-height-override"}}">
      {{player-name format="component" aliasComponent="hovercard-name-alias-mode" summonerNameComponent=(component "hovercard-name-summoner-mode" showGameNameAndTag=showGameNameAndTag summonerIdAndNotRemote=summonerIdAndNotRemote) gameName=gameName tagLine=gameTag summonerName=summonerName}}
      {{#if summonerTitle}}
        <div class="hover-card-title-wrapper">
          <div class="hover-card-title">
            {{summonerTitle}}
          </>
        </>
      {{/if}}
      <div class="hover-card-ranked-description">
        {{#if showRankData}}
          <div class="hover-card-rank">
            <div class="hover-card-rank-img-container">
              <img class="hover-card-rank-image" src={{rankedMiniRegaliaPath}}>
              </>
            </>
            {{rankedSummary}}
          </>
        {{/if}}
        {{#if showChallengeCrystalData}}
          <div class="hover-card-challenge-crystal">
            <div class="hover-card-rank-img-container">
              <img class="hover-card-crystal-image" src={{challengeMiniCrystalPath}}>
              </>
            </>
            {{challengeCrystalLevelSummary}}
          </>
        {{/if}}
      </>
    </>
  </>
{{else}}
  <div class="hover-card-info-container">
    <div class="hover-card-identity">
      <div class="hover-card-icon">
        {{#if productIconUrl}}
          <img class="icon-image" src={{productIconUrl}}>
          </>
          <div class="icon-ring">
          </>
        {{else}}
          <div class="icon-ring" class="no-image">
          </>
        {{/if}}
      </>
    </>
    <div class="hover-card-info">
      {{player-name format="component" aliasComponent="hovercard-name-alias-mode" summonerNameComponent=(component "hovercard-name-summoner-mode" showGameNameAndTag=showGameNameAndTag summonerIdAndNotRemote=summonerIdAndNotRemote) gameName=gameName tagLine=gameTag summonerName=summonerName}}
    </>
  </>
{{/if}}
<div class="hover-card-footer">
  <div class="hover-card-bottom-info">
    {{#if gntOnlyAndOffline}}
      <div class="hover-card-availability offline">
        <span class="hover-card-availability-icon offline">
        </>
        <div class="hover-card-availability-message offline">
          {{tra.availability_offline}}
        </>
      </>
    {{/if}}
    {{#if noteOfflineGnt}}
      <div class="hover-card-note-wrapper-offline-gnt">
        <div class="hover-card-note-icon">
        </>
        <div class="hover-card-note">
          {{note}}
        </>
      </>
    {{else}}
      {{#if knownNotGnt}}
        <div class="hover-card-availability">
          <span class={{availabilityClasses}}>
          </>
          {{#if gameStatusInGame}}
            <div class="hover-card-gameinfo">
              {{#if mapNameOrGameType}}
                {{#if mapName}}
                  <span>
                    {{mapName}}
                  </>
                {{/if}}
                {{#if gameType}}
                  <span>
                    (
                    {{gameQueueTypeString}}
                    )
                  </>
                {{/if}}
              {{else}}
                {{#if gameMode}}
                  <span>
                    {{gameMode}}
                  </>
                {{/if}}
              {{/if}}
              {{#if championName}}
                <span>
                  -
                  {{championName}}
                </>
              {{/if}}
            </>
            {{#if gameStart}}
              <div class="hover-card-time">
                {{gameStartFormatted}}
              </>
            {{/if}}
          {{else}}
            {{#if pty}}
              <div class="hovercard-open-party">
                <div class="hovercard-open-party-text">
                  {{#if availabilityAway}}
                    <div class="open-party-availability">
                      <span class={{hCardAvailabilityIconClasses}}>
                      </>
                      <div class={{hCardAvailabilityMessageClasses}}>
                        {{availabilityTra}}
                      </>
                    </>
                  {{else}}
                    <div class="open-party-icon">
                    </>
                  {{/if}}
                  <div class={{hCardOpenPartyClasses}}>
                    {{partyOccupancyString}}
                  </>
                  <div class="open-party-string">
                    {{tra.open_party}}
                  </>
                </>
                <div class={{hCardOpenPartySummonersClasses}}>
                  {{partySummonerNames}}
                </>
              </>
            {{else}}
              {{#if gameStatusChampionSelect}}
                <div class="hover-card-gameinfo">
                  <span>
                    {{tra.availability_championSelect}}
                  </>
                  {{#if mapName}}
                    <span>
                      -
                      {{mapName}}
                    </>
                  {{/if}}
                  <span>
                    (
                    {{gameQueueTypeString}}
                    )
                  </>
                </>
              {{else}}
                {{#if tournamentStatusNotNone}}
                  <div class="hover-card-gameinfo">
                    {{tournamentStatusTra}}
                  </>
                {{else}}
                  {{#if gameStatusNotOutOfGame}}
                    <div class="hover-card-game-status {{availability}}">
                      {{gameStatusString}}
                    </>
                  {{else}}
                    {{#if hasAvailabilityString}}
                      <div class={{hCardAvailabilityMessageClasses}}>
                        {{availabilityTra}}
                        {{#if remoteProductName}}
                          <span class="status-message-product-name">
                            -
                            {{remoteProductName}}
                          </>
                        {{else}}
                          {{#if remotePlatformId}}
                            <span class="status-message-product-name">
                              -
                              {{remotePlatformId}}
                            </>
                          {{/if}}
                        {{/if}}
                      </>
                    {{/if}}
                  {{/if}}
                {{/if}}
              {{/if}}
            {{/if}}
          {{/if}}
        </>
        {{#if statusMessage}}
          <div class="hover-card-status-message-wrapper">
            <div class="hover-card-status-message-icon">
            </>
            <div class="hover-card-status-message">
              “
              {{statusMessage}}
              ”
            </>
          </>
        {{/if}}
        {{#if note}}
          <div class="hover-card-note-wrapper">
            <div class="hover-card-note-icon">
            </>
            <div class="hover-card-note">
              {{note}}
            </>
          </>
        {{/if}}
      {{/if}}
    {{/if}}
  </>
</>
