{{#if showGameNameAndTag}}
  <div class="hover-card-game-name-and-tag-wrapper">
    <div class="hover-card-game-name">
      {{playerName.gameName}}
    </>
    <div class="hover-card-game-tag">
      #
      {{playerName.tagLine}}
    </>
  </>
{{/if}}
<div class="hover-card-name-wrapper">
  <div class="hover-card-name">
    {{if summonerIdAndNotRemote playerName.summonerName playerName.gameName}}
  </>
</>
