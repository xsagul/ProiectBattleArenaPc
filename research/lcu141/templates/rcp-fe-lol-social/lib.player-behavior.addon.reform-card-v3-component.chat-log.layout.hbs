<div class="reform-card-chat-log-header">
  <div class="reform-card-chat-log-header-title">
    {{chatLogsHeader}}
  </>
  <div class="reform-card-chat-log-header-copy-log-container">
    <a href="#" class="chat-log-header-copy-log-link" {{action this "copyText"}}>
      {{copyLinkText}}
    </>
  </>
</>
<div class="reform-card-chat-log-body">
  <lol-uikit-scrollable id="{{index}}" class="reform-card-scrollable-game {{unless index "selected"}}" overflow-masks="enabled">
    <div class="reform-card-chat-log-game">
      {{#each chatLogLines as |chatLogLine|}}
        <div class="reform-card-chat-log-example">
          <span class="reform-card-chat-log-name">
            {{displayName}}
            :
          </>
          {{chatLogLine}}
        </>
      {{/each}}
    </>
  </>
</>
