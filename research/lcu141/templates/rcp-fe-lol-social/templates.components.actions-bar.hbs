<div class="lol-social-actions-bar actions">
  <div class={{actionsBarClasses}}>
    <div class="buttons">
      <span class="friend-header">
        {{tra.friend_header}}
      </>
      {{friend-finder-button disabled=friendFinderButtonDisabled}}
      {{#if notChatGBG}}
        <span class={{folderButtonClasses}} onclick={{action this "addFolder"}}>
          {{#social-text-tooltip direction="bottom" clearOnClick=true}}
            {{tra.tooltip_new_folder}}
          {{/social-text-tooltip}}
        </>
      {{/if}}
      <span class={{optionsButtonClasses}} onclick={{action this "openOptionsMenu"}}>
        {{#if showGroupingNotification}}
          {{#social-tooltip direction="left" type="attention" onclick=(action this "closeAttentionTooltip")}}
            {{#content-block-attention}}
              {{tra.roster_attention_grouping_changes}}
            {{/content-block-attention}}
          {{/social-tooltip}}
        {{else}}
          {{#social-text-tooltip direction="bottom" clearOnClick=true}}
            {{tra.tooltip_options}}
          {{/social-text-tooltip}}
        {{/if}}
      </>
      <span class={{filterButtonClasses}} onclick={{action this "openSlidingFilter"}}>
        {{#social-text-tooltip direction="left" clearOnClick=true}}
          {{tra.tooltip_filter}}
        {{/social-text-tooltip}}
      </>
    </>
    {{#if folderAddOpen}}
      {{actions-folder-input onFolderInputClose=(action this "closeFolderInput"}}
    {{/if}}
    <lol-uikit-flat-input class="search-box">
      {{input id="actions-bar-search-input" type="search" placeholder=tra.filter_placeholder value=friendsSearchText value-events="input" escape-press=(action this "closeSlidingFilter") focus-in="openSlidingFilter" focus-out="closeSlidingFilter" maxlength="26"}}
    </>
  </>
</>
<lc-flyout open={{optionsOpen}} onHide={{action this "closeOptionsMenu"}} direction="bottom" offsetx="-2" caretless="true">
  <lc-flyout-content>
    <div class={{optionsMenuClasses}}>
      {{#uikit-radio selected=(action this "updateSort")}}
        <lol-uikit-radio-input-option title="alphabetical" selected={{sortingAlphabetical}}>
          {{tra.menu_item_sort_alphabetically}}
        </>
        <lol-uikit-radio-input-option title="availability" selected={{sortingAvailability}}>
          {{tra.menu_item_sort_status}}
        </>
      {{/uikit-radio}}
      {{#if allowGroupByGame}}
        <div id="gbg-menuitem" class="lol-social-menu-item menu-item-separator">
          <lol-uikit-flat-checkbox class="gbg-checkbox">
            <input slot="input" type="checkbox" onchange={{action this "saveRosterGBG"}} checked={{chatGBG}}>
            </>
            <label slot="label" class="gbg-label">
              <span>
                {{tra.dropdown_gbg}}
              </>
              <span class="menuitem-sublabel">
                {{tra.dropdown_disables_folders}}
              </>
            </>
          </>
        </>
      {{/if}}
      {{#unless isTencent}}
        <div id="group-mobile-menuitem" class="lol-social-menu-item">
          <lol-uikit-flat-checkbox>
            <input slot="input" type="checkbox" onchange={{action this "saveRosterGroupMobile"}} checked={{chatGroupMobileOrChatGBG}} disabled={{chatGBG}}>
            </>
            <label slot="label">
              {{tra.dropdown_group_mobile}}
            </>
          </>
        </>
      {{/unless}}
      <div id="group-offline-menuitem" class="lol-social-menu-item">
        <lol-uikit-flat-checkbox>
          <input slot="input" type="checkbox" onchange={{action this "saveRosterGroupOffline"}} checked={{chatGroupOfflineOrChatGBG}} disabled={{chatGBG}}>
          </>
          <label slot="label">
            {{tra.dropdown_group_offline}}
          </>
        </>
      </>
    </>
  </>
</>
