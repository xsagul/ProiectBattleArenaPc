<div class={{rootClasses}}>
  <div class={{containerClasses}}>
    {{hovercard-content loggedIn=loggedIn isKnown=isKnown me=me rawChampionsInfo=rawChampionsInfo champion=champion friendId=friendId friendInfo=friendInfo accountId=accountId summonerName=summonerName gameName=gameName gameTag=gameTag puuid=puuid availability=availability gameStatus=gameStatus playerChallengeSummary=playerChallengeSummary playerRankedSummary=playerRankedSummary gntOnlyAndOffline=gntOnlyAndOffline regaliaEnabled=regaliaEnabled remoteProduct=remoteProduct remotePlatform=remotePlatform notRemoteProduct=notRemoteProduct summonerIconUrl=summonerIconUrl getHovercardRoot=getHovercardRoot __canRenderHovercard=canRenderHovercard openPartyDescription=openPartyDescription now=now}}
  </>
</>
{{#if canRenderHovercard}}
  <div id="border-container" data-class-has-regalia="--isRegaliaEnabled">
    <svg id="border" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" version="1.1">
      <defs>
        <linearGradient id="gradient" x1={{svgLinGradPos.x1}} y1={{svgLinGradPos.y1}} x2={{svgLinGradPos.x2}} y2={{svgLinGradPos.y2}}>
          <stop offset="60%" stop-color="#785A28">
          </>
          <stop offset="100%" stop-color="#463714">
          </>
        </>
      </>
      <path id="tick-path" d="M369.5 6.5 l 3 1 v 59.5 l 2 2 v 1 l -2 2 v 59.5 l -3 1 v -52.5 l 10.5 -10.5 l -10.5 -10.5 z" fill="#010A13" stroke="#785A28" stroke-width="1">
      </>
      <path id="border-path" d="M1 1 h 368 v 57.5 l 11 11 l -11 11 v 57.5 H 1 Z" fill="transparent" stroke="url(#gradient)" stroke-width="2">
      </>
    </>
  </>
{{/if}}
