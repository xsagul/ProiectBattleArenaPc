{{#if hasChallenges}}
  {{#ember-collection class="item-grid-scrollable challenges-scroll-container" items=sortedChallenges cell-layout=(mixed-grid-layout itemSizes) as |entry index|}}
    {{#if entry.isTitle}}
      <div class="challenge-group-title-container">
        <div class="challenge-group-title">
          {{entry.name}}
        </>
        {{#if entry.description}}
          <div class="challenge-group-description">
            <div class="challenge-group-description-icon {{entry.description.icon}}">
            </>
            <div class="challenge-group-description-text">
              {{#uikit-tooltip tooltipPosition="top" type="system"}}
                <lol-uikit-content-block class="challenge-group-description-tooltip" type="tooltip-large">
                  <div class="challenge-group-description-tooltip-wrapper">
                    <h5 class="challenge-group-description-tooltip-title">
                      {{entry.description.tooltipTitle}}
                    </>
                    <p class="challenge-group-description-tooltip-text">
                      {{entry.description.tooltipText}}
                    </>
                  </>
                </>
              {{/uikit-tooltip}}
              {{entry.description.text}}
            </>
          </>
        {{/if}}
      </>
    {{else}}
      {{challenge-item challengeData=entry apexLadderUpdateTime=summary.apexLadderUpdateTime animationsEnabled=animationsEnabled}}
    {{/if}}
  {{/ember-collection}}
{{/if}}
