<lc-alert-modal okText="{{tra.challenge_intro_modal_button}}" onOk={{action this "markIntroModalAsRead"}} dismissible={{true}} dismissibleType="inside" open={{isIntroModalShowing}}>
  <lc-modal-content>
    <div class="challenges-intro-modal">
      <div class="challenges-intro-modal-header">
        <img src="/fe/lol-static-assets/images/challenges-shared/challenge-intro-modal-diamond.png">
        </>
        <div class="challenges-intro-modal-title-wrapper">
          <div class="challenges-intro-modal-line challenges-intro-modal-line-left">
          </>
          <div class="challenges-intro-modal-title">
            {{tra.challenge_intro_modal_title}}
          </>
          <div class="challenges-intro-modal-line challenges-intro-modal-line-right">
          </>
        </>
        <div class="challenges-intro-modal-description">
          {{tra.challenge_intro_modal_description}}
        </>
      </>
      <div class="challenges-intro-modal-tiles">
        <div class="challenges-intro-modal-tile challenges-intro-modal-tile-1">
          <div class="challenges-intro-modal-tile-title">
            {{tra.challenge_intro_modal_tile_1_title}}
          </>
          <div class="challenges-intro-modal-tile-description">
            {{tra.challenge_intro_modal_tile_1_description}}
          </>
        </>
        <div class="challenges-intro-modal-tile challenges-intro-modal-tile-2">
          <div class="challenges-intro-modal-tile-title">
            {{tra.challenge_intro_modal_tile_2_title}}
          </>
          <div class="challenges-intro-modal-tile-description">
            {{tra.challenge_intro_modal_tile_2_description}}
          </>
        </>
        <div class="challenges-intro-modal-tile challenges-intro-modal-tile-3">
          <div class="challenges-intro-modal-tile-title">
            {{tra.challenge_intro_modal_tile_3_title}}
          </>
          <div class="challenges-intro-modal-tile-description">
            {{tra.challenge_intro_modal_tile_3_description}}
          </>
        </>
      </>
    </>
  </>
</>
