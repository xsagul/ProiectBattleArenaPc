{{#if hasChallenges}}
  {{#ember-collection class="item-grid-scrollable challenges-scroll-container" items=sortedChallenges cell-layout=(mixed-grid-layout itemSizes) as |entry index|}}
    {{#if entry.isTitle}}
      <div class="challenge-group-title-container">
        <div class="challenge-group-title-icon-container">
          <div class="challenges-icon {{entry.icon}}">
          </>
        </>
        <div class="challenge-group-title">
          {{entry.title}}
          {{#uikit-tooltip tooltipPosition="bottom" type="system"}}
            <lol-uikit-content-block type="tooltip-system" class="capstone-row-title-tooltip">
              <div class="capstone-row-title-tooltip-container">
                <div class="capstone-row-title-tooltip-name">
                  <div class="challenges-icon-container">
                    <div class="challenges-icon {{entry.icon}}">
                    </>
                  </>
                  <div>
                    {{entry.name}}
                  </>
                </>
                <div class="capstone-row-title-tooltip-description">
                  {{entry.description}}
                </>
              </>
            </>
          {{/uikit-tooltip}}
        </>
        <div class="challenge-group-title-horizontal-line">
        </>
      </>
    {{else}}
      {{#if entry.isCapstoneView}}
        {{collection-grid-row-capstone challenges=challenges challenge=entry summary=summary puuid=puuid animationsEnabled=animationsEnabled onTokenClick=(action this "onTokenClick"}}
      {{else}}
        {{collection-grid-row-group challenges=challenges challenge=entry summary=summary puuid=puuid animationsEnabled=animationsEnabled}}
      {{/if}}
    {{/if}}
  {{/ember-collection}}
{{/if}}
