<div class="clipboard-copy-game-id-container" onmouseenter={{action this "mouseEnterClipboardIcon"}} onclick={{action this "copyGameIdToClipboard"}}>
  <div class="clipboard-copy-game-id-inner-container">
    {{tra.clipboard_copy_scoreboard_game_id}}
    <div class="clipboard-copy-icon">
    </>
    {{#uikit-tooltip type="system" tooltipPosition="bottom"}}
      <lol-uikit-content-block type="tooltip-system">
        <div class="clipboard-tooltip-container">
          <div class="clipboard-tooltip-inner-container">
            <div class="clipboard-tooltip-game-id-label">
              {{tra.clipboard_copy_scoreboard_tooltip_game_id}}
            </>
            <div class="clipboard-tooltip-game-id-number">
              {{gameId}}
            </>
          </>
          <div class="clipboard-tooltip-divider">
          </>
          <div class="clipboard-tooltip-copy-text">
            {{clipboardIconTooltip}}
          </>
        </>
      </>
    {{/uikit-tooltip}}
  </>
</>
