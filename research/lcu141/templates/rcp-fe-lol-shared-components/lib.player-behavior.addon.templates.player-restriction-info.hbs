<div class="player-restriction-info-component">
  {{#if isWarningShown}}
    <div class="player-restriction-warning-icon">
    </>
    {{#uikit-tooltip tooltipPosition="right"}}
      <lol-uikit-content-block type="tooltip-large" class="restriction-tooltip-body">
        <div class="player-restriction-info-tooltip">
          <h5 class="player-restriction-info-header">
            {{tra.player_restriction_tooltip}}
          </>
          {{#if hasRankedRestriction}}
            <div class="restriction-container">
              <p>
                <span class="restriction-title-text">
                  {{tra.ranked_restriction_tooltip_title}}
                </>
                {{rankedRestrictionMessage}}
              </>
            </>
          {{/if}}
          {{#if hasChatRestriction}}
            <div class="restriction-container">
              <p>
                <span class="restriction-title-text">
                  {{tra.chat_restriction_tooltip_title}}
                </>
                {{chatRestrictionMessage}}
              </>
            </>
          {{/if}}
        </>
      </>
    {{/uikit-tooltip}}
  {{/if}}
</>
