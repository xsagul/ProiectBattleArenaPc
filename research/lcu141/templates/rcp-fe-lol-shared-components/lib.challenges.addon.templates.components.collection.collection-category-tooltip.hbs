<div class="tooltip-header-container">
  <div class="tooltip-image-container">
    <img class="tooltip-image category-icon color-{{challengeCategoryLevel}} {{if isCategoryTooltip "category" "crystal"}}" src="{{assetImagePath}}">
    </>
  </>
  <div class="tooltip-details-container">
    <div class="tooltip-title">
      {{txtTitle}}
    </>
    {{#unless isLegacyTooltip}}
      <div class="tooltip-tier">
        {{localizedChallengeLevel}}
      </>
      <div class="tooltip-position-percentile">
        <div class="icon-people">
        </>
        <div>
          {{txtPositionPercentile}}
        </>
      </>
    {{else}}
      <div class="tooltip-earned">
        {{txtChallengesCount}}
      </>
    {{/unless}}
  </>
</>
<div class="tooltip-description">
  {{txtDescription}}
</>
{{#unless isLegacyTooltip}}
  <div class="challenges-progress-bar-container">
    <div class="challenges-progress-bar">
      <div class="challenges-progress-meter-fill">
      </>
      <div class="challenges-progress-text">
        {{currentValue}}
        /
        {{nextValue}}
      </>
    </>
  </>
{{/unless}}
