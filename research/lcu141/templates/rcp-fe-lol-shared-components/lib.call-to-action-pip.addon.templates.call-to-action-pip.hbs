<uikit-state-machine state="loading">
  <uikit-states>
    <uikit-state name="loading">
      <uikit-transition next-state="intro">
        <uikit-condition-media selector=".pip-cta-intro" can-play="">
        </>
      </>
    </>
    <uikit-state name="intro">
      <uikit-behavior-media selector=".pip-cta-intro" playing="">
      </>
      <uikit-transition next-state="loop">
        <uikit-condition-media selector=".pip-cta-intro" ended="">
        </>
      </>
    </>
    <uikit-state name="loop">
    </>
  </>
  <uikit-video visible-state="intro" class="pip-cta-intro" src="/fe/lol-navigation/menu-item-call-to-action-intro.webm">
  </>
  <div visible-state="loop" class="pip-cta-loop">
  </>
</>
