{{#if isChallengeTitle}}
  {{#uikit-tooltip tooltipPosition="right" type="system" pseudoPartSelector="challenge-item-tooltip"}}
    {{challenge-item-tooltip challengeData=title.challengeData animationsEnabled=false}}
  {{/uikit-tooltip}}
{{else}}
  {{#if isDefaultTitle}}
    {{#uikit-tooltip tooltipPosition="right" type="system"}}
      <lol-uikit-content-block type="tooltip-system">
        <p>
          {{tra.challenges_identity_customizer_default_title_description}}
        </>
      </>
    {{/uikit-tooltip}}
  {{else}}
    {{#if isPlayerTitle}}
      {{#uikit-tooltip tooltipPosition="right" type="system" pseudoPartSelector="player-title-tooltip"}}
        {{player-title-tooltip titleData=title}}
      {{/uikit-tooltip}}
    {{/if}}
  {{/if}}
{{/if}}
{{#if showNotificationPip}}
  <div class="notification-pip">
    {{call-to-action-pip}}
  </>
{{/if}}
<div class="title-icon title-icon-acquisition-{{titleAcquisitionType}}">
</>
<div class="title-text">
  {{title.name}}
</>
{{#if isChallengeTitle}}
  <div class="challenge-data">
    <div class="challenge-icon-container">
      {{#if challengeLevel}}
        <img class="challenge-icon" src="/fe/lol-static-assets/images/challenges-shared/icon-token-{{challengeLevel}}.png">
        </>
      {{/if}}
    </>
    <div class="challenge-name">
      {{challengeTitleData.challengeName}}
    </>
  </>
{{else}}
  {{#if isPlayerTitle}}
    <div class="player-title-data">
      {{#if title.iconPath}}
        <div class="player-title-icon-container">
          <img class="player-title-icon" src="{{title.iconPath}}">
          </>
        </>
      {{/if}}
      <div class="player-title-details">
        <div class="player-title-acquisition-name">
          {{title.titleAcquisitionName}}
        </>
      </>
    </>
  {{/if}}
{{/if}}
