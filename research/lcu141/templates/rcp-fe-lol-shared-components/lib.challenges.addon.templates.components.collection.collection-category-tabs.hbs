{{#each (-each-in categoryTabs) as |index tab|}}
  {{#if tab.isLegacy}}
    <div class="category-tab-horiontal-line">
    </>
  {{/if}}
  <div class="category-tab-container" {{action this "selectTab" tab}} {{action this "hoverTab" tab on="mouseEnter"}} {{action this "unhoverTab" on="mouseLeave"}}>
    {{#uikit-tooltip tooltipPosition="right" type="system" pseudoPartSelector="collection-category-tooltip"}}
      {{collection-category-tooltip tooltipType="CATEGORY" tier=tab.level category=tab.value currentValue=tab.current nextValue=tab.next challengesCount=tab.challengesCount positionPercentile=tab.positionPercentile}}
    {{/uikit-tooltip}}
    <div class="category-tab-background-highlight {{if tab.selected "active"}} {{if tab.hovered "hover"}}">
    </>
    <div class="category-tab-wrapper {{if tab.isLegacy "legacy"}}">
      <img class="category-icon category-tab-icon {{if tab.selected "active"}} {{if tab.hovered "hover"}} color-{{tab.level}}" src="{{tab.iconPath}}">
      </>
      <div class="category-tab-contents-wrapper">
        <div class="category-tab-name {{if tab.selected "active"}} {{if tab.hovered "hover"}}">
          {{tab.name}}
        </>
      </>
    </>
  </>
{{/each}}
