{{#if hasChampionSquarePortrait}}
  <div class="report-header-icon">
    {{#uikit-framed-icon borderWidth=2}}
      <img src="{{championSquarePortraitPath}}">
      </>
    {{/uikit-framed-icon}}
  </>
{{/if}}
<div class="report-header-text">
  <span class="report-header-title">
    {{tra.report_modal_header_title}}
  </>
  <span class="report-header-summoner-name">
    {{player-name format="full" puuid=reportedPlayer.puuid summonerName=reportedPlayer.summonerName}}
  </>
</>
