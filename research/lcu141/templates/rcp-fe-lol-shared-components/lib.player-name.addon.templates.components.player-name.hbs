{{#if isRenderModeFullAlias}}
  <span id="player-name-full-alias-render-mode" class="{{aliasClass}} {{if isCopyEnabled highlightNameClass}}" onclick={{if isCopyEnabled (action this "copyAliasToClipboard"}}>
    <span class="{{gameNameClass}}">
      {{playerName.gameName}}
    </>
    <span class="{{tagLineClass}}">
      #
      {{playerName.tagLine}}
    </>
    {{#if isCopyEnabled}}
      <span class="{{clipboardIconClass}}">
      </>
    {{/if}}
  </>
{{/if}}
{{#if isRenderModeGameNameOnly}}
  <span id="player-name-game-name-only-render-mode" class="{{aliasClass}} {{if isCopyEnabled highlightNameClass}}" onclick={{if isCopyEnabled (action this "copyAliasToClipboard"}}>
    <span class="{{gameNameClass}}">
      {{playerName.gameName}}
    </>
    {{#if isCopyEnabled}}
      <span class="{{clipboardIconClass}}">
      </>
    {{/if}}
  </>
{{/if}}
{{#if isRenderModeTagLineTooltip}}
  <span class="{{aliasClass}} {{if isCopyEnabled highlightNameClass}}" onclick={{if isCopyEnabled (action this "copyAliasToClipboard"}}>
    <span class="{{gameNameClass}}">
      {{playerName.gameName}}
    </>
    {{#if isCopyEnabled}}
      <span class="{{clipboardIconClass}}">
      </>
    {{/if}}
    {{#uikit-tooltip showDelay=500 tooltipPosition="bottom" type="system" positioningStrategy="flip" restrictArea="safe-window"}}
      <lol-uikit-content-block type="tooltip-system" class="{{tooltipClass}}">
        <span class="{{tooltipGameNameClass}}">
          {{playerName.gameName}}
        </>
        <span class="{{tooltipTagLineClass}}">
          #
          {{playerName.tagLine}}
        </>
        {{#if shouldShowClipboardCopiedText}}
          <div class="{{clipboardTooltipDividerClass}}">
          </>
          <span class="{{clipboardTooltipCopyTextClass}}">
            {{clipboardCopiedText}}
          </>
        {{/if}}
      </>
    {{/uikit-tooltip}}
  </>
{{/if}}
{{#if isRenderModeSummonerName}}
  <span class="{{summonerNameClass}}">
    {{playerName.summonerName}}
  </>
{{/if}}
{{#if isRenderModeError}}
  <span class="{{errorClass}}">
    {{tra.player_name_unknown}}
  </>
{{/if}}
{{#if isRenderModeComponent}}
  {{#component componentName playerName=playerName}}
    {{yield }}
  {{/component}}
{{/if}}
