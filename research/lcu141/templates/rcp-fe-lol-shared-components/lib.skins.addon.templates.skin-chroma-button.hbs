<div class="chroma-button
  {{if isSelected "selected"}}
  {{unless chroma.unlocked "locked"}}
  {{unless chroma.purchaseEnabled "purchase-disabled"}}" onmouseover={{action this "showPreview"}} onmouseleave={{action this "hidePreview"}} onmouseup={{action this "setSkin"}}>
  {{#if chroma.unlocked}}
    <div class="contents" style="background:{{bgColor}}">
    </>
  {{else}}
    {{#if isSelected}}
      <div class="contents" style="background:{{bgColor}}">
      </>
    {{/if}}
  {{/if}}
</>
