<div class="chroma icon {{unless showChromaButton "hidden"}} {{unless enabled "disabled"}} {{if isChromaSelected "selected"}}" onClick={{action this "showSkinChromaFlyout"}} style="background: {{selectedChromaBg}}">
</>
<lc-flyout class="shared-chroma-flyout" open={{isFlyoutOpen}} onHide={{action this "hideSkinChromaFlyout"}} uiKitOptionOverrides={{flyoutSettings}}>
  <lc-flyout-content>
    <div class="shared-chroma-information" style="background-image: url('{{currentMapChromaPath}}')">
      <div class="shared-chroma-information-image" style="background-image: url('{{displayedChroma.chromaPath}}')">
      </>
      <div class="shared-child-skin-name">
        {{baseSkin.name}}
        <div class="shared-child-skin-disabled-notification">
          {{if displayedChroma.disabled tra.skin_unselectable_because_disabled}}
        </>
      </>
    </>
    <lol-uikit-scrollable class="shared-chroma-selection" overflow-masks="enabled">
      {{skin-chroma-button chroma=baseSkin purchaseEnabled=true selectedChroma=selectedChroma showPreview="showPreview" hidePreview="hidePreview" setSkin="setSkin"}}
      {{#each sortedChromas key="id" as |chroma|}}
        {{skin-chroma-button chroma=chroma purchaseEnabled=chroma.purchaseEnabled selectedChroma=selectedChroma showPreview="showPreview" hidePreview="hidePreview" setSkin="setSkin"}}
      {{/each}}
    </>
  </>
</>
