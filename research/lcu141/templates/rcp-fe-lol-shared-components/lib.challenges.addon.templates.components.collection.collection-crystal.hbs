<div class="crystal-wrapper" {{action this "onHover" on="mouseEnter"}}>
  {{#uikit-tooltip tooltipPosition="right" type="system"}}
    {{collection-category-tooltip tooltipType="CRYSTAL" tier=challengeLevel currentValue=currentPoints nextValue=nextPointsThreshold positionPercentile=positionPercentile}}
  {{/uikit-tooltip}}
  <div class="background-ring">
  </>
  <lol-uikit-radial-progress class="crystal-radial-progress" type="custom" percent="{{overallChallengeProgressPercentage}}" start-angle="-95" end-angle="-445">
    <div slot="bottom" class="crystal-radial crystal-radial-bottom ">
    </>
    <div slot="middle" class="crystal-radial crystal-radial-middle">
    </>
  </>
  <div class="contents">
    <div class="crystal-image {{challengeLevel}}">
    </>
    <div class="total-points">
      {{overallChallengePoints}}
    </>
    <div class="level">
      {{localizedChallengeLevel}}
    </>
  </>
</>
