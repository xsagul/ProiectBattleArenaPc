<div class="acs-modal">
  <div class="acs-modal-info-container">
    <h3 class="acs-modal-info-header">
      {{title}}
    </>
    <p class="acs-info">
      {{info}}
    </>
  </>
  <div class="acs-riot-id-container">
    <p class="acs-riot-id">
      {{riotId}}
      <span class="acs-riot-tag">
        #
        {{riotTag}}
      </>
    </>
  </>
</>
