<div class="ward-skin-details" style={{imageStyle}}>
  <img class="ward-skin-shadow" src="{{contextWardSkin.wardShadowImagePath}}">
  </>
  <img class="ward-skin-image" src="{{contextWardSkin.wardImagePath}}">
  </>
  <div class="ward-skin-name">
    {{contextWardSkin.name}}
  </>
</>
<lol-uikit-scrollable class="ward-skins" overflow-masks="enabled">
  {{#each wardSkins as |wardSkin|}}
    {{#unless wardSkin.locked}}
      {{flyout-selector-popup-button item=wardSkin selectedItem=selectedWardSkin onFlyoutItemSelected=onWardSkinConfirmed onFlyoutItemHover=(action this "onFlyoutWardHover"}}
    {{/unless}}
  {{/each}}
</>
