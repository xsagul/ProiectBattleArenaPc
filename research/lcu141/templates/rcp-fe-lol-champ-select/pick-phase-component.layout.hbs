{{pick-ban-ring sessionActions=sessionActions activeActions=sessionActions.activeActions activeAction=sessionActions.activeAction nextActions=sessionActions.nextActions allActions=sessionActions.allActions currentActions=sessionActions.currentActions isSimultaneousBans=sessionActions.isSimultaneousBans champSelectScreen=champSelectScreen shouldShowExpandedRing=shouldShowExpandedRing isPlayingCeremony=isPlayingCeremony allPlayersActTogether=sessionActions.allPlayersActTogether isShowingBanShowcase=shouldShowBanShowcase uxSettings=uxSettings myTeamSize=myTeamSize theirTeamSize=theirTeamSize}}
<div class="ban-showcase-visibility-wrapper {{if shouldShowGrid "hidden" "visible"}}">
  {{ban-showcase visible=shouldShowBanShowcase myTeamBans=sessionActions.myTeamBanActions theirTeamBans=sessionActions.theirTeamBanActions isSimultaneousBans=sessionActions.isSimultaneousBans}}
</>
<div class="phase-transition-visibility-wrapper {{if shouldShowGrid "hidden" "visible"}}">
  {{phase-transition visible=shouldShowPhaseTransition activeAction=sessionActions.activeAction nextActions=sessionActions.nextActions phaseTransitionStringsByActionId=sessionActions.phaseTransitionStringsByActionId allActions=sessionActions.allActions}}
</>
{{champion-grid requestInProgress=requestInProgress summoner=summoner isRGM=isRGM visible=shouldShowGrid gridRequested=gridRequested uxSettings=uxSettings jmxSettings=jmxSettings shouldShowChestFilter=shouldShowChestFilter isRandomChampionEnabled=isRandomChampionEnabled randomChampionRateLimitConfig=randomChampionRateLimitConfig recordDidRequestSucceed=recordDidRequestSucceed UseNewLoyaltyIcon=UseNewLoyaltyIcon}}
{{lock-in-button requestInProgress=requestInProgress summoner=summoner visible=shouldShowLockIn gameId=gameId}}
{{#if shouldShowFooter}}
  <div class="champion-grid-footer">
  </>
{{/if}}
<div class="champion-name-wrapper {{if shouldShowLockedName "visible" "hidden"}} {{if shouldShowLockedName "just-locked"}}">
  {{skin-name skin=sessionActions.lastCompletedAction.champion.baseSkin}}
</>
<lol-uikit-flat-button class="champion-grid-toggle {{unless gridIsToggleable "hidden"}}" click-sfx-src="{{gridToggleClickSfx}}" remove-min-height="" onclick={{action this "toggleGrid"}}>
  <div class="toggle-button-content">
  </>
</>
