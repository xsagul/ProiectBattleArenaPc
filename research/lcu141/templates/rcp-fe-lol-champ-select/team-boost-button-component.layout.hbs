{{#if showBoostButton}}
  <lol-uikit-flat-button onclick={{action this "showBoostPurchaseModal"}} disabled={{disabled}}>
    <div class="team-boost-content-wrapper">
      <div class="team-boost-rp-icon">
      </>
      {{boostButtonText}}
    </>
  </>
  {{#unless disabledViaTime}}
    {{#uikit-tooltip tooltipPosition="bottom" restrictArea="whole-window"}}
      <lol-uikit-content-block type="tooltip-large">
        <p>
          {{boostTooltipMessage}}
        </>
      </>
    {{/uikit-tooltip}}
  {{/unless}}
{{/if}}
<lc-confirm-modal acceptText={{tra.unlock}} closeButton={{true}} onYes={{action this "executePurchaseBoost"}} onHide={{action this "closePurchaseBoostModal"}} open={{boostPurchaseModalShowing}}>
  <lc-modal-content>
    {{team-boost-modal price=teamBoost.price rp=rp boostableSkinCount=boostableSkinCount}}
  </>
</>
