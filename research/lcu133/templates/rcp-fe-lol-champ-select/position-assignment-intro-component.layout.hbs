<img class="map-static-image" src="{{mapStaticPath}}">
</>
<video class="map-intro-video {{if isMapIntroVisible "visible" "hidden"}}" src={{mapIntroPath}} preload="auto">
</>
<video class="lane-intro-video blue-top" src="/fe/lol-champ-select/video/position-assignment/Path_South_Top.webm" preload="auto">
</>
<video class="lane-intro-video blue-jungle" src="/fe/lol-champ-select/video/position-assignment/Path_South_Jungle.webm" preload="auto">
</>
<video class="lane-intro-video blue-middle" src="/fe/lol-champ-select/video/position-assignment/Path_South_Mid.webm" preload="auto">
</>
<video class="lane-intro-video blue-bottom" src="/fe/lol-champ-select/video/position-assignment/Path_South_Bot.webm" preload="auto">
</>
<video class="lane-intro-video red-top" src="/fe/lol-champ-select/video/position-assignment/Path_North_Top.webm" preload="auto">
</>
<video class="lane-intro-video red-jungle" src="/fe/lol-champ-select/video/position-assignment/Path_North_Jungle.webm" preload="auto">
</>
<video class="lane-intro-video red-middle" src="/fe/lol-champ-select/video/position-assignment/Path_North_Mid.webm" preload="auto">
</>
<video class="lane-intro-video red-bottom" src="/fe/lol-champ-select/video/position-assignment/Path_North_Bot.webm" preload="auto">
</>
<div class="position-text {{if showPositionAssignment "visible" "hidden"}} {{localSummonerSlotClass}}">
  <div class="position-assignment-title">
    {{tra.assigned_position_title}}
  </>
  <div class="position-assignment-label">
    {{assignedPositionLabel}}
  </>
</>
{{#unless hidePins}}
  <div class="position-assignment-pins">
    {{#each pinDropSummoners as |summoner|}}
      <div class="position-assignment-pin slot-{{summoner.slotId}} {{if summoner.isLocalSummoner "is-self"}} {{mapSide}} {{if summoner.isPlaceholder "hidden" "visible"}} {{summoner.lane}}-{{summoner.lanePosition}}">
        <video class="pin-intro-video" src={{if summoner.isLocalSummoner "/fe/lol-champ-select/video/position-assignment/Pin_Me_Intro(Fixed).webm" "/fe/lol-champ-select/video/position-assignment/Pin_Intro(Fixed).webm"}}>
        </>
        <div class="pin-container">
          <div class="pin-static-image {{unless showPositionAssignment "static"}}">
          </>
          <div class="pin-position-icon {{summoner.position}}">
          </>
        </>
      </>
    {{/each}}
  </>
{{/unless}}
