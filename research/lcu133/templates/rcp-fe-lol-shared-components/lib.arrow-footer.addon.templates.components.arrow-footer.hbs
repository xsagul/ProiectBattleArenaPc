<div class="arrow-footer {{if removeCloseButton "hide-close-button"}} " version="7.13">
  <div class="arrow-footer-decoration">
    <div class="arrow-footer-decoration-child arrow-footer-decoration-left">
    </>
  </>
  <div class="confirm-button-container">
    <div class="border-bg">
      <div class="left-border-bg">
      </>
      <div class="middle-border-bg">
      </>
      <div class="right-border-bg">
      </>
    </>
    <button class="confirm {{if confirmButtonDisabled disabledStyle}}" {{action this "confirmButton"}}>
      <lol-uikit-animated-arrow-overlay state="click" single-carot="{{removeCloseButton}}">
      </>
      {{#if confirmButtonShowTooltip}}
        {{#uikit-tooltip tooltipPosition="top"}}
          <lol-uikit-content-block type="{{confirmButtonTooltipType}}">
            <p>
              {{confirmButtonTooltipText}}
            </>
          </>
        {{/uikit-tooltip}}
      {{/if}}
      <div class="left-confirm">
      </>
      <div class="middle-confirm">
        {{confirmButtonText}}
      </>
      <div class="right-confirm">
      </>
    </>
    <button class="close {{if closeButtonDisabled disabledStyle}}" type="{{closeButtonType}}" {{action this "closeButton"}}>
      <div class="close-icon">
      </>
      {{#if closeButtonShowTooltip}}
        {{#uikit-tooltip tooltipPosition="top"}}
          <lol-uikit-content-block type="{{closeButtonTooltipType}}">
            <p>
              {{closeButtonTooltipText}}
            </>
          </>
        {{/uikit-tooltip}}
      {{/if}}
    </>
  </>
  <div class="arrow-footer-decoration">
    <div class="arrow-footer-decoration-child arrow-footer-decoration-right">
    </>
  </>
</>
