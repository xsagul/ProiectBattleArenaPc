<div class="challenge-requirements-header">
  <div class="challenge-requirements-challenge-title">
    {{challenge.name}}
  </>
  <div class="challenge-requirements-close-button" onclick={{action this "closeModal"}}>
  </>
</>
<div class="challenge-requirements-separator-line">
</>
<div class="challenge-requirements-grid">
  {{#ember-collection class="item-grid-scrollable" items=challengeRequirements cell-layout=(mixed-grid-layout itemSizes) as |entry|}}
    <div class="challenge-requirement-item {{if entry.isComplete "completed"}}">
      <div class="challenge-requirement-item-container">
        <img src={{entry.assetPath}} class="challenge-requirement-item-image">
        </>
        <div class="challenge-requirement-item-overlay">
        </>
      </>
      <div class="challenge-requirement-item-name">
        {{entry.name}}
        {{#if entry.showTooltip}}
          {{#uikit-tooltip tooltipPosition="top" type="system" offsetY=3}}
            <lol-uikit-content-block type="tooltip-system">
              <p>
                {{entry.name}}
              </>
            </>
          {{/uikit-tooltip}}
        {{/if}}
      </>
      <img class="challenge-requirement-completed-icon" src="/fe/lol-static-assets/svg/challenge-requirements-complete-check.svg">
      </>
    </>
  {{/ember-collection}}
</>
