<div class="achievement-token-container {{if isPlaceholder "empty"}} {{if isNextTokenSlot "challenge-banner-token-selected-border"}}">
  {{#unless isPlaceholder}}
    {{#uikit-tooltip tooltipPosition="top" type="system"}}
      {{challenge-item-tooltip puuid=puuid challengeData=challengeData localPlayerChallengesData=localPlayerChallengesData isLocalPlayer=isLocalPlayer isComparable=isComparable animationsEnabled=false}}
    {{/uikit-tooltip}}
  {{/unless}}
  {{#unless isPlaceholder}}
    <img class="achievement-token {{if isCapstone "capstone"}}" src="{{iconPath}}">
    </>
  {{/unless}}
</>
