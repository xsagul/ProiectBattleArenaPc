<div class="managed-iframe-wrapper {{if hideIframe "managed-iframe-loading"}}">
  <iframe src={{url}} frameborder="0">
  </>
  {{#if isLoadingAndNotRetrying}}
    <div class="managed-iframe-spinner">
      {{uikit-spinner}}
    </>
  {{else}}
    {{#if isInErrorState}}
      {{uikit-error-page onButtonClick=(action this "errorRetryButtonClicked") isRetrying=isLoading}}
    {{/if}}
  {{/if}}
</>
