<div class="step-container">
  <h2 class="step-heading">
    {{tra.account_verification_password_entry_heading}}
    {{tra.account_verification_step_heading}}
    1
    {{tra.account_verification_of_heading}}
    3
  </>
  <h3 class="field-title">
    {{tra.account_verification_password_entry_field_title}}
  </>
  <lol-uikit-flat-input class="{{if isPasswordValid "" "field-error"}}">
    {{input class="field wide" value=password insert-newline="passwordEntered" type="password" autofocus="autofocus"}}
  </>
  {{#if isPasswordValid}}
    <p class="field-desc">
      {{tra.account_verification_password_entry_field_desc}}
    </>
  {{else}}
    <p class="field-desc field-error-text">
      {{tra.account_verification_password_entry_not_valid_error}}
    </>
  {{/if}}
  <lol-uikit-flat-button-group class="step-buttons" type="dialog-frame">
    <lol-uikit-flat-button onclick={{action this "postPassword"}}>
      {{tra.account_verification_submit_button}}
    </>
  </>
</>
