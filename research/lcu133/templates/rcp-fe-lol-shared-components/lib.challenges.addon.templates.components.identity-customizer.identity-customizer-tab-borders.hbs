<div class="identity-customizer-subheader">
  <div class="search-filter-container">
    <lol-uikit-flat-input>
      {{input type="search" maxlength="50" class="search-filter-input" value=searchFilter placeholder=tra.challenges_search_placeholder}}
    </>
  </>
</>
<div class="identity-customizer-grid">
  <lol-uikit-scrollable overflow-masks="enabled">
    {{#if emptySearch}}
      {{identity-customizer-empty-search clearSearch=(action this "clearSearch"}}
    {{else}}
      {{#each filteredBorders as |border|}}
        <div class="identity-customizer-border {{if border.selected "selected"}} {{if border.disabled "border-disabled"}}" {{action this "selectBorder" border}} {{action this "onBorderHover" border on="mouseEnter"}}>
          <div class="identity-customizer-border-container">
            {{#if border.isRanked}}
              {{#if border.disabled}}
                <img class="identity-customizer-border-unranked" src="/fe/lol-static-assets/images/border-unranked.png">
                </>
              {{else}}
                <lol-regalia-emblem-element class="identity-customizer-border-icon" ranked-tier={{border.tier}}>
                </>
              {{/if}}
            {{else}}
              <lol-uikit-themed-level-ring-v2 level="{{border.level}}" prestige-crest-id="{{border.itemId}}" is-identity-modal="true" class="identity-customizer-border-icon prestige-border-icon">
              </>
            {{/if}}
            <div class="identity-customizer-border-title">
              {{border.title}}
            </>
            <div class="identity-customizer-border-desc">
              {{border.desc}}
            </>
          </>
        </>
      {{/each}}
    {{/if}}
  </>
</>
