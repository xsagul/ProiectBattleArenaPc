{{#if hasQueueAvailabilityWarning}}
  <div class="parties-queue-warning-error">
    <div class="parties-notification-warning-icon {{restrictionLeaderClass}}">
    </>
    {{tra.parties_roster_invite_disabled_eligibility_disabled}}
  </>
{{else}}
  {{#if hasLobbyRestrictions}}
    <div class="parties-restrictions-warning-error">
      <div class="parties-notification-warning-icon {{restrictionLeaderClass}}">
      </>
      {{restrictionsText}}
      {{#uikit-tooltip tooltipConfig=tooltipConfig}}
        <lol-uikit-content-block class="parties-footer-tooltip" type="tooltip-large">
          <ul>
            {{#each disabledReasons as |reason|}}
              <li>
                {{sanitize reason}}
              </>
            {{/each}}
          </>
        </>
      {{/uikit-tooltip}}
    </>
  {{else}}
    {{#if readyWarning}}
      <div class="parties-footer-warning parties-ready-warning">
        <div class="parties-ready-warning-icon">
        </>
        {{readyWarning}}
        {{#uikit-tooltip tooltipConfig=tooltipConfig}}
          <lol-uikit-content-block class="parties-footer-tooltip" type="tooltip-large">
            {{readyWarningTooltip}}
          </>
        {{/uikit-tooltip}}
      </>
    {{else}}
      {{#if positionError}}
        <div class="parties-footer-error">
          {{positionError}}
        </>
      {{else}}
        {{#if hasMmrStandardDeviationWarning}}
          <div class="parties-footer-warning">
            <div class="parties-mmr-warning-icon">
            </>
            {{mmrStandardDeviationWarning}}
            {{#uikit-tooltip tooltipConfig=tooltipConfig}}
              <lol-uikit-content-block class="parties-footer-tooltip" type="tooltip-large">
                {{mmrStandardDeviationWarningTooltip}}
              </>
            {{/uikit-tooltip}}
          </>
        {{else}}
          {{#if shouldShowAutoFillStatus}}
            <div class="parties-footer-warning">
              {{#if positionWarning}}
                {{#if shouldShowAutoFillProtection}}
                  <div class="parties-autofill-protection-icon">
                  </>
                {{else}}
                  <div class="parties-autofill-warning-icon">
                  </>
                {{/if}}
                {{positionWarning}}
              {{/if}}
              {{#uikit-tooltip tooltipConfig=tooltipConfig}}
                <lol-uikit-content-block class="parties-footer-tooltip" type="tooltip-large">
                  {{warningTooltipText}}
                </>
              {{/uikit-tooltip}}
            </>
          {{else}}
            {{#if shouldShowBetaWatermark}}
              <div class="parties-beta-watermark">
                {{tra.parties_game_mode_beta}}
              </>
            {{/if}}
          {{/if}}
        {{/if}}
      {{/if}}
    {{/if}}
  {{/if}}
{{/if}}
