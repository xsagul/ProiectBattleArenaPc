<!-- PLACEHOLDER MEMBER -->
{{#if isPlaceholder}}
  <div class="custom-member-info-left">
    <div class="custom-team-member-placeholder member-info-left">
      {{tra.custom_game_empty}}
    </>
  </>
  {{#if isFirstPlaceholder}}
    <div class="custom-member-info-right custom-placeholder-buttons">
      <!-- JOIN OTHER TEAM -->
      {{#if isNotCurrentPlayersTeam}}
        <div class="member-join-other-team">
          <lol-uikit-flat-button-secondary class="member-join-other-team-button" onclick={{action this "joinOtherTeam"}} disabled={{joinDisabled}}>
            {{tra.custom_game_join}}
          </>
        </>
      {{/if}}
      <!-- ADD BOT -->
      {{#unless isTFT}}
        <div class="member-add-bot">
          <lol-uikit-flat-button-secondary onclick={{action this "addBot"}} disabled={{botsButtonDisabled}}>
            {{tra.custom_game_bot_add}}
            {{#if botsButtonDisabled}}
              {{#uikit-tooltip tooltipPosition="bottom" type="system"}}
                <lol-uikit-content-block type="tooltip-system">
                  <p>
                    {{tra.custom_game_bot_add_disabled_no_available_bots}}
                  </>
                </>
              {{/uikit-tooltip}}
            {{/if}}
          </>
        </>
      {{/unless}}
    </>
  {{/if}}
{{/if}}
<!-- PLAYER MEMBER -->
{{#if isPlayer}}
  <!-- items in this list are hidden and displayed on hover in styles -->
  <div class="custom-member-info-left">
    {{#unless isTFT}}
      <div class="custom-info-left-first">
        <span class="custom-summoner-level">
          {{summonerLevel}}
        </>
        <span class="custom-kick-member-button" {{action this "kick"}}>
          {{#uikit-tooltip tooltipPosition="top" type="system"}}
            <lol-uikit-content-block type="tooltip-system">
              <p>
                {{tra.kick_tooltip}}
              </>
            </>
          {{/uikit-tooltip}}
        </>
      </>
    {{/unless}}
    <div class="custom-member-icon">
      {{#unless isTFT}}
        <lol-social-avatar-icon icon-id={{profileIconId}} availability="{{_chatAvailability}}" show-availability="true">
        </>
      {{else}}
        <lol-social-avatar-icon icon-url={{companionIconUrl}} availability="{{_chatAvailability}}" show-availability="true">
        </>
      {{/unless}}
    </>
    <div class="custom-member-name">
      {{summonerName}}
    </>
    <div class="custom-leader-icon">
      {{#uikit-tooltip tooltipPosition="top" type="system"}}
        <lol-uikit-content-block type="tooltip-system">
          <p>
            {{tra.custom_game_is_leader}}
          </>
        </>
      {{/uikit-tooltip}}
    </>
  </>
  <div class="custom-member-info-right">
    {{#unless isTFT}}
      <div class="custom-member-info-stats">
        {{#if isRanked}}
          <span class="custom-member-info-ranked-tier">
            {{rankedTierAndDivisionText}}
          </>
          <span class="custom-member-info-ranked-wins">
            {{tra.custom_game_wins}}
            {{rankedWins}}
            {{tra.custom_game_ranked}}
          </>
        {{else}}
          <!-- TODO: normal wins here -->
          <span class="custom-member-info-wins">
          </>
        {{/if}}
      </>
    {{else}}
      {{#if isCurrentPlayer}}
        <lol-uikit-flat-button-secondary onclick={{action this "openLoadoutsModal"}} class="custom-loadouts-button">
          {{tra.custom_game_loadouts_button}}
        </>
      {{/if}}
    {{/unless}}
    <div class="custom-invite-privileges">
      {{#if isTFT}}
        <span class="custom-kick-member-button custom-kick-member-button-tft" {{action this "kick"}}>
          {{#uikit-tooltip tooltipPosition="top" type="system"}}
            <lol-uikit-content-block type="tooltip-system">
              <p>
                {{tra.kick_tooltip}}
              </>
            </>
          {{/uikit-tooltip}}
        </>
      {{/if}}
      <button class="custom-invite-privilege-button {{if hasInvitePrivileges "privileges-granted"}}" {{action this "toggleInvite"}}>
        {{#uikit-tooltip tooltipPosition="top" type="system"}}
          <lol-uikit-content-block type="tooltip-system">
            <p>
              {{#if hasInvitePrivileges}}
                {{tra.revoke_invite_privileges_tooltip}}
              {{else}}
                {{tra.grant_invite_privileges_tooltip}}
              {{/if}}
            </>
          </>
        {{/uikit-tooltip}}
      </>
    </>
    {{#if isNotFriend}}
      <div class="custom-add-friend">
        <button class="custom-add-friend-button" disabled={{_friendRequestSent}} {{action this "addFriend"}}>
          {{#uikit-tooltip tooltipPosition="top" type="system"}}
            <lol-uikit-content-block type="tooltip-system">
              <p>
                {{#if _friendRequestSent}}
                  {{tra.custom_game_friend_request_sent}}
                {{else}}
                  {{tra.context_menu_friend_request}}
                {{/if}}
              </>
            </>
          {{/uikit-tooltip}}
        </>
      </>
    {{/if}}
  </>
{{/if}}
<!-- BOTS -->
{{#if isBot}}
  <div class="custom-member-info-left">
    <div class="custom-info-left-first">
      <span class="custom-summoner-level">
        <hr>
        </>
      </>
      <span class="custom-kick-member-button" {{action this "removeBot"}}>
        {{#uikit-tooltip tooltipPosition="top" type="system"}}
          <lol-uikit-content-block type="tooltip-system">
            <p>
              {{tra.custom_game_bot_remove}}
            </>
          </>
        {{/uikit-tooltip}}
      </>
    </>
    <div class="custom-member-icon">
      <!-- TODO: This is a hacky copy of lol-social-avatar since it does not support champion icons as of this writing, but should just use lol-social-avatar if we can -->
      <div class="custom-member-bot-icon">
        <img class="custom-member-bot-icon-img" data-bot-icon-id={{botChampionId}} src={{botProfileIconUrl}} draggable="false">
        </>
        <div class="ring">
        </>
      </>
    </>
    <div class="custom-member-bot-name">
      {{botName}}
      {{tra.custom_game_bot_name}}
    </>
  </>
  <div class="custom-member-info-right">
    <div class="custom-member-bot-skill-level">
      {{botDifficultyString}}
    </>
    {{#if currentPlayerIsLeader}}
      <div class="custom-bot-options">
        <lol-uikit-framed-dropdown direction="downward" class="custom-bot-champions-dropdown" disabled={{updatingBotDisabled}}>
          {{#each availableBotsForCurrentTeam as |availableBot|}}
            <lol-uikit-dropdown-option slot="lol-uikit-dropdown-option" class="custom-bot-champions-dropdown-option" selected={{availableBot.selected}} onclick={{action this "changeBotChampion" availableBot on="click"}}>
              <div class="custom-bot-champions-dropdown-option-content">
                <div class="custom-member-icon ui-dropdown-option-only">
                  <div class="custom-member-bot-icon">
                    <img class="custom-member-bot-icon-img" src="{{availableBot.botIconUrl}}">
                    </>
                    <div class="ring">
                    </>
                  </>
                </>
                <div class="custom-bot-champion-name">
                  {{availableBot.name}}
                </>
              </>
            </>
          {{/each}}
        </>
        <lol-uikit-framed-dropdown class="custom-bot-difficulties-dropdown" disabled={{updatingBotDisabled}}>
          {{#each currentBotDifficulties as |botDifficulty|}}
            <lol-uikit-dropdown-option slot="lol-uikit-dropdown-option" selected={{botDifficulty.selected}} onclick={{action this "changeBotDifficulty" botDifficulty.difficulty on="click"}}>
              {{botDifficulty.difficultyDisplayName}}
            </>
          {{/each}}
        </>
      </>
    {{/if}}
  </>
{{/if}}
