{{#if summonerIcon}}
  <lol-social-avatar-icon class="icon-identity-tooltip-icon" icon-id={{summonerIcon.id}} availability="online">
  </>
  <div class="icon-identity-tooltip-details">
    <div class="icon-identity-tooltip-name">
      {{summonerIcon.title}}
    </>
    {{#if iconRarity}}
      <div class="icon-identity-tooltip-desc">
        <img class="icon-identity-tooltip-rarity-icon" src="{{iconRarity.gemIcon}}">
        </>
        <div class="icon-identity-tooltip-rarity-desc">
          {{iconRarityText}}
        </>
      </>
    {{/if}}
  </>
{{/if}}
