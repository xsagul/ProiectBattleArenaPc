{{#unless isTFT}}
  <div class="custom-game-team custom-game-team-one">
    <div class="team-header">
      {{tra.custom_game_team_one}}
    </>
    <ul class="custom-game-team-members">
      {{#each team100 as |team100Member|}}
        {{custom-team-member id=team100Member.summonerId member=team100Member currentPlayersTeam=currentPlayersTeam team=1 availableBotsForTeam=availableBotsForTeam100 isTFT=isTFT}}
      {{/each}}
    </>
  </>
  <div class="custom-game-team custom-game-team-two">
    <div class="team-header">
      {{tra.custom_game_team_two}}
    </>
    <ul class="custom-game-team-members">
      {{#each team200 as |team200Member|}}
        {{custom-team-member id=team200Member.summonerId member=team200Member currentPlayersTeam=currentPlayersTeam team=2 availableBotsForTeam=availableBotsForTeam200 isTFT=isTFT}}
      {{/each}}
    </>
  </>
{{else}}
  <div class="custom-game-team custom-game-team-tft">
    <ul class="custom-game-team-members">
      {{#each team100 as |team100Member|}}
        {{custom-team-member id=team100Member.summonerId member=team100Member currentPlayersTeam=currentPlayersTeam team=1 availableBotsForTeam=availableBotsForTeam100 isTFT=isTFT}}
      {{/each}}
    </>
  </>
{{/unless}}
