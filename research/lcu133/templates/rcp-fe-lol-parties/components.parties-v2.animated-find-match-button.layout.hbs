<div class="find-match-button">
  <div class="find-match-state {{currentState}}">
    <div class="img-container">
      <img src="{{currentImgPath}}">
      </>
    </>
  </>
  <lol-uikit-video-state-machine>
    <lol-uikit-video-group class="find-match-button-video">
      <lol-uikit-video-state state="disabled">
      </>
      <lol-uikit-video-state state="intro" wait-for-end="">
        <lol-uikit-video fade-in="0" type="intro" src={{videoSource.intro}} preload="">
        </>
      </>
      <lol-uikit-video-state state="idle">
        <lol-uikit-video fade-in="0" fade-out="0" type="idle" src={{videoSource.idle}}>
        </>
      </>
      <lol-uikit-video-state state="active" wait-for-end="">
        <lol-uikit-video fade-in="0" fade-out="0" type="outro" src={{videoSource.active}}>
        </>
      </>
      <lol-uikit-video-state state="hover" no-preserve-state="">
        <lol-uikit-video fade-in="0" fade-out="0" type="idle" src={{videoSource.hover}}>
        </>
      </>
    </>
  </>
  <div class="button-text {{currentState}}">
    {{buttonText}}
  </>
</>
