<div class="subcategory-map-icon" {{action this "selectSubcategory"}}>
  {{game-type-icon mapId=mapId currentlySelected=currentlySelected gameTypeName=name}}
  {{#if unavailable}}
    <div class="subcategory-tooltip-proxy">
      {{#uikit-tooltip tooltipConfig=tooltipConfig}}
        <lol-uikit-content-block type="tooltip-system">
          <p>
            {{unavailableTooltip}}
          </>
        </>
      {{/uikit-tooltip}}
    </>
  {{/if}}
</>
