{{#if isNotMe}}
  <div class="player-party-tools">
    {{#if showPlayerOptionsTools}}
      {{#v2-player-management-button type="options" action="openPlayerMenu"}}
        <lol-uikit-content-block type="tooltip-system">
          <p>
            {{playerControlTooltipText}}
          </>
        </>
      {{/v2-player-management-button}}
    {{/if}}
  </>
{{/if}}
{{#if shouldShowGhostedBanner}}
  <div class="lol-not-ready-loader">
    <div class="lol-not-ready-loader-segment">
    </>
    <div class="lol-not-ready-loader-segment">
    </>
    <div class="lol-not-ready-loader-segment">
    </>
  </>
{{/if}}
{{#if shouldShowRestrictions}}
  <div class="player-lobby-restrictions {{restrictionLeaderClass}}">
    {{#uikit-tooltip tooltipConfig=tooltipConfig}}
      <lol-uikit-content-block type="tooltip-system">
        {{#each restrictionToolTipText as |restriction|}}
          <p>
            {{restriction}}
          </>
        {{/each}}
      </>
    {{/uikit-tooltip}}
  </>
{{/if}}
