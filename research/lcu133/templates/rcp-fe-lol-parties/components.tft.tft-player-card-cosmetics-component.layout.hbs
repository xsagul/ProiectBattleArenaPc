<div class="cosmetics-wrapper">
  <div>
    {{tra.tft_companions_label}}
  </>
  {{#if isMe}}
    <lol-parties-cosmetics-picker type="companions" set-name="tft" orientation="left">
    </>
  {{else}}
    <div class="loadouts-icon-container" style="background-image: url({{companionIcon}});">
    </>
  {{/if}}
</>
