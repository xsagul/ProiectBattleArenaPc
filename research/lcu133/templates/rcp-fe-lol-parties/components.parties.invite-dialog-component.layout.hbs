<lol-uikit-scrollable class="parties-invite-dialog-container">
  <lol-uikit-content-block>
    <div class="search-box-container">
      <lol-uikit-flat-input class="search-box">
        {{input maxlength="209" class="search-box-input" enter="addToInviteList" type="text" value=searchString placeholder=tra.invite_dialog_search_placeholder key-down="inputChanged"}}
      </>
      <button class="search" disabled={{hasNoSearchString}} {{action this "addToInviteList"}}>
      </>
    </>
    <div class="search-error">
      {{#if searchError}}
        {{searchError}}
      {{/if}}
    </>
    <div class="available-players">
      {{tra.invite_dialog_available_players}}
    </>
    <div class="groups">
      {{invite-dialog-group group=inviteByNameGroup selectedPlayers=selectedPlayers inviteByName=true}}
      {{#if recentGroup}}
        {{invite-dialog-group group=recentGroup selectedPlayers=selectedPlayers}}
      {{/if}}
      {{#each groups as |group|}}
        {{invite-dialog-group group=group selectedPlayers=selectedPlayers}}
      {{/each}}
    </>
  </>
</>
<div style="display: none">
  <!-- here are some computeds we need in a template somewhere, so they update -->
  {{lobbiesService.notInLobbyObserver}}
  {{lobbiesService.invitationsObserver}}
  {{customGamesService.isCustomUI}}
</>
