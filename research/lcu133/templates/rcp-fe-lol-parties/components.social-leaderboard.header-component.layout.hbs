<div class="social-leaderboard-header-container">
  <div class="social-leaderboard-header-icon">
  </>
  <div class="social-leaderboard-header-text-container">
    <lol-uikit-flat-textarea>
      <div class="social-leaderboard-header-text">
        {{tra.social_leaderboard_ranked_title}}
      </>
      {{social-leaderboard-countdown-timer countdownLabel=countdownLabel countdownToTime=nextUpdateTime onRefresh=onRefresh}}
    </>
  </>
  <div class="social-leaderboard-queue-container">
    <div class="social-leaderboard-queue-visual">
      {{socialLeaderboardQueueText}}
    </>
  </>
</>
