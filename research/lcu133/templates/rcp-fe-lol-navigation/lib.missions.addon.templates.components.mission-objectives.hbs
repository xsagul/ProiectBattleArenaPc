<table class="mission-objectives-table">
  {{#each objectives as |objective index|}}
    {{#if index}}
      {{#if showOrDividers}}
        <tr>
          <td colspan="2">
            <div class="objective-divider">
              <div class="divider-diamond">
              </>
              <div class="divider-line">
              </>
              <div class="divider-text">
                {{tra.mission_objective_or}}
              </>
              <div class="divider-line">
              </>
              <div class="divider-diamond">
              </>
            </>
          </>
        </>
      {{/if}}
    {{/if}}
    {{mission-objective missionId=mission.id objective=objective isExpired=isExpired isMultiObjective=isMultiObjective hasProgress=hasProgress isMissionComplete=isComplete}}
  {{/each}}
</>
