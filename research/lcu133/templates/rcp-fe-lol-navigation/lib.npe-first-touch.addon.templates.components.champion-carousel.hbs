{{#if champions}}
  <lol-uikit-section-controller class="champion-carousel-section-controller" animation="crossfade" selected-item="champion_index_{{currentChampionIdx}}">
    {{#each champions as |champion index|}}
      <lol-uikit-section section-id="champion_index_{{index}}" class="champion-carousel-section-container">
        {{champion-carousel-item champion=champion}}
      </>
    {{/each}}
    <lol-uikit-arrow-button direction="left" class="previous-button" onClick={{action this "moveCarousel" "left"}}>
    </>
    <lol-uikit-arrow-button direction="right" class="next-button" onClick={{action this "moveCarousel" "right"}}>
    </>
    <div class="champion-selection-indicator">
      <ul class="champion-selection-indicator-list">
        {{#each champions as |champion index|}}
          <li class="champion-pip {{if (is-equal index currentChampionIdx) "champion-pip-selected"}}" onClick={{action this "pipClicked" currentChampionIdx index}}>
          </>
        {{/each}}
      </>
    </>
  </>
{{/if}}
