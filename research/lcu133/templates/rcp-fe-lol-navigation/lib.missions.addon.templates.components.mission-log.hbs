<lol-uikit-dialog-frame class="mission-log-container">
  <div class="mission-log-content">
    <div class="mission-log-header">
      <div class="mission-log-title">
        {{tra.mission_log_header}}
      </>
    </>
    <div class="mission-list">
      <lol-uikit-scrollable>
        {{#each missions as |mission|}}
          {{mission-item mission=mission enableHoverBehavior=true largeAreaAnimationsEnabled=largeAreaAnimationsEnabled missionsService=missionsBinding}}
        {{/each}}
      </>
    </>
    <lol-uikit-flat-button-group type="window-popup" class="mission-log-close-container">
      <lol-uikit-flat-button class="mission-log-close-button" onclick={{action this "closeMissionLog"}}>
        {{tra.mission_log_close}}
      </>
    </>
  </>
</>
