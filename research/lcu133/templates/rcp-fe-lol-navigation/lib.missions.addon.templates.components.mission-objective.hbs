<tr class="mission-objective-description-block">
  <td class="mission-objective-description {{if objective.hasObjectiveBasedReward "has-objective-based-reward"}}" colspan="2">
    <span>
      {{sanitize description}}
    </>
  </>
</>
<tr class="mission-objective-progress-block">
  <td class="mission-objective-progress-bar-wrapper">
    <div class="mission-objective-progress-bar {{if showAsExpired "expired-outline"}}">
      <div class="mission-objective-completed-progress {{progressColor}}" data-is-newly-completed-objective="{{isNewlyCompletedObjective}}" style="transform: scaleX({{progressScaleAmount}})">
      </>
    </>
  </>
  <td data-mission-id="{{missionId}}" class="mission-objective-progress-label">
    {{progressLabel}}
  </>
</>
